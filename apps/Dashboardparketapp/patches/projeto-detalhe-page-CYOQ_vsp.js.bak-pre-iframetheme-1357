// ─── CronogramaObrasCardTab (aba dentro do card) ───
function CronogramaObrasCardTab({card}){
  const [row,setRow]=k.useState(null);
  const [loading,setLoading]=k.useState(true);
  const [creating,setCreating]=k.useState(false);
  const load=k.useCallback(async()=>{
    setLoading(true);
    const {data}=await ae.from("cronograma_obras").select("*").eq("card_id",card.id).limit(1);
    setRow((data||[])[0]||null);setLoading(false);
  },[card.id]);
  k.useEffect(()=>{load();},[load]);
  const update=async(field,value)=>{
    setRow(r=>({...r,[field]:value}));
    await ae.from("cronograma_obras").update({[field]:value}).eq("id",row.id);
  };
  const createRow=async()=>{
    setCreating(true);
    const det=card.details||{};
    const cron=det.cronograma_pmo||{};
    const fiscal=(det.fiscal_responsavel||"").trim();
    const localizacao=det.endereco_obra||det.endereco||det.cidade||"";
    const servico=(cron.itens||[]).slice(0,3).map(i=>(i.categoria||i.servico||"").toUpperCase()+(i.quantidade?(" "+i.quantidade+(i.unidade||"")):"")).join(" + ");
    const payload={nome_obra:card.title||"",tipo:"obras",categoria:"obras_liberadas",card_id:card.id,fiscal:fiscal.toUpperCase()==="NÃO"?"":fiscal,localizacao,contrato:det.numero_pedido||det.extrecno||null,servico,equipe:"",dias:"",custos:"",observacao:cron.observacao||null,posicao:0};
    const {data,error}=await ae.from("cronograma_obras").insert(payload).select().single();
    setCreating(false);
    if(error){alert("Erro: "+error.message);return;}
    setRow(data);
  };
  const COL_OPTS=[
    ["obras-liberadas","🟢 Obra Liberada"],["projeto","📐 Projeto"],["pre-cronograma","📅 Pré-Cronograma"],["cronograma-final","🗓️ Cronograma Final"],
    ["entrega-material","📦 Entrega de Material"],["primeira-vistoria","🔍 1ª Vistoria"],["segunda-vistoria","🔎 2ª Vistoria"],
    ["acompanhamento","🔨 Acompanhamento"],["pendente","⏳ Pendente"],["reparos","🛠️ Reparos"],
    ["travado","🛑 TRAVADO"],["reparos-concluidos","✅ Reparos Concluídos"],["obras-finalizadas","🎉 Obra Finalizada"]
  ];
  const STATUS_OPTS=[["","— em andamento"],["travado","🛑 Travado"],["finalizado","✅ Finalizado"]];
  const fields=[
    ["nome_obra","Nome da Obra","text"],
    ["servico","Serviço","text"],
    ["fiscal","Fiscal","text"],
    ["equipe","Equipe","text"],
    ["dias","Dias","text"],
    ["custos","Custos","text"],
    ["data_finalizacao","Data Finalização","date_br"],
    ["status_obra","Status","status"],
    ["localizacao","Localização","text"],
    ["contrato","Contrato","text"],
    ["observacao","Observações","textarea"]
  ];
  const inputStyle={width:"100%",padding:"8px 10px",fontSize:"0.7rem",background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.08)",borderRadius:6,color:"#fff",outline:"none"};
  if(loading)return e.jsx("div",{style:{padding:30,textAlign:"center",color:"rgba(255,255,255,0.4)",fontSize:"0.7rem"},children:"Carregando…"});
  if(!row)return e.jsxs("div",{style:{padding:24,textAlign:"center",border:"1px dashed rgba(255,255,255,0.1)",borderRadius:8,background:"rgba(255,255,255,0.02)"},children:[
    e.jsx("div",{style:{fontSize:"0.8rem",color:"#fff",marginBottom:8,fontWeight:600},children:"Sem cronograma criado pra esse projeto"}),
    e.jsx("div",{style:{fontSize:"0.65rem",color:"rgba(255,255,255,0.5)",marginBottom:16},children:"Quando o card entra em \"Obras Liberadas\" o cronograma é criado automaticamente. Você também pode criar manualmente."}),
    e.jsx("button",{onClick:createRow,disabled:creating,style:{padding:"10px 20px",borderRadius:8,background:"#D4A853",border:"none",color:"#0a0a0a",fontWeight:700,fontSize:"0.75rem",cursor:creating?"wait":"pointer"},children:creating?"Criando…":"+ Criar linha no cronograma"})
  ]});
  return e.jsxs("div",{style:{padding:"4px 0",display:"flex",flexDirection:"column",gap:12},children:[
    e.jsxs("div",{style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:8},children:[
      e.jsx("h2",{style:{margin:0,fontSize:"0.95rem",color:"#D4A853",fontWeight:700},children:"📋 Cronograma de Obras"}),
      e.jsx("a",{href:"/operacional/spec-obras",style:{padding:"6px 12px",borderRadius:6,background:"rgba(212,168,83,0.15)",border:"1px solid rgba(212,168,83,0.35)",color:"#D4A853",fontSize:"0.65rem",fontWeight:700,textDecoration:"none"},children:"→ Ver tabela completa"})
    ]}),
    e.jsx("div",{style:{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(240px,1fr))",gap:10},children:fields.map(([key,label,type])=>e.jsxs("div",{style:{display:"flex",flexDirection:"column",gap:4,gridColumn:type==="textarea"?"1 / -1":"auto"},children:[
      e.jsx("label",{style:{fontSize:"0.55rem",color:"rgba(255,255,255,0.5)",textTransform:"uppercase",letterSpacing:"0.08em",fontWeight:700},children:label}),
      type==="textarea"?e.jsx("textarea",{defaultValue:row[key]||"",rows:3,onBlur:ev=>{if(ev.target.value!==(row[key]||""))update(key,ev.target.value||null);},style:{...inputStyle,resize:"vertical",fontFamily:"inherit"}}):
      type==="date_br"?e.jsx("input",{type:"date",defaultValue:(()=>{const v=row[key];if(!v)return"";if(/^\d{2}\/\d{2}\/\d{4}/.test(v)){const[d,m,y]=v.split("/");return y+"-"+m+"-"+d;}return v;})(),onBlur:ev=>{const v=ev.target.value;if(!v){if(row[key])update(key,null);return;}const[y,m,d]=v.split("-");const br=d+"/"+m+"/"+y;if(br!==(row[key]||""))update(key,br);},style:inputStyle}):
      type==="status"?e.jsx("select",{defaultValue:row[key]||"",onChange:ev=>update(key,ev.target.value||null),style:inputStyle,children:STATUS_OPTS.map(([v,l])=>e.jsx("option",{value:v,children:l},v||"_"))}):
      e.jsx("input",{type:"text",defaultValue:row[key]||"",onBlur:ev=>{if(ev.target.value!==(row[key]||""))update(key,ev.target.value);},style:inputStyle})
    ]},key))})
  ]});
}
