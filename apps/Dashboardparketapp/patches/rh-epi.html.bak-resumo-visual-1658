  function renderFuncionarios(m){
    var locais = Array.from(new Set(state.funcionarios.map(function(f){return f.local;}).filter(Boolean))).sort();
    var funcoes = Array.from(new Set(state.funcionarios.map(function(f){return f.funcao;}).filter(Boolean))).sort();
    var cidades = Array.from(new Set(state.funcionarios.map(function(f){return f.cidade;}).filter(Boolean))).sort();
    var empresaById = {};
    state.empresas.forEach(function(e){ empresaById[e.id] = e; });
    var nLinked = state.funcionarios.filter(function(f){return f.colaborador_id;}).length;
    var nOrphan = state.funcionarios.length - nLinked;
    state.filters.cidade = state.filters.cidade || "";
    state.filters.agruparPor = state.filters.agruparPor || "";
    m.innerHTML =
      '<div class="card">'+
        '<div class="row" style="justify-content:space-between">'+
          '<div><b>Funcionários cadastrados</b> <small>('+state.funcionarios.length+' — '+nLinked+' sincronizados do RH'+(nOrphan>0?', '+nOrphan+' avulsos':'')+')</small></div>'+
          '<div class="row"><a href="https://rh.parket.works" target="_blank" style="text-decoration:none;color:#34D399;font-size:11px;padding:6px 10px;border:1px solid #34D399;border-radius:4px">↗ Abrir RH</a> <button id="btn-novo">+ Novo (avulso)</button></div>'+
        '</div>'+
      '</div>'+
      '<div class="filter-bar" style="grid-template-columns:repeat(6,1fr)">'+
        '<input id="ff-q" placeholder="Buscar por nome..." value="'+escape(state.filters.q)+'" />'+
        '<select id="ff-emp"><option value="">Todas empresas</option>'+state.empresas.filter(function(e){return e.ativo!==false;}).map(function(e){return '<option value="'+e.id+'"'+(state.filters.empresa===e.id?' selected':'')+'>'+escape(e.nome)+'</option>';}).join("")+'</select>'+
        '<select id="ff-func"><option value="">Todos setores</option>'+funcoes.map(function(f){return '<option value="'+escape(f)+'"'+(state.filters.funcao===f?' selected':'')+'>'+escape(f)+'</option>';}).join("")+'</select>'+
        '<select id="ff-local"><option value="">Todos estados</option>'+locais.map(function(l){return '<option value="'+escape(l)+'"'+(state.filters.local===l?' selected':'')+'>'+escape(l)+'</option>';}).join("")+'</select>'+
        '<select id="ff-cid"><option value="">Todas cidades</option>'+cidades.map(function(c){return '<option value="'+escape(c)+'"'+(state.filters.cidade===c?' selected':'')+'>'+escape(c)+'</option>';}).join("")+'</select>'+
        '<select id="ff-grp"><option value="">Sem agrupar</option>'+[["empresa","Empresa"],["funcao","Setor"],["cargo","Cargo"],["local","Estado"],["cidade","Cidade"]].map(function(g){return '<option value="'+g[0]+'"'+(state.filters.agruparPor===g[0]?' selected':'')+'>Agrupar por '+g[1]+'</option>';}).join("")+'</select>'+
      '</div>'+
      '<div class="card" style="padding:0"><table id="tab-funcs"></table></div>';

    function update(){
      state.filters.q = $("ff-q").value;
      state.filters.local = $("ff-local").value;
      state.filters.funcao = $("ff-func").value;
      state.filters.empresa = $("ff-emp").value;
      state.filters.cidade = $("ff-cid").value;
      state.filters.agruparPor = $("ff-grp").value;
      draw();
    }
    $("ff-q").oninput = update;
    $("ff-local").onchange = update;
    $("ff-func").onchange = update;
    $("ff-emp").onchange = update;
    $("ff-cid").onchange = update;
    $("ff-grp").onchange = update;

    function rowHtml(f){
      var emp = empresaById[f.empresa_id];
      var linkedBadge = f.colaborador_id ? '<span class="badge ok" title="Sincronizado do rh.parket.works" style="font-size:9px">RH</span>' : '<span class="badge warn" title="Sem vínculo no RH (cadastro avulso)" style="font-size:9px">AVULSO</span>';
      return '<tr>'+
        '<td><b>'+escape(f.nome)+'</b> '+linkedBadge+'<br><small>'+escape(f.cargo||"—")+'</small></td>'+
        '<td><span class="badge">'+escape(emp?emp.nome:"—")+'</span></td>'+
        '<td><span class="badge">'+escape(f.funcao||"—")+'</span></td>'+
        '<td>'+escape(f.cidade||"—")+(f.local?' / '+escape(f.local):'')+'</td>'+
        '<td>'+escape(f.tam_camisa||"-")+' / '+escape(f.tam_calca||"-")+' / '+escape(f.tam_bota||"-")+'</td>'+
        '<td><button class="ghost" data-edit="'+f.id+'">Editar</button> <button class="ghost" data-hist="'+f.id+'">Histórico</button></td>'+
      '</tr>';
    }

    function draw(){
      var fs = state.funcionarios.filter(function(f){
        if(state.filters.q && !(f.nome||"").toLowerCase().includes(state.filters.q.toLowerCase())) return false;
        if(state.filters.local && f.local!==state.filters.local) return false;
        if(state.filters.funcao && f.funcao!==state.filters.funcao) return false;
        if(state.filters.empresa && f.empresa_id!==state.filters.empresa) return false;
        if(state.filters.cidade && f.cidade!==state.filters.cidade) return false;
        return true;
      });
      // Ordena: por nome dentro de grupo
      fs.sort(function(a,b){ return (a.nome||"").localeCompare(b.nome||""); });
      var tbody = "";
      if(state.filters.agruparPor){
        var groups = {};
        fs.forEach(function(f){
          var key;
          if(state.filters.agruparPor==="empresa") key = (empresaById[f.empresa_id]||{}).nome || "(sem empresa)";
          else key = f[state.filters.agruparPor] || "(não informado)";
          (groups[key] = groups[key] || []).push(f);
        });
        Object.keys(groups).sort().forEach(function(k){
          tbody += '<tr style="background:#1a1a1a"><td colspan="6" style="font-weight:700;color:#B8AA9A;font-size:11px;letter-spacing:0.05em;text-transform:uppercase;padding:10px 12px;border-top:2px solid #B8AA9A">'+escape(k)+' <small style="color:#888;font-weight:normal;text-transform:none;letter-spacing:0">— '+groups[k].length+'</small></td></tr>';
          groups[k].forEach(function(f){ tbody += rowHtml(f); });
        });
      } else {
        tbody = fs.map(rowHtml).join("");
      }
      if(!tbody) tbody = '<tr><td colspan="6" class="empty">Nenhum funcionário</td></tr>';
      $("tab-funcs").innerHTML = '<thead><tr><th>Nome / Cargo</th><th>Empresa</th><th>Setor</th><th>Cidade / UF</th><th>Camisa/Calça/Bota</th><th></th></tr></thead><tbody>'+tbody+'</tbody>';
      document.querySelectorAll("[data-edit]").forEach(function(b){ b.onclick = function(){ openFuncionarioModal(b.dataset.edit); }; });
      document.querySelectorAll("[data-hist]").forEach(function(b){ b.onclick = function(){ openHistorico(b.dataset.hist); }; });
    }
    $("btn-novo").onclick = function(){ openFuncionarioModal(null); };
    draw();
  }

  // ── Entrega Geral por cargo ──
  // Heurística: dado o nome do item, qual campo de tamanho do funcionário usar?
  function autoTamanhoField(item){
    var n = (item.nome||"").toUpperCase();
    if(item.categoria==="calcado" || /BOTA|SAPATO|TENIS|TÊNIS/.test(n)) return "tam_bota";
    if(/CAL[ÇC]A/.test(n)) return "tam_calca";
    if(/POLO/.test(n)) return "tam_polo";
    if(/CAMISA|CAMISETA|BLUSA/.test(n)) return "tam_camisa";
    return null; // sem tamanho — usa "-"
  }

