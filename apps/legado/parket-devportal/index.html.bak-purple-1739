    </div></div>`+(showAddDev?addDevModal():'');
  }
}

function updatePlaceholder(){
  const inp=document.getElementById('cmd-input');
  const btn=document.getElementById('send-btn');
  if(inp) inp.placeholder=mode==='claude'
    ?'Descreva o que precisa no '+APPS[curApp].nome+(curSetor?' / '+curSetor:'')+'...'
    :'Comando shell...';
  if(btn) btn.textContent=mode==='claude'?'⚡ Enviar':'▶ Run';
}

function selectApp(app){
  curApp=app;R();
  const term=document.getElementById('terminal');
  if(term&&tab==='terminal'){addSeparator();addLine('system','📂 App: '+APPS[app].nome+(curSetor?' / '+curSetor:''),'accent')}
}

function selectSetor(setor){
  curSetor=setor;R();
  const term=document.getElementById('terminal');
  if(term&&tab==='terminal'){addSeparator();addLine('system','🏷 Setor: '+setor+' ('+APPS[curApp].nome+')','accent')}
}

