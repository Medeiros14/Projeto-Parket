          <div style="width:46px;height:46px;border-radius:50%;flex-shrink:0;
            background:linear-gradient(135deg,rgba(168,85,247,0.30),rgba(34,211,238,0.20));
            border:1px solid rgba(168,85,247,0.30);
            display:flex;align-items:center;justify-content:center;
            font-weight:800;font-size:14px;color:#fff;letter-spacing:.05em;
            box-shadow:0 0 18px -4px rgba(168,85,247,0.45)">
            ${escHtml(initials)}
          </div>
          <div style="flex:1;min-width:0">
            <h4 style="margin:0 0 3px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap">${escHtml(d.dev_name||'')}</h4>
            <p style="font-size:11px;color:var(--dim);margin:0;text-overflow:ellipsis;overflow:hidden;white-space:nowrap">${escHtml(d.dev_email||'')}</p>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:14px">
          ${statusTag}${roleTag}
        </div>
        <div style="font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.18em;font-weight:700;margin-bottom:6px">Apps</div>
        <div style="margin-bottom:12px">${(d.apps_permitidos||[]).map(x=>'<span class="tag cyan">'+escHtml(x)+'</span>').join('')||'<span style="font-size:11px;color:var(--dim);font-style:italic">Nenhum</span>'}</div>
        <div style="font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.18em;font-weight:700;margin-bottom:6px">Setores</div>
