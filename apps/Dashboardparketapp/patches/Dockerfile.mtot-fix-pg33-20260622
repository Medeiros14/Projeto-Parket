FROM parket-dashboard:golden
# PKT-MTOT-FIX 2026-06-22: parseFloat agora strip thousand-separator '.' antes de parse
# Fix da linha "Metragem real total" que somava errado quando ambiente tinha m²>=1000
COPY propostaGenerator-PGSTRUCT33.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT33.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|propostaGenerator-PGSTRUCT3[012]\.js|propostaGenerator-PGSTRUCT33.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-pg33-mtot-fix'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
