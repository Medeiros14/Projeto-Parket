# ============================================================
# PARKET AI SQUAD - Environment Variables
# ============================================================

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=parket_ai
POSTGRES_USER=parket
POSTGRES_PASSWORD=changeme_db_password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Evolution API ---
EVOLUTION_API_URL=https://conect.parket.works
EVOLUTION_API_KEY=4eab105201410d6865b86dca76ee9fa3
EVOLUTION_INSTANCE=Parket
WEBHOOK_SECRET=changeme_webhook_secret

# --- OpenCode Accounts (comma-separated server URLs)
# Each URL corresponds to a running opencode server instance
# with a different account configured
OPENCODE_SERVERS=http://opencode-1:4096,http://opencode-2:4096,http://opencode-3:4096
OPENCODE_MODEL=claude-4-sonnet  # model to use in opencode

# --- App ---
SECRET_KEY=changeme_very_long_secret_key_for_jwt
BACKEND_CORS_ORIGINS=https://agente.parket.works,http://localhost:3000
API_URL=https://agente.parket.works

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# --- Portainer (for deploy script) ---
PORTAINER_URL=https://painel.parket.works
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=@Parket_admsrvIA

# --- Embeddings ---
# Uses local sentence-transformers (no API key needed)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
