FROM parket-dashboard:golden-squash-20260617-1344
COPY propostaGenerator-PGSTRUCT24.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT24.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec sed -i 's|propostaGenerator-PGSTRUCT2[0-3]\.js|propostaGenerator-PGSTRUCT24.js|g' {} +
RUN sed -i "s|'/assets/propostaGenerator-PGSTRUCT2[0-3].js'|'/assets/propostaGenerator-PGSTRUCT24.js'|g" /usr/share/nginx/html/index.html
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-pg24-forro-bunha'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
