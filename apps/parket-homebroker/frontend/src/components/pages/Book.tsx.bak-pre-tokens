function parseMetragem(det: any): number {
  if (!det) return 0;
  // 1) Campos estruturados (preferência se existirem)
  const raw = det.metragem_estimada ?? det.area_m2 ?? det.metragem ?? det.metros ?? det.m2 ?? "";
  if (typeof raw === "number" && raw > 0) return raw;
  if (raw) {
    const n = Number(String(raw).replace(/[^\d,.]/g, "").replace(",", "."));
    if (n > 0) return n;
  }
  // 2) Fallback: extrai do overview_ia/resumo (texto livre da IA)
  //    Ex: "QUANTIDADE: Casa tem 250m²" / "Aproximadamente 70m²"
  const txt = String(det.overview_ia || det.resumo_qualificacao || det.qualificacao_inicial || "");
  if (!txt) return 0;
  const m = txt.match(/(\d[\d.,]*)\s*m[²2]/i);
  if (m) {
    const n = Number(m[1].replace(/\./g, "").replace(",", "."));
    if (n > 0 && n < 100000) return n;
  }
  return 0;
}

/** Extrai cidade do overview_ia ou de campo estruturado. */
function parseCidade(det: any): string {
  if (!det) return "";
  const c = String(det.cidade || det.city || "").trim();
  if (c) return c;
  const txt = String(det.overview_ia || det.resumo_qualificacao || "");
  // "CIDADE: Teresina - PI" / "CIDADE: Recife - PE"
  const m = txt.match(/CIDADE\s*:?\s*([^\n•·]+?)(?:\s*[-–]\s*[A-Z]{2})?\s*[\n•·]/i);
  if (m) return m[1].trim();
  return "";
}

/** Extrai investimento/valor do overview_ia (texto livre). */
function parseValorOverview(det: any): number {
  if (!det) return 0;
  const txt = String(det.overview_ia || det.resumo_qualificacao || "");
  // "INVESTIMENTO: R$ 250.000,00" / "Orçamento ~ 100mil"
  const m = txt.match(/INVESTIMENTO\s*:?\s*([^\n•·]+)/i);
  if (!m) return 0;
  const s = m[1].toLowerCase();
  if (s.includes("não informado") || s.includes("nao informado") || s.includes("—")) return 0;
  // Tenta extrair número com k/mil/milhão
  const num = s.match(/r?\$?\s*([\d.,]+)\s*(mil|milh|k|m)?/i);
  if (!num) return 0;
  let v = Number(num[1].replace(/\./g, "").replace(",", "."));
  if (!v) return 0;
  const sufixo = (num[2] || "").toLowerCase();
  if (sufixo === "k" || sufixo.startsWith("mil")) v *= 1000;
  else if (sufixo === "m" || sufixo.startsWith("milh")) v *= 1000000;
  return v;
}

/** Detecta categorias de produto (piso/deck/forro/painel/marcenaria/...) no texto livre. */
const CATS = ["piso", "deck", "painel", "forro", "porta", "marcenaria", "revestimento", "rodape", "rodapé", "escada", "brise", "sauna"] as const;
function detectarProdutos(card: any): string[] {
  const det = card.details || {};
  // Inclui overview_ia/resumo (texto livre da IA) — onde a categoria geralmente fica
  // (Ex.: "PRODUTO: Painel e Piso")
  const blob = [
    det.produto_interesse, det.relacao_obra, det.preferencia_madeira,
    det.overview_ia, det.resumo_qualificacao, det.qualificacao_inicial,
    card.title, card.subtitle,
  ].filter(Boolean).join(" ").toLowerCase();
  const found = new Set<string>();
  CATS.forEach((c) => { if (blob.includes(c)) found.add(c.replace("rodapé", "rodape")); });
  return [...found];
}

/** Calcula o valor estimado na mesa: metragem × média do(s) produto(s).
 *  Se já há valor informado (card.value ou details.investimento), prioriza ele. */
function calcularValorMesa(card: any, metragem: number, produtos: string[], precos: Map<string, number>): { valor: number; origem: Row["valorOrigem"] } {
  const det = card.details || {};
  const informado = parseValueText(card.value) ||
    parseValueText(det.investimento) || parseValueText(det.orcamento) ||
    parseValueText(det.budget) || parseValueText(det.valor) ||
    parseValorOverview(det);
  if (informado > 0) return { valor: informado, origem: "informado" };
  if (metragem <= 0 || produtos.length === 0 || precos.size === 0) return { valor: 0, origem: "sem" };
  // Soma do médio de cada categoria (cada categoria contribui com metragem × média)
  let total = 0;
  produtos.forEach((p) => {
    const m = precos.get(p);
    if (m) total += metragem * m;
  });
  return { valor: total, origem: total > 0 ? "calculado" : "sem" };
}

/** Heurística TEMPORÁRIA quente/morno/frio (substituída pela IA na Fase 3).
 *  Considera: valor na mesa, etapa, tempo desde última msg, tags. */
function classificarNivel(args: {
  valor: number; slug: string; ultimaMsgAt: string | null; tags: string[]; det: any; aguardando: boolean;
}): { nivel: Row["nivelLead"]; fonte: "ia" | "heuristica" } {
  // Se a IA já classificou (campo details.nivel_lead ou tag forte), respeita
  const det = args.det || {};
  const iaNivel = String(det.nivel_lead || det.qualificacao || "").toLowerCase();
  if (iaNivel.includes("quente")) return { nivel: "quente", fonte: "ia" };
  if (iaNivel.includes("morno"))  return { nivel: "morno",  fonte: "ia" };
  if (iaNivel.includes("frio"))   return { nivel: "frio",   fonte: "ia" };
  const tagsLower = (args.tags || []).map((t) => String(t).toLowerCase()).join("|");
  if (/quente|hot|urgent/.test(tagsLower)) return { nivel: "quente", fonte: "heuristica" };
  if (/frio|cold/.test(tagsLower))         return { nivel: "frio",   fonte: "heuristica" };

  // Heurística: etapa "em-negociacao"/"apresentacao-proposta" + valor alto = quente
  const stage = args.slug || "";
  const stageHot = /em-negociac|apresentacao-proposta|ganho|qualificado/.test(stage);
  const stageCold = /perda|nao-qualif|follow-up-3/.test(stage);
  const valorAlto = args.valor >= 200000;
  const valorMedio = args.valor >= 50000;

  // Quanto tempo sem responder
  const daysSilent = args.ultimaMsgAt
    ? (Date.now() - new Date(args.ultimaMsgAt).getTime()) / 86400000
    : 999;

  if (stageCold || daysSilent > 14) return { nivel: "frio", fonte: "heuristica" };
  if (stageHot && (valorAlto || args.aguardando)) return { nivel: "quente", fonte: "heuristica" };
  if (valorAlto && daysSilent < 3) return { nivel: "quente", fonte: "heuristica" };
  if (stageHot || valorMedio) return { nivel: "morno", fonte: "heuristica" };
  return { nivel: "frio", fonte: "heuristica" };
}

