FROM parket-dashboard:golden
# PKT-MTOT-REGEX 2026-06-22: fix regex pra capturar "1.638,00m²" (thousand+decimal pt-BR)
COPY propostaGenerator-PGSTRUCT34.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT34.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|propostaGenerator-PGSTRUCT3[0-3]\.js|propostaGenerator-PGSTRUCT34.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-pg34-mtot-regex'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
