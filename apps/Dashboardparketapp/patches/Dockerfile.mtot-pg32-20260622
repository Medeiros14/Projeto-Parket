FROM parket-dashboard:golden
# PKT-MTOT 2026-06-22: linha "Metragem real total: Xm² + Y% perda = Zm²" no fim de cada categoria
# Substituição minima: PGSTRUCT30 -> PGSTRUCT32
COPY propostaGenerator-PGSTRUCT32.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT32.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i 's|propostaGenerator-PGSTRUCT30\.js|propostaGenerator-PGSTRUCT32.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-pg32-mtot'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
