// relatorios-operacional-pkt1.js
// Aba "📊 Relatórios" do Operacional — analytics multi-dimensional + builder
// com filtros combinados + 10 templates pré-prontos + export CSV.
//
// Dimensões disponíveis: fase do kanban, característica (tags Piso/Painel/
// Forro/Deck/Porta/Marcenaria/Escada), região (SP/DF/RJ/...), fiscal,
// responsável, SLA, datas. Dados vêm de kanban_cards (dept='operacional')
// + kanban_columns + fiscal_equipe.

import { r as RE, s as SB, j as o } from "./index-DZtetJYP.js";

const ACCENT = "#FF6B35";
const BG_PANEL = "#111";
const BG_CARD = "#1a1a1a";
const BORDER = "#2a2a2a";
const TXT = "#fafafa";
const TXT_DIM = "#a1a1aa";
const TXT_MUTED = "#71717a";

const CARACTERISTICAS = ["Piso", "Painel", "Forro", "Deck", "Porta", "Marcenaria", "Escada"];
const ESTADOS_BR = ["SP", "RJ", "DF", "BA", "MG", "PR", "SC", "RS", "PE", "MT", "PB"];
const SLA_OPTS = [
  { v: "", l: "Todos" },
  { v: "ok", l: "✅ OK" },
  { v: "warning", l: "⚠️ Atenção" },
  { v: "critical", l: "🔥 Crítico" },
];

// Parse "R$ 52.000,00" → 52000 (número). Tolerante.
function parseValor(s) {
  if (s == null) return 0;
  if (typeof s === "number") return s;
  const t = String(s).replace(/[^\d,.-]/g, "").replace(/\./g, "").replace(",", ".");
  const n = parseFloat(t);
  return isFinite(n) ? n : 0;
}
function fmtBRL(n) {
  return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
}
function fmtDate(s) {
  if (!s) return "";
  try { return new Date(s).toLocaleDateString("pt-BR"); } catch { return s; }
}
function daysBetween(a, b) {
  if (!a || !b) return null;
  try {
    const d1 = new Date(a), d2 = new Date(b);
    return Math.floor((d2 - d1) / 86400000);
  } catch { return null; }
}

// Mini-componentes visuais
function Btn({ label, onClick, color, active, small, title }) {
  return o.jsx("button", {
    onClick, title: title || label,
    style: {
      padding: small ? "4px 8px" : "6px 10px",
      borderRadius: 4,
      background: active ? (color || ACCENT) : "transparent",
      color: active ? "#fff" : (color || TXT_DIM),
      border: `1px solid ${active ? (color || ACCENT) : BORDER}`,
      fontSize: small ? "0.6rem" : "0.65rem",
      fontWeight: 600, cursor: "pointer", whiteSpace: "nowrap",
    },
    children: label,
  });
}

function Chip({ label, count, onClick, active, color }) {
  return o.jsxs("button", {
    onClick,
    style: {
      display: "inline-flex", alignItems: "center", gap: 4,
      padding: "3px 8px", borderRadius: 12,
      background: active ? (color || ACCENT) : "transparent",
      color: active ? "#fff" : (color || TXT_DIM),
      border: `1px solid ${active ? (color || ACCENT) : BORDER}`,
      fontSize: "0.6rem", fontWeight: 600, cursor: "pointer",
    },
    children: [
      label,
      count != null ? o.jsx("span", {
        style: { opacity: 0.7, fontSize: "0.55rem" }, children: `${count}`,
      }) : null,
    ],
  });
}

function MetricCard({ label, value, sub, color }) {
  return o.jsxs("div", {
    style: {
      flex: 1, minWidth: 140,
      background: BG_CARD, border: `1px solid ${BORDER}`,
      borderTop: `3px solid ${color || ACCENT}`,
      borderRadius: 6, padding: "12px 14px",
    },
    children: [
      o.jsx("div", {
        style: { fontSize: "0.55rem", color: TXT_MUTED, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: 4 },
        children: label,
      }),
      o.jsx("div", {
        style: { fontSize: "1.4rem", fontWeight: 700, color: TXT },
        children: value,
      }),
      sub ? o.jsx("div", {
        style: { fontSize: "0.6rem", color: TXT_DIM, marginTop: 2 },
        children: sub,
      }) : null,
    ],
  });
}

// ─── Componente principal ───────────────────────────────────────────
function RelatoriosOperacionalPage() {
  const [cards, setCards] = RE.useState([]);
  const [cols, setCols] = RE.useState([]);
  const [fiscais, setFiscais] = RE.useState([]);
  const [loading, setLoading] = RE.useState(true);
  const [err, setErr] = RE.useState(null);

  // Filtros
  const [phasesSel, setPhasesSel] = RE.useState(new Set());
  const [tagsSel, setTagsSel] = RE.useState(new Set());
  const [estadosSel, setEstadosSel] = RE.useState(new Set());
  const [fiscaisSel, setFiscaisSel] = RE.useState(new Set());
  const [slaSel, setSlaSel] = RE.useState("");
  const [respQuery, setRespQuery] = RE.useState("");
  const [search, setSearch] = RE.useState("");
  const [dateFrom, setDateFrom] = RE.useState("");
  const [dateTo, setDateTo] = RE.useState("");
  const [page, setPage] = RE.useState(0);
  const PAGE_SIZE = 50;

  // Carrega tudo no mount
  RE.useEffect(() => {
    let alive = true;
    Promise.all([
      SB.from("kanban_cards").select("*").eq("dept_id", "operacional").limit(2000),
      SB.from("kanban_columns").select("*").eq("dept_id", "operacional").order("position"),
      SB.from("fiscal_equipe").select("id,nome,ativo").eq("ativo", true).order("nome"),
    ]).then(([cR, colR, fR]) => {
      if (!alive) return;
      if (cR.error) { setErr(cR.error.message); setLoading(false); return; }
      setCards(cR.data || []);
      setCols(colR.data || []);
      setFiscais(fR.data || []);
      setLoading(false);
    }).catch((e) => {
      if (alive) { setErr(String(e)); setLoading(false); }
    });
    return () => { alive = false; };
  }, []);

  // Map id → column meta (title, position)
  const colsById = RE.useMemo(() => {
    const m = new Map();
    // kanban_cards.column_id armazena o SLUG da coluna (não o UUID).
    // Logo o mapa precisa ser slug → col pra que `colsById.get(card.column_id)`
    // resolva pra coluna certa em todas as agregações abaixo.
    cols.forEach((c) => m.set(c.slug, c));
    return m;
  }, [cols]);

  // Filtragem
  const filtered = RE.useMemo(() => {
    return cards.filter((c) => {
      if (phasesSel.size > 0 && !phasesSel.has(c.column_id)) return false;
      if (tagsSel.size > 0) {
        const ts = c.tags || [];
        let any = false;
        for (const t of tagsSel) {
          if (ts.includes(t)) { any = true; break; }
        }
        if (!any) return false;
      }
      if (estadosSel.size > 0) {
        const ts = c.tags || [];
        let any = false;
        for (const e of estadosSel) {
          if (ts.includes(e)) { any = true; break; }
        }
        if (!any) return false;
      }
      if (fiscaisSel.size > 0) {
        const f = ((c.details && c.details.fiscal) || "").toUpperCase();
        let any = false;
        for (const fs of fiscaisSel) {
          if (f.includes(fs.toUpperCase())) { any = true; break; }
        }
        if (!any) return false;
      }
      if (slaSel && c.sla_status !== slaSel) return false;
      if (respQuery && !((c.responsavel || "").toLowerCase().includes(respQuery.toLowerCase()))) return false;
      if (search) {
        const s = search.toLowerCase();
        const hit = (c.title || "").toLowerCase().includes(s) ||
                    (c.subtitle || "").toLowerCase().includes(s) ||
                    (c.obra || "").toLowerCase().includes(s);
        if (!hit) return false;
      }
      if (dateFrom && c.created_at && c.created_at.slice(0, 10) < dateFrom) return false;
      if (dateTo && c.created_at && c.created_at.slice(0, 10) > dateTo) return false;
      return true;
    });
  }, [cards, phasesSel, tagsSel, estadosSel, fiscaisSel, slaSel, respQuery, search, dateFrom, dateTo]);

  // Métricas agregadas
  const metrics = RE.useMemo(() => {
    let totalValor = 0;
    let critico = 0, warning = 0, ok = 0;
    let finalizadas = 0, ativas = 0;
    for (const c of filtered) {
      totalValor += parseValor(c.value);
      if (c.sla_status === "critical") critico++;
      else if (c.sla_status === "warning") warning++;
      else ok++;
      const col = colsById.get(c.column_id);
      const t = (col && col.title || "").toLowerCase();
      if (t.includes("finaliz") || t.includes("conclu")) finalizadas++;
      else ativas++;
    }
    return { total: filtered.length, totalValor, critico, warning, ok, finalizadas, ativas };
  }, [filtered, colsById]);

  // Distribuição por fase (pra "Distribuição por fase")
  const distPorFase = RE.useMemo(() => {
    const m = new Map();
    for (const c of filtered) {
      m.set(c.column_id, (m.get(c.column_id) || 0) + 1);
    }
    return cols.map((col) => ({ col, qtd: m.get(col.slug) || 0 }));
  }, [filtered, cols]);

  // Distribuição por característica (tag)
  const distPorCaract = RE.useMemo(() => {
    const m = new Map(CARACTERISTICAS.map((c) => [c, 0]));
    for (const c of filtered) {
      const ts = c.tags || [];
      for (const t of ts) {
        if (m.has(t)) m.set(t, m.get(t) + 1);
      }
    }
    return Array.from(m.entries()).map(([k, v]) => ({ tag: k, qtd: v }));
  }, [filtered]);

  // Distribuição por estado
  const distPorEstado = RE.useMemo(() => {
    const m = new Map();
    for (const c of filtered) {
      const ts = c.tags || [];
      for (const t of ts) {
        if (ESTADOS_BR.includes(t)) {
          m.set(t, (m.get(t) || 0) + 1);
        }
      }
    }
    return Array.from(m.entries()).sort((a, b) => b[1] - a[1]);
  }, [filtered]);

  // Backlog por fiscal
  const distPorFiscal = RE.useMemo(() => {
    const m = new Map();
    for (const c of filtered) {
      const f = (c.details && c.details.fiscal) || "—";
      m.set(f, (m.get(f) || 0) + 1);
    }
    return Array.from(m.entries()).sort((a, b) => b[1] - a[1]);
  }, [filtered]);

  // Carga por responsável
  const distPorResp = RE.useMemo(() => {
    const m = new Map();
    for (const c of filtered) {
      const r = c.responsavel || "—";
      m.set(r, (m.get(r) || 0) + 1);
    }
    return Array.from(m.entries()).sort((a, b) => b[1] - a[1]).slice(0, 20);
  }, [filtered]);

  // Tempo médio em fase (proxy: dias desde updated_at, agrupado por col)
  const tempoMedioFase = RE.useMemo(() => {
    const now = Date.now();
    const m = new Map();
    for (const c of filtered) {
      if (!c.updated_at) continue;
      const days = Math.floor((now - new Date(c.updated_at).getTime()) / 86400000);
      if (!m.has(c.column_id)) m.set(c.column_id, []);
      m.get(c.column_id).push(days);
    }
    const out = [];
    for (const [colId, arr] of m.entries()) {
      const sum = arr.reduce((a, b) => a + b, 0);
      const avg = arr.length > 0 ? Math.round(sum / arr.length) : 0;
      const col = colsById.get(colId);
      out.push({ col: col || { title: "?", position: 999 }, dias: avg, n: arr.length });
    }
    out.sort((a, b) => (a.col.position || 0) - (b.col.position || 0));
    return out;
  }, [filtered, colsById]);

  // Templates: aplica filtros pré-definidos
  const resetFilters = () => {
    setPhasesSel(new Set()); setTagsSel(new Set()); setEstadosSel(new Set());
    setFiscaisSel(new Set()); setSlaSel(""); setRespQuery("");
    setSearch(""); setDateFrom(""); setDateTo(""); setPage(0);
  };
  const applyTemplate = (key) => {
    resetFilters();
    if (key === "forro") setTagsSel(new Set(["Forro"]));
    if (key === "piso") setTagsSel(new Set(["Piso"]));
    if (key === "deck") setTagsSel(new Set(["Deck"]));
    if (key === "painel") setTagsSel(new Set(["Painel"]));
    if (key === "marcenaria") setTagsSel(new Set(["Marcenaria"]));
    if (key === "escada") setTagsSel(new Set(["Escada"]));
    if (key === "porta") setTagsSel(new Set(["Porta"]));
    if (key === "sla_critico") setSlaSel("critical");
    if (key === "sla_warning") setSlaSel("warning");
    if (key === "sp") setEstadosSel(new Set(["SP"]));
    if (key === "fora_sp") setEstadosSel(new Set(ESTADOS_BR.filter((e) => e !== "SP")));
    if (key === "primeira_vistoria") setPhasesSel(new Set(["primeira-vistoria"]));
    if (key === "cronograma_final") setPhasesSel(new Set(["cronograma-final"]));
    if (key === "obras_liberadas") setPhasesSel(new Set(["obras-liberadas"]));
    if (key === "finalizadas_mes") {
      setPhasesSel(new Set(["obras-finalizadas"]));
      const now = new Date();
      const d1 = new Date(now.getFullYear(), now.getMonth(), 1);
      setDateFrom(d1.toISOString().slice(0, 10));
    }
  };

  // Export CSV (filtrado atual)
  const exportCsv = () => {
    const rows = [["Obra/Cliente", "Fase", "Características", "Estado", "Fiscal", "Responsável", "SLA", "Valor", "Criado", "Atualizado"]];
    for (const c of filtered) {
      const col = colsById.get(c.column_id);
      const tags = c.tags || [];
      const caract = tags.filter((t) => CARACTERISTICAS.includes(t)).join(",");
      const ests = tags.filter((t) => ESTADOS_BR.includes(t)).join(",");
      const fiscal = (c.details && c.details.fiscal) || "";
      rows.push([
        (c.title || c.obra || "").replace(/"/g, '""'),
        (col && col.title) || "",
        caract, ests,
        fiscal, c.responsavel || "",
        c.sla_status || "",
        c.value || "",
        fmtDate(c.created_at), fmtDate(c.updated_at),
      ]);
    }
    const csv = rows.map((r) => r.map((cell) => `"${String(cell)}"`).join(";")).join("\n");
    const blob = new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `relatorio-operacional-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const pageRows = filtered.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE);

  // Tags únicos para os filtros (multi-select)
  const allUniqueTags = RE.useMemo(() => {
    const counts = new Map();
    for (const c of cards) {
      const ts = c.tags || [];
      for (const t of ts) counts.set(t, (counts.get(t) || 0) + 1);
    }
    return counts;
  }, [cards]);

  if (loading) {
    return o.jsx("div", {
      style: { padding: 40, color: TXT_DIM, textAlign: "center" },
      children: "Carregando dados…",
    });
  }
  if (err) {
    return o.jsx("div", {
      style: { padding: 40, color: "#f87171" },
      children: `Erro ao carregar: ${err}`,
    });
  }

  // ── Layout ──
  return o.jsxs("div", {
    style: { padding: 16, color: TXT, background: "#0a0a0a", minHeight: "100%" },
    children: [
      // Header
      o.jsxs("div", {
        style: { display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 14 },
        children: [
          o.jsxs("div", {
            children: [
              o.jsx("div", {
                style: { fontSize: "1.1rem", fontWeight: 700, color: ACCENT },
                children: "📊 Relatórios Operacional",
              }),
              o.jsx("div", {
                style: { fontSize: "0.65rem", color: TXT_DIM, marginTop: 2 },
                children: "Performance e acompanhamento — 10 templates rápidos + builder com filtros",
              }),
            ],
          }),
          o.jsxs("div", {
            style: { display: "flex", gap: 6 },
            children: [
              o.jsx(Btn, { label: "↻ Recarregar", small: true, onClick: () => { setLoading(true); window.location.reload(); } }),
              o.jsx(Btn, { label: "🧹 Limpar filtros", small: true, onClick: resetFilters }),
              o.jsx(Btn, { label: "📥 Exportar CSV", color: "#10b981", active: true, small: true, onClick: exportCsv }),
            ],
          }),
        ],
      }),

      // 🎯 FILTRO POR ETAPA DO KANBAN — destacado no topo
      o.jsxs("div", {
        style: { background: BG_PANEL, border: `2px solid ${ACCENT}40`, borderRadius: 6, padding: 12, marginBottom: 12 },
        children: [
          o.jsxs("div", {
            style: { display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 8 },
            children: [
              o.jsx("div", {
                style: { fontSize: "0.7rem", fontWeight: 700, color: ACCENT, textTransform: "uppercase", letterSpacing: "0.06em" },
                children: "🎯 Filtrar por etapa do Kanban",
              }),
              o.jsx("div", {
                style: { fontSize: "0.55rem", color: TXT_MUTED },
                children: phasesSel.size === 0 ? "Mostrando TODAS as etapas" :
                  `${phasesSel.size} etapa${phasesSel.size > 1 ? "s" : ""} selecionada${phasesSel.size > 1 ? "s" : ""}`,
              }),
            ],
          }),
          o.jsxs("div", {
            style: { display: "flex", gap: 6, flexWrap: "wrap" },
            children: [
              // Botão "Todas"
              o.jsx("button", {
                onClick: () => { setPhasesSel(new Set()); setPage(0); },
                style: {
                  padding: "6px 12px", borderRadius: 4,
                  background: phasesSel.size === 0 ? ACCENT : "transparent",
                  color: phasesSel.size === 0 ? "#fff" : TXT_DIM,
                  border: `1px solid ${phasesSel.size === 0 ? ACCENT : BORDER}`,
                  fontSize: "0.65rem", fontWeight: 700, cursor: "pointer", whiteSpace: "nowrap",
                },
                children: `📋 TODAS (${cards.length})`,
              }),
              // Chip por fase
              ...cols.map((c) => {
                const n = cards.filter((x) => x.column_id === c.slug).length;
                const active = phasesSel.has(c.slug);
                return o.jsx("button", {
                  onClick: () => {
                    const next = new Set(phasesSel);
                    if (next.has(c.slug)) next.delete(c.slug); else next.add(c.slug);
                    setPhasesSel(next); setPage(0);
                  },
                  style: {
                    padding: "6px 12px", borderRadius: 4,
                    background: active ? (c.color || ACCENT) : "transparent",
                    color: active ? "#fff" : (c.color || TXT_DIM),
                    border: `1px solid ${active ? (c.color || ACCENT) : BORDER}`,
                    fontSize: "0.65rem", fontWeight: 600, cursor: "pointer", whiteSpace: "nowrap",
                  },
                  children: `${c.title} (${n})`,
                }, c.id);
              }),
            ],
          }),
        ],
      }),

      // Templates pré-prontos
      o.jsxs("div", {
        style: { background: BG_PANEL, border: `1px solid ${BORDER}`, borderRadius: 6, padding: 10, marginBottom: 12 },
        children: [
          o.jsx("div", {
            style: { fontSize: "0.55rem", color: TXT_MUTED, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: 6 },
            children: "Templates rápidos (combinam etapa + característica + filtros)",
          }),
          o.jsxs("div", {
            style: { display: "flex", flexWrap: "wrap", gap: 6 },
            children: [
              o.jsx(Btn, { label: "🪵 Forro", small: true, color: "#a37854", onClick: () => applyTemplate("forro") }),
              o.jsx(Btn, { label: "🏠 Piso", small: true, color: "#a37854", onClick: () => applyTemplate("piso") }),
              o.jsx(Btn, { label: "🌳 Deck", small: true, color: "#7a5a3a", onClick: () => applyTemplate("deck") }),
              o.jsx(Btn, { label: "🪟 Painel", small: true, color: "#22c55e", onClick: () => applyTemplate("painel") }),
              o.jsx(Btn, { label: "🪑 Marcenaria", small: true, color: "#a855f7", onClick: () => applyTemplate("marcenaria") }),
              o.jsx(Btn, { label: "🪜 Escada", small: true, color: "#f59e0b", onClick: () => applyTemplate("escada") }),
              o.jsx(Btn, { label: "🚪 Porta", small: true, color: "#3b82f6", onClick: () => applyTemplate("porta") }),
              o.jsx("div", { style: { width: 1, background: BORDER, margin: "0 4px" } }),
              o.jsx(Btn, { label: "🔥 SLA crítico", small: true, color: "#ef4444", onClick: () => applyTemplate("sla_critico") }),
              o.jsx(Btn, { label: "⚠️ SLA atenção", small: true, color: "#f59e0b", onClick: () => applyTemplate("sla_warning") }),
              o.jsx("div", { style: { width: 1, background: BORDER, margin: "0 4px" } }),
              o.jsx(Btn, { label: "📍 Só SP", small: true, color: "#06b6d4", onClick: () => applyTemplate("sp") }),
              o.jsx(Btn, { label: "🛫 Fora SP", small: true, color: "#06b6d4", onClick: () => applyTemplate("fora_sp") }),
              o.jsx("div", { style: { width: 1, background: BORDER, margin: "0 4px" } }),
              o.jsx(Btn, { label: "👁 1ª Vistoria", small: true, color: "#8b5cf6", onClick: () => applyTemplate("primeira_vistoria") }),
              o.jsx(Btn, { label: "📅 Cronograma Final", small: true, color: "#8b5cf6", onClick: () => applyTemplate("cronograma_final") }),
              o.jsx(Btn, { label: "✅ Obras Liberadas", small: true, color: "#10b981", onClick: () => applyTemplate("obras_liberadas") }),
              o.jsx(Btn, { label: "🏁 Finalizadas no mês", small: true, color: "#10b981", onClick: () => applyTemplate("finalizadas_mes") }),
            ],
          }),
        ],
      }),

      // Métricas
      o.jsxs("div", {
        style: { display: "flex", gap: 10, marginBottom: 14, flexWrap: "wrap" },
        children: [
          o.jsx(MetricCard, { label: "Obras filtradas", value: metrics.total, color: ACCENT }),
          o.jsx(MetricCard, { label: "Ativas", value: metrics.ativas, sub: `${metrics.finalizadas} finalizadas`, color: "#3b82f6" }),
          o.jsx(MetricCard, { label: "SLA Crítico", value: metrics.critico, sub: `${metrics.warning} atenção`, color: "#ef4444" }),
          o.jsx(MetricCard, { label: "Valor total", value: fmtBRL(metrics.totalValor), color: "#10b981" }),
        ],
      }),

      // Filtros do Builder
      o.jsxs("div", {
        style: { background: BG_PANEL, border: `1px solid ${BORDER}`, borderRadius: 6, padding: 12, marginBottom: 12 },
        children: [
          o.jsx("div", {
