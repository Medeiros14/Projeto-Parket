// ─── Tarefas delegadas pelo admin — banner no /tracking pro vendedor ──
function TarefasVendedorBar({ nome }: { nome: string }) {
  const { T } = useTheme();
  const [tasks, setTasks] = useState<TrackingTask[]>([]);
  const [collapsed, setCollapsed] = useState(false);
  const [busy, setBusy] = useState<string | null>(null);

  const reload = async () => {
    if (!nome) return;
    const r = await supabase
      .from("tracking_tasks")
      .select("*")
      .eq("assigned_to", nome)
      .eq("status", "open")
      .order("due_date", { ascending: true, nullsFirst: false })
      .limit(50);
    if (!r.error) setTasks((r.data as TrackingTask[]) || []);
  };

  useEffect(() => { reload(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [nome]);

  // Realtime: novas tarefas e atualizações
  useEffect(() => {
    if (!nome) return;
    const ch = supabase
      .channel(`tracking-tasks-${nome}`)
      .on("postgres_changes" as any,
        { event: "*", schema: "public", table: "tracking_tasks", filter: `assigned_to=eq.${nome}` },
        () => reload())
      .subscribe();
    return () => { supabase.removeChannel(ch); };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [nome]);

  const increment = async (task: TrackingTask) => {
    setBusy(task.id);
    try {
      const newCount = Math.min(task.target_count, task.current_count + 1);
      const completed = newCount >= task.target_count;
      const updates = [
        ...(Array.isArray(task.updates) ? task.updates : []),
        { at: new Date().toISOString(), by: nome, delta: 1 },
      ];
      const r = await supabase
        .from("tracking_tasks")
        .update({
          current_count: newCount,
          status: completed ? "completed" : task.status,
          completed_at: completed ? new Date().toISOString() : null,
          updates,
        })
        .eq("id", task.id);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      reload();
    } finally { setBusy(null); }
  };

  if (tasks.length === 0) return null;
  const total = tasks.reduce((a, t) => a + t.current_count, 0);
  const target = tasks.reduce((a, t) => a + t.target_count, 0);

  return (
    <div style={{
      borderBottom: `1px solid ${T.borderHover}`,
      backgroundColor: `${CHAI}10`,
      flexShrink: 0,
    }}>
      {/* Header da barra — clicável */}
      <button onClick={() => setCollapsed((v) => !v)} style={{
        width: "100%", padding: "8px 14px",
        display: "flex", alignItems: "center", gap: 10,
        background: "none", border: "none", cursor: "pointer", color: T.textPrimary,
      }}>
        <Sparkles size={12} color={CHAI} />
        <div style={{ fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.22em", color: CHAI, fontWeight: 700, textTransform: "uppercase" }}>
          TAREFAS DO ADMIN · {tasks.length}
        </div>
        <div style={{ marginLeft: "auto", fontFamily: FONT_BODY, fontSize: 10, color: T.textSecondary, letterSpacing: "0.04em" }}>
          {total} / {target}
        </div>
        {collapsed ? <ArrowRight size={11} color={T.textMuted} /> : <ChevronDown size={11} color={T.textMuted} />}
      </button>

      {!collapsed && (
        <div style={{ padding: "0 14px 12px" }}>
          {tasks.map((t) => {
            const pct = t.target_count > 0 ? Math.min(100, Math.round((t.current_count / t.target_count) * 100)) : 0;
            const isBusy = busy === t.id;
            return (
              <div key={t.id} style={{
                marginBottom: 6, padding: "10px 12px",
                border: `1px solid ${T.border}`, backgroundColor: T.bg,
              }}>
                <div style={{ display: "flex", gap: 10, alignItems: "flex-start", marginBottom: 8 }}>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 11, fontWeight: 500, color: T.textPrimary, letterSpacing: "0.02em" }}>
                      {t.title}
                    </div>
                    {t.description && (
                      <div style={{ fontFamily: FONT_BODY, fontSize: 9, color: T.textSecondary, marginTop: 2, lineHeight: 1.5 }}>
                        {t.description}
                      </div>
                    )}
                    <div style={{ fontFamily: FONT_BODY, fontSize: 8, color: T.textMuted, marginTop: 4, letterSpacing: "0.14em", textTransform: "uppercase" }}>
                      {t.due_date && `PRAZO ${t.due_date} · `}
                      POR {t.created_by.toUpperCase()}
                    </div>
                  </div>
                  <button onClick={() => increment(t)} disabled={isBusy}
                    style={{
                      padding: "8px 12px",
                      backgroundColor: CHAI, border: `1px solid ${CHAI}`, color: T.onPrimary,
                      fontFamily: FONT_BODY, fontSize: 10, letterSpacing: "0.20em", fontWeight: 700,
                      textTransform: "uppercase", cursor: isBusy ? "wait" : "pointer",
                      display: "flex", alignItems: "center", gap: 5, flexShrink: 0,
                      opacity: isBusy ? 0.6 : 1,
                    }}>
                    {isBusy ? <Loader2 size={11} style={{ animation: "spin 1s linear infinite" }} /> : <Check size={11} />}
                    +1
                  </button>
                </div>
                {/* Barra de progresso */}
                <div>
                  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 3, fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.08em", color: T.textMuted }}>
                    <span>PROGRESSO</span>
                    <span style={{ color: T.textPrimary, fontWeight: 600 }}>{t.current_count} / {t.target_count}</span>
                  </div>
                  <div style={{ height: 3, backgroundColor: T.border, position: "relative" }}>
                    <div style={{
                      position: "absolute", top: 0, left: 0, bottom: 0,
                      width: `${pct}%`, backgroundColor: CHAI, transition: "width 0.3s",
                    }} />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

// ─── InstallPrompt — banner discreto pra adicionar PWA na home ──────
const PROMPT_DISMISS_KEY = "parket.tracking.install.dismissed";

function InstallPrompt() {
  const { T } = useTheme();
  const [show, setShow] = useState(false);
  const [deferred, setDeferred] = useState<any>(null);
  const [iosHint, setIosHint] = useState(false);

  useEffect(() => {
    if (localStorage.getItem(PROMPT_DISMISS_KEY)) return;
    // Já instalado? não mostra
    const standalone = window.matchMedia?.("(display-mode: standalone)").matches
      || (window.navigator as any).standalone === true;
    if (standalone) return;

    const ua = navigator.userAgent;
    const isIos = /iPhone|iPad|iPod/.test(ua) && !(/CriOS|FxiOS|EdgiOS/.test(ua));
    if (isIos) {
      setIosHint(true);
      setShow(true);
      return;
    }
    const onBefore = (e: any) => {
      e.preventDefault();
      setDeferred(e);
      setShow(true);
    };
    window.addEventListener("beforeinstallprompt", onBefore);
    return () => window.removeEventListener("beforeinstallprompt", onBefore);
  }, []);

  const dismiss = () => {
    localStorage.setItem(PROMPT_DISMISS_KEY, String(Date.now()));
    setShow(false);
  };

  const install = async () => {
    if (!deferred) return;
    deferred.prompt();
    try { await deferred.userChoice; } catch {}
    setDeferred(null);
    dismiss();
  };

  if (!show) return null;
  return (
    <div style={{
      borderBottom: `1px solid ${T.borderHover}`,
      backgroundColor: `${CHAI}18`,
      padding: "10px 14px",
      display: "flex", alignItems: "center", gap: 10, flexShrink: 0,
    }}>
      <Sparkles size={14} color={CHAI} />
      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.22em", color: CHAI, fontWeight: 700, textTransform: "uppercase" }}>
          INSTALAR NO CELULAR
        </div>
        <div style={{ fontFamily: FONT_BODY, fontSize: 10, color: T.textSecondary, marginTop: 3, lineHeight: 1.5 }}>
          {iosHint
            ? "Safari → toque em ↥ Compartilhar → 'Adicionar à Tela de Início'"
            : "Adicione o Tracking à tela inicial pra abrir como app nativo."}
        </div>
      </div>
      {!iosHint && deferred && (
        <button onClick={install} style={{
          padding: "7px 12px", backgroundColor: CHAI, border: `1px solid ${CHAI}`, color: T.onPrimary,
          fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.20em", fontWeight: 600,
          textTransform: "uppercase", cursor: "pointer",
        }}>
          INSTALAR
        </button>
      )}
      <button onClick={dismiss} title="Dispensar" style={{
        padding: "5px", background: "none", border: "none", cursor: "pointer", color: T.textMuted,
      }}>
        <X size={13} />
      </button>
    </div>
  );
}

// ─── helpers ───────────────────────────────────────────────────────────
function formatDataAg(ymd: string): { dia: string; mes: string } {
  // Expecting YYYY-MM-DD
  const [, m, d] = ymd.split("-").map(Number);
  const meses = ["JAN","FEV","MAR","ABR","MAI","JUN","JUL","AGO","SET","OUT","NOV","DEZ"];
  return { dia: String(d).padStart(2, "0"), mes: meses[(m || 1) - 1] || "—" };
}

function todayYmd(): string {
  const d = new Date(); d.setHours(0, 0, 0, 0);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}

function diaSemana(ymd: string): string {
  const [y, m, d] = ymd.split("-").map(Number);
  const dow = new Date(y, (m || 1) - 1, d).getDay();
  return ["DOMINGO","SEGUNDA","TERÇA","QUARTA","QUINTA","SEXTA","SÁBADO"][dow];
}

// ────────────────────────────────────────────────────────────────────────
// /tracking/agenda — agenda do vendedor (sincronizada com agendamentos)
// ────────────────────────────────────────────────────────────────────────
function TrackingAgendaInner({ appUser }: { appUser: AppUser }) {
  const { T } = useTheme();
  const [ags, setAgs] = useState<Agendamento[]>([]);
  const [cardsById, setCardsById] = useState<Map<string, TrackingCard>>(new Map());
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState<string | null>(null);
  const [filter, setFilter] = useState<"proximos" | "hoje" | "semana" | "passados">("proximos");

  const nome = appUser.nome || "";

  const reload = async () => {
    if (!nome) { setErr("Seu usuário não tem nome cadastrado."); setLoading(false); return; }
    setLoading(true);
    try {
      // Janela: 30 dias passados → 90 dias futuros (suficiente pros filtros)
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const past = new Date(today); past.setDate(today.getDate() - 30);
      const future = new Date(today); future.setDate(today.getDate() + 90);
      const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

      const agsR = await supabase
        .from("agendamentos")
        .select("id, card_id, vendedor, data, hora_inicio, hora_fim, modalidade, meet_link, endereco, cliente_nome, observacoes, status")
        .eq("vendedor", nome)
        .gte("data", ymd(past))
        .lte("data", ymd(future))
        .order("data", { ascending: true })
        .order("hora_inicio", { ascending: true })
        .limit(500);
      if (agsR.error) throw agsR.error;
      const agsData = (agsR.data as Agendamento[]) || [];
      setAgs(agsData);

      // Carrega cards associados pra mostrar título/produto
      const cardIds = [...new Set(agsData.map((a) => a.card_id).filter(Boolean) as string[])];
      if (cardIds.length > 0) {
        const cardsR = await supabase
          .from("kanban_cards")
          .select("id, title, responsavel, column_id, dept_id, value, tags, created_at, updated_at, details")
          .in("id", cardIds)
          .limit(500);
        if (cardsR.error) throw cardsR.error;
        const map = new Map<string, TrackingCard>();
        (cardsR.data as TrackingCard[]).forEach((c) => map.set(c.id, c));
        setCardsById(map);
      } else {
        setCardsById(new Map());
      }
      setErr(null);
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { reload(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [nome]);

  const today = todayYmd();
  const weekEnd = (() => {
    const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + 7);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  })();

  // Filtros + ordenação
  const filtered = useMemo(() => {
    return ags.filter((a) => {
      if (a.status === "cancelado") return false;
      if (filter === "hoje") return a.data === today;
      if (filter === "semana") return a.data >= today && a.data <= weekEnd;
      if (filter === "passados") return a.data < today;
      // proximos: hoje em diante
      return a.data >= today;
    });
  }, [ags, filter, today, weekEnd]);

  // Agrupa por data
  const grouped = useMemo(() => {
    const g: { data: string; items: Agendamento[] }[] = [];
    let curr: { data: string; items: Agendamento[] } | null = null;
    filtered.forEach((a) => {
      if (!curr || curr.data !== a.data) {
        curr = { data: a.data, items: [] };
        g.push(curr);
      }
      curr.items.push(a);
    });
    return g;
  }, [filtered]);

  const totalHoje = ags.filter((a) => a.data === today && a.status !== "cancelado").length;

  if (loading) return <Boot label="Carregando agenda" />;
  if (err) return <Boot label={err} variant="error" />;

  return (
    <div style={{
      position: "fixed", inset: 0, backgroundColor: T.bg, color: T.textPrimary,
      fontFamily: FONT_BODY, display: "flex", flexDirection: "column",
      overscrollBehavior: "contain", transition: "background 0.35s, color 0.35s",
    }}>
      <PageHeader
        title={`AGENDA · ${nome.toUpperCase()}`}
        sub={`${String(totalHoje).padStart(2, "0")} HOJE · ${String(ags.filter((a) => a.status !== "cancelado").length).padStart(2, "0")} TOTAIS`}
        right={
          <>
            <ThemeToggle />
            <IconButton onClick={reload} title="Recarregar"><RefreshCw size={11} /></IconButton>
            <LinkButton to="/tracking" muted>VOLTAR</LinkButton>
          </>
        }
        extra={
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: 4 }}>
            <AgendaTab active={filter === "hoje"} onClick={() => setFilter("hoje")}>HOJE</AgendaTab>
            <AgendaTab active={filter === "semana"} onClick={() => setFilter("semana")}>7 DIAS</AgendaTab>
            <AgendaTab active={filter === "proximos"} onClick={() => setFilter("proximos")}>PRÓXIMOS</AgendaTab>
            <AgendaTab active={filter === "passados"} onClick={() => setFilter("passados")}>PASSADOS</AgendaTab>
          </div>
        }
      />

      <div style={{ flex: 1, overflow: "auto", padding: "12px 14px" }}>
        {grouped.length === 0 ? (
          <div style={{
            textAlign: "center", padding: "60px 0",
