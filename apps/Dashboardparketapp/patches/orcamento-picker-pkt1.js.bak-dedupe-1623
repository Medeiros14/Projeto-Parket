// Lê access_token do usuário logado (Supabase JS salva no localStorage).
// Procura em QUALQUER chave (sem assumir formato exato), pra cobrir variantes.
let _cachedToken = null;
let _cachedTokenAt = 0;
function _userToken() {
  // Cache 30s pra não varrer localStorage toda call
  const now = Date.now();
  if (_cachedToken && now - _cachedTokenAt < 30000) return _cachedToken;
  try {
    // 1. Tenta janela do supabase JS exposto (alguns apps fazem)
    if (window.supabase && window.supabase.auth) {
      const s = (typeof window.supabase.auth.session === "function") ? window.supabase.auth.session() : null;
      if (s && s.access_token) { _cachedToken = s.access_token; _cachedTokenAt = now; return s.access_token; }
    }
    // 2. Varre TODAS as keys do localStorage e tenta achar access_token
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      const raw = k && localStorage.getItem(k);
      if (!raw || raw[0] !== "{" && raw[0] !== "[") continue;
      let parsed;
      try { parsed = JSON.parse(raw); } catch { continue; }
      // Variantes:
      //   { access_token: "..." }
      //   { currentSession: { access_token: "..." } }
      //   { session: { access_token: "..." } }
      //   [{ access_token: "..." }]
      const tok = (parsed && parsed.access_token)
        || (parsed && parsed.currentSession && parsed.currentSession.access_token)
        || (parsed && parsed.session && parsed.session.access_token)
        || (Array.isArray(parsed) && parsed[0] && parsed[0].access_token)
        || null;
      if (tok && typeof tok === "string" && tok.length > 40) {
        console.log("[orc-sync] _userToken achado em localStorage:", k, "(len=" + tok.length + ")");
        _cachedToken = tok; _cachedTokenAt = now;
        return tok;
      }
    }
    console.warn("[orc-sync] _userToken NÃO achado — usando anon (RLS pode bloquear)");
  } catch (e) {
    console.warn("[orc-sync] _userToken erro:", e);
  }
  return SB_KEY;
}

function _authHeaders(extra) {
  return Object.assign({
    apikey: SB_KEY,
    Authorization: `Bearer ${_userToken()}`,
    "Content-Type": "application/json",
  }, extra || {});
}

const COLOR_OK = "#10B981", COLOR_NEUTRAL = "#3B82F6", COLOR_RED = "#EF4444", COLOR_TEXT = "#fafafa", COLOR_DIM = "rgba(255,255,255,0.55)";

async function _fetchEquipe() {
  const r = await fetch(`${SB_URL}/rest/v1/orcamento_equipe?select=id,nome,especialidade,is_gestor,avatar_color&ativo=eq.true&order=ordem.asc`, {
    headers: _authHeaders(),
  });
  if (!r.ok) throw new Error(`fetch equipe: ${r.status}`);
  return r.json();
}

async function _patchCard(cardId, body) {
  const r = await fetch(`${SB_URL}/rest/v1/kanban_cards?id=eq.${cardId}`, {
    method: "PATCH",
    headers: _authHeaders({ Prefer: "return=representation" }),
    body: JSON.stringify(body),
  });
  if (!r.ok) throw new Error(`patch card: ${r.status} ${await r.text()}`);
  return r.json();
}

async function _insertDemanda(body) {
  const r = await fetch(`${SB_URL}/rest/v1/orcamento_demandas`, {
    method: "POST",
    headers: _authHeaders({ Prefer: "return=representation" }),
    body: JSON.stringify(body),
  });
  if (!r.ok) {
    const t = await r.text();
    // Idempotência: se já existe demanda pra esse card+orcamentista, ignora
    if (r.status === 409 || /duplicate/i.test(t)) return null;
    throw new Error(`insert demanda: ${r.status} ${t}`);
  }
  return r.json();
}

// Cria card NOVO no kanban geral do orcamento (clone do comercial).
// Vincula details.parent_card_id pro card original do comercial.
async function _createCardOrcamento(comercialCard, demandaId, orcamentistaId, orcamentistaNome) {
  const det = comercialCard.details || {};
  const payload = {
    dept_id: "orcamento",
    column_id: "solicitacao",
    title: comercialCard.title || "(sem título)",
    subtitle: comercialCard.subtitle || null,
    obra: comercialCard.obra || null,
    responsavel: orcamentistaNome || "A definir",
    priority: comercialCard.priority || "normal",
    tags: comercialCard.tags || [],
    description: comercialCard.description || null,
    details: {
      ...det,
      parent_card_id: comercialCard.id,
      parent_dept: "comercial",
      orcamentista_id: orcamentistaId,
      orcamentista_nome: orcamentistaNome,
      demanda_id: demandaId,
      criado_via: "orcamento-picker",
    },
  };
  const r = await fetch(`${SB_URL}/rest/v1/kanban_cards`, {
    method: "POST",
    headers: _authHeaders({ Prefer: "return=representation" }),
    body: JSON.stringify(payload),
  });
  if (!r.ok) {
    const t = await r.text();
    throw new Error(`create card orc: ${r.status} ${t}`);
  }
  const arr = await r.json();
  return arr && arr[0] ? arr[0] : null;
}

/**
 * Abre modal nativo (DOM puro) pra escolher orçamentista.
 * Retorna Promise<orcamentista_id | null>. null = cancelado.
 */
function openPickerModal(card) {
  return new Promise(async (resolve) => {
    let equipe;
    try {
      equipe = await _fetchEquipe();
    } catch (e) {
      alert("Erro ao carregar equipe de orçamentistas: " + e.message);
      resolve(null);
      return;
    }

    const det = card.details || {};
    const preselect = det.orcamentista_id || "";

    // Backdrop
    const back = document.createElement("div");
    back.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.78);z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;font-family:inherit";
    back.onclick = (e) => { if (e.target === back) finish(null); };

    // Modal
    const mod = document.createElement("div");
    mod.style.cssText = "background:#161616;border:1px solid rgba(255,255,255,0.1);border-radius:12px;max-width:520px;width:100%;padding:20px;color:" + COLOR_TEXT;

    const title = document.createElement("h3");
    title.textContent = "Escolha o orçamentista";
    title.style.cssText = "margin:0 0 6px;font-size:1rem;font-weight:600";

    const subtitle = document.createElement("p");
    subtitle.style.cssText = "margin:0 0 14px;font-size:0.7rem;color:" + COLOR_DIM;
    subtitle.textContent = `Card: ${card.title || "(sem título)"} — obrigatório pra mover pra Criação de Orçamento.`;

    const list = document.createElement("div");
    list.style.cssText = "display:flex;flex-direction:column;gap:6px;margin-bottom:14px;max-height:340px;overflow:auto";

    let chosen = preselect;
    const refresh = () => {
      list.innerHTML = "";
      equipe.forEach((o) => {
        const item = document.createElement("button");
        item.onclick = () => { chosen = o.id; refresh(); };
        const isActive = chosen === o.id;
        item.style.cssText = `display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;text-align:left;width:100%;background:${isActive ? o.avatar_color + "20" : "rgba(255,255,255,0.03)"};border:1px solid ${isActive ? o.avatar_color : "rgba(255,255,255,0.08)"};color:${COLOR_TEXT};font-family:inherit;font-size:0.78rem`;
        const av = document.createElement("div");
        const inicial = (o.nome || "?").trim().slice(0, 1).toUpperCase();
        av.textContent = inicial;
        av.style.cssText = `width:34px;height:34px;border-radius:17px;background:${o.avatar_color};display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;flex-shrink:0`;
        const nameWrap = document.createElement("div");
        nameWrap.style.cssText = "flex:1;min-width:0";
        const name = document.createElement("div");
        name.style.cssText = "font-weight:600;color:" + COLOR_TEXT;
        name.textContent = o.nome + (o.is_gestor ? "  ★ gestor" : "");
        const esp = document.createElement("div");
        esp.style.cssText = "font-size:0.62rem;color:" + COLOR_DIM + ";margin-top:2px";
        esp.textContent = o.especialidade || "(sem especialidade)";
        nameWrap.appendChild(name);
        nameWrap.appendChild(esp);
        item.appendChild(av);
        item.appendChild(nameWrap);
        list.appendChild(item);
      });
    };
    refresh();

    const btnRow = document.createElement("div");
    btnRow.style.cssText = "display:flex;gap:8px;justify-content:flex-end";

    const btnCancel = document.createElement("button");
    btnCancel.textContent = "Cancelar";
    btnCancel.style.cssText = "padding:8px 14px;border:1px solid rgba(255,255,255,0.15);background:transparent;color:" + COLOR_DIM + ";border-radius:6px;cursor:pointer;font-family:inherit;font-size:0.7rem;font-weight:600";
    btnCancel.onclick = () => finish(null);

    const btnOk = document.createElement("button");
    btnOk.textContent = "Atribuir e mover";
    btnOk.style.cssText = "padding:8px 14px;border:none;background:" + COLOR_OK + ";color:#fff;border-radius:6px;cursor:pointer;font-family:inherit;font-size:0.7rem;font-weight:600";
    btnOk.onclick = () => {
      if (!chosen) { alert("Selecione um orçamentista"); return; }
      finish(chosen);
    };

    btnRow.appendChild(btnCancel);
    btnRow.appendChild(btnOk);

    mod.appendChild(title);
    mod.appendChild(subtitle);
    mod.appendChild(list);
    mod.appendChild(btnRow);
    back.appendChild(mod);
    document.body.appendChild(back);

    function finish(id) {
      try { document.body.removeChild(back); } catch (e) {}
      resolve(id);
    }
  });
}

/**
 * Hook usado pelo dept-layout antes de mover card pra "criacao-orcamento".
 * Retorna true se OK pra prosseguir o move, false se cancelado/erro.
 */
async function handleMoveToCriacaoOrcamento(card) {
  if (!card || !card.id) return true;
  const det = card.details || {};

  // Se já tem orçamentista, usa direto (não pede de novo).
  // Senão, força o picker.
  let orcId = det.orcamentista_id;
  let orcNome = det.orcamentista_nome;
  if (!orcId) {
    orcId = await openPickerModal(card);
    if (!orcId) return false;  // user cancelou
    try {
      const eq = await _fetchEquipe();
      const orc = eq.find((e) => e.id === orcId);
      orcNome = orc ? orc.nome : "Orçamentista";
    } catch (e) { orcNome = "Orçamentista"; }
  }

  try {
    // Endpoint backend faz tudo: PATCH card + INSERT demanda + INSERT card orcamento
    const r = await fetch(`${AI_API}/api/orcamento-equipe/atribuir`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ card_id: card.id, orcamentista_id: orcId, orcamentista_nome: orcNome, criar_demanda: true }),
    });
    if (!r.ok) {
      const txt = await r.text();
      throw new Error(`atribuir: ${r.status} ${txt.slice(0, 200)}`);
    }
    const data = await r.json();
    console.log("[orc] moveToCriacao OK:", data);
    return true;
  } catch (e) {
    alert("Erro ao atribuir orçamentista: " + (e.message || e));
    return false;
  }
}

// ════════════════════════════════════════════════════════════════════
// Componente inline pro modal do card comercial — select estilo igual aos
// outros campos do "Funil de Vendas" (Etapa, Vendedor).
// ════════════════════════════════════════════════════════════════════
const c = h.createElement;
const STYLE_LABEL = {
  display: "block", fontSize: "0.42rem", fontWeight: 700,
  letterSpacing: "0.08em", color: "rgba(255,255,255,0.3)",
  textTransform: "uppercase", marginBottom: 3,
};
const STYLE_SELECT = {
  width: "100%", background: "rgba(255,255,255,0.04)",
  border: "1px solid rgba(255,255,255,0.08)", borderRadius: 6,
  color: "white", fontSize: "0.58rem", padding: "5px 6px", outline: "none",
};

function OrcamentistaSelectInline({ card }) {
  const [equipe, setEquipe] = h.useState([]);
  const [pendingVal, setPendingVal] = h.useState(null);
  const [saving, setSaving] = h.useState(false);
  const [err, setErr] = h.useState("");

  // DEBUG: imprime card recebido a cada render
  console.log("[OrcSel] render", { has_card: !!card, card_id: card && card.id, has_details: !!(card && card.details), orcId: card && card.details && card.details.orcamentista_id });

  const cardOrcId = ((card && card.details) || {}).orcamentista_id || "";
  const val = pendingVal !== null ? pendingVal : cardOrcId;

  h.useEffect(() => {
    let alive = true;
    _fetchEquipe()
      .then((eq) => { console.log("[OrcSel] equipe carregada", eq.length); if (alive) setEquipe(eq); })
      .catch((e) => { console.error("[OrcSel] fetch equipe erro:", e); if (alive) setErr(String(e)); });
    return () => { alive = false; };
  }, []);

  async function handleChange(e) {
    const newId = e.target.value || "";
    setPendingVal(newId);
    if (!card || !card.id) { setPendingVal(null); return; }
    setSaving(true); setErr("");
    try {
      const orc = equipe.find((x) => x.id === newId);
      const orcNome = orc ? orc.nome : "";

      // SÓ atribui (não cria demanda). Demanda só é criada quando o vendedor
      // MOVE o card pra coluna "criacao-orcamento" (via moveToCriacao).
      if (newId) {
        const isCriacao = card.column_id === "criacao-orcamento";
        const r = await fetch(`${AI_API}/api/orcamento-equipe/atribuir`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ card_id: card.id, orcamentista_id: newId, orcamentista_nome: orcNome, criar_demanda: isCriacao }),
        });
        if (!r.ok) {
          const txt = await r.text();
          throw new Error(`atribuir: ${r.status} ${txt.slice(0, 200)}`);
        }
        const data = await r.json();
        console.log("[OrcSel] atribuir OK:", data);
        // Reflete no card prop pra próximo render
        try {
          card.details = { ...(card.details || {}), orcamentista_id: newId, orcamentista_nome: orcNome };
        } catch (_) {}
      } else {
        // Remove orçamentista
        await fetch(`${AI_API}/api/orcamento-equipe/desatribuir`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ card_id: card.id }),
        });
        try {
          const det = { ...(card.details || {}) };
          delete det.orcamentista_id;
          delete det.orcamentista_nome;
          card.details = det;
        } catch (_) {}
      }
      setPendingVal(null);

      // Cria demanda + card no orçamento (idempotente)
      if (newId) {
        console.log("[OrcSel] criando demanda + card orcamento");
        const demandaArr = await _insertDemanda({
          orcamentista_id: newId,
          kanban_card_id: card.id,
          obra_code: card.obra || null,
          titulo: card.title || "(sem título)",
          tipo: (det.produto_interesse || "").split(",")[0].trim() || null,
          prioridade: card.priority || "normal",
          status: "aguarda_aceite",
          details: {
            vendedor_nome: det.vendedor || "",
            cidade: det.cidade || null,
            estado: det.estado || null,
            endereco_obra: det.endereco_obra || null,
            area_m2: det.area_m2 || null,
            produto_interesse: det.produto_interesse || null,
            coluna_origem: card.column_id || null,
          },
        });
        console.log("[OrcSel] demanda criada:", demandaArr);

        if (demandaArr && demandaArr[0] && !demandaArr[0].kanban_card_orc_id) {
          try {
            console.log("[OrcSel] criando card orcamento...");
            const cardOrc = await _createCardOrcamento(card, demandaArr[0].id, newId, orcNome);
            console.log("[OrcSel] card orcamento criado:", cardOrc);
            if (cardOrc && cardOrc.id) {
              const linkRes = await fetch(`${SB_URL}/rest/v1/orcamento_demandas?id=eq.${demandaArr[0].id}`, {
                method: "PATCH",
                headers: _authHeaders({ Prefer: "return=representation" }),
                body: JSON.stringify({ kanban_card_orc_id: cardOrc.id }),
              });
              console.log("[OrcSel] link demanda↔card_orc:", linkRes.status);
            }
          } catch (e2) {
            console.error("[OrcSel] criar card orc FALHOU:", e2);
            setErr("Card orçamento falhou: " + (e2.message || e2));
          }
        } else if (demandaArr === null) {
          console.log("[OrcSel] demanda já existia (ON CONFLICT), pulando criação card orcamento");
        }
      }
    } catch (e2) {
      setErr(String(e2.message || e2));
      setPendingVal(null);   // erro → volta pro valor do card
    } finally {
      setSaving(false);
    }
  }

  const options = [
    c("option", { value: "", key: "_none" }, "Selecionar..."),
    ...equipe.map((o) => c("option", { value: o.id, key: o.id }, o.nome + (o.is_gestor ? " ★" : ""))),
  ];

  return c("div", null,
    c("label", { style: STYLE_LABEL }, "Orçamentista"),
    c("select", {
      value: val, onChange: handleChange, disabled: saving,
      style: STYLE_SELECT,
    }, ...options),
    err && c("div", { style: { fontSize: "0.42rem", color: "#EF4444", marginTop: 3 } }, err),
  );
}

export { handleMoveToCriacaoOrcamento as moveToCriacao, OrcamentistaSelectInline as OrcSel };
