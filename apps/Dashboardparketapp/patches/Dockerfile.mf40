FROM parket-dashboard:golden-complete
COPY orcamento-simulador-tab-MARCFIX40.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX40.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec sed -i 's|orcamento-simulador-tab-MARCFIX3[5-9]\.js|orcamento-simulador-tab-MARCFIX40.js|g' {} +
RUN sed -i "s|'/assets/orcamento-simulador-tab-MARCFIX3[5-9].js'|'/assets/orcamento-simulador-tab-MARCFIX40.js'|g" /usr/share/nginx/html/index.html
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-mf40-realtime-fast'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
