FROM parket-dashboard:golden
COPY catalogos.js /usr/share/nginx/html/catalogos.js
RUN if ! grep -q 'catalogos.js' /usr/share/nginx/html/index.html; then \
      sed -i 's|</body>|<script src="/catalogos.js" defer></script></body>|' /usr/share/nginx/html/index.html; \
    fi && \
    sed -i "s|CODE_VERSION\s*=\s*'[^']*'|CODE_VERSION = '20260608-catalogos-v2'|" /usr/share/nginx/html/index.html
