FROM parket-dashboard:golden
# PKT-MF48 2026-06-22: prévia ao vivo da distribuição PRODUTO/INSUMOS/INSTALAÇÃO no modal de edição
# + arredondamento do Preço/m² na abertura + lookup robusto dos filhos (W → c → window)
COPY orcamento-simulador-tab-MARCFIX48.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX48.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX47\.js|orcamento-simulador-tab-MARCFIX48.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf48-preview'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
