FROM parket-dashboard:golden
# PKT-MF50 2026-06-22: async Supabase fallback - se PKT-ALLIN open não pegou kids, busca direto do DB e atualiza modal
COPY orcamento-simulador-tab-MARCFIX50.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX50.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX49\.js|orcamento-simulador-tab-MARCFIX50.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf50-async'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
