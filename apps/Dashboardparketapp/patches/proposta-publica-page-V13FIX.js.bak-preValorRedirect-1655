<body>

<div class="carousel">

  <!-- ═══ SLIDE 1: Intro ═══ -->
  <section class="slide slide-intro">
    <video autoplay loop muted playsinline preload="auto" class="intro-video"
           data-mobile-src="/assets/Heromobile-v3.mp4"
           data-desktop-src="https://parket.com.br/wp-content/uploads/2026/04/Parket-HeroNew.mp4">
      <source src="/assets/Heromobile-v3.mp4" type="video/mp4" />
    </video>
    <div class="intro-logo">PARKET</div>
    <div class="intro-arrow" aria-hidden="true">→</div>
  </section>

  <!-- ═══ SLIDE 2: Info do cliente (mesma estrutura do PDF) ═══ -->
  <section class="slide slide-info">
    <div class="info-logo">PARKET</div>
    <div class="info-block">
      <div class="info-line">${i(e.cidade||"São Paulo")}, ${i(e.data)}</div>
      <div class="info-gap"></div>
      <div class="info-line">Proposta comercial - ${i(e.numero)}</div>
      <div class="info-gap"></div>
      <div class="info-line">Contratante: ${i(e.cliente)}</div>
      ${e.cnpj?`<div class="info-line">CPF/CNPJ: ${i(e.cnpj)}</div>`:""}
      ${e.endereco?`<div class="info-line">Endereço: ${i(e.endereco)}</div>`:""}
      <div class="info-gap"></div>
      ${e.vendedor?`<div class="info-line">Vendedor: ${i(e.vendedor)}</div>`:""}
      ${e.orcamentista?`<div class="info-line">Orçamentista: ${i(e.orcamentista)}</div>`:""}
      ${e.arquiteto?`<div class="info-line">Arquiteto(a): ${i(e.arquiteto)}</div>`:""}
      <div class="info-gap"></div>
      <div class="info-line">Validade da proposta: ${e.validade} dias</div>
    </div>
    <div class="swipe-hint-right" aria-hidden="true">→</div>
  </section>

  <!-- ═══ SLIDE 3: Produtos gerais (sem painel/porta/marcenaria) ═══ -->
  ${e.itemsTableMain ? `<section class="slide slide-budget">
    <div class="budget-inner">
      ${e.itemsTableMain}
    </div>
    <div class="swipe-hint-right" aria-hidden="true">→</div>
    <div class="swipe-hint-down" aria-hidden="true">↓</div>
  </section>` : ''}

  <!-- ═══ SLIDE 4: Painel + Porta + Marcenaria ═══ -->
  ${e.itemsTableExtras ? `<section class="slide slide-budget">
    <div class="budget-inner">
      ${e.itemsTableExtras}
    </div>
    <div class="swipe-hint-right" aria-hidden="true">→</div>
    <div class="swipe-hint-down" aria-hidden="true">↓</div>
  </section>` : ''}

  <!-- ═══ SLIDE 5: Valor total do orçamento ═══ -->
  ${e.itemsTableTotal ? `<section class="slide slide-budget">
    <div class="budget-inner">
      ${e.itemsTableTotal}
    </div>
    <div class="swipe-hint-right" aria-hidden="true">→</div>
    <div class="swipe-hint-down" aria-hidden="true">↓</div>
  </section>` : ''}

  <!-- ═══ SLIDE 4: Formulário do Contrato ═══ -->
  <section class="slide slide-cta">
    <div class="cta-inner" id="cta-container">
      <!-- Estado inicial: só call-to-action centralizado -->
      <div id="cta-initial" class="cta-initial">
        <div class="cta-subtitle">Tudo pronto! Clique abaixo para preencher seus dados e iniciar o contrato.</div>
        <button type="button" id="cta-open-form" class="cta-btn-large">ASSINAR CONTRATO →</button>
      </div>
      <!-- Estado aberto: formulário (escondido inicialmente) -->
      <div id="cta-form-wrap" style="display:none">
      <div class="cta-title">Dados para o contrato</div>
      <div class="cta-subtitle">Preencha os campos abaixo. Em poucos minutos enviaremos os documentos pra assinatura digital.</div>
      <form class="cta-form" id="contract-form" onsubmit="return false">
        <div class="field full">
          <label>Nome completo *</label>
          <input id="cf_nome" required value="${i(e.cliente)}" placeholder="Nome completo"/>
        </div>
        <div class="field">
          <label>CPF / CNPJ *</label>
          <input id="cf_cpf" required value="${i(e.cnpj)}" placeholder="000.000.000-00"/>
        </div>
        <div class="field">
          <label>RG / IE *</label>
          <input id="cf_rg" required placeholder="00.000.000-0"/>
        </div>
        <div class="field">
          <label>Telefone *</label>
          <input id="cf_tel" type="tel" required placeholder="(11) 9 9999-9999"/>
        </div>
        <div class="field">
          <label>E-mail *</label>
          <input id="cf_email" type="email" required placeholder="seu@email.com"/>
        </div>
        <div class="field">
          <label>CEP</label>
          <input id="cf_cep" placeholder="00000-000" maxlength="9"/>
        </div>
        <div class="field">
          <label>Estado civil</label>
          <select id="cf_estciv">
            <option value="">Selecione…</option>
            <option value="solteiro">Solteiro(a)</option>
            <option value="casado">Casado(a)</option>
            <option value="divorciado">Divorciado(a)</option>
            <option value="viuvo">Viúvo(a)</option>
            <option value="uniao_estavel">União estável</option>
          </select>
        </div>
        <div class="field full">
          <label>Endereço (rua) *</label>
          <input id="cf_rua" required placeholder="Rua, Avenida..."/>
        </div>
        <div class="field">
          <label>Número *</label>
          <input id="cf_num" required placeholder="123"/>
        </div>
        <div class="field">
          <label>Complemento</label>
          <input id="cf_comp" placeholder="Apto, sala..."/>
        </div>
        <div class="field full">
          <label>Bairro *</label>
          <input id="cf_bairro" required placeholder="Bairro"/>
        </div>
        <div class="field">
          <label>Cidade *</label>
          <input id="cf_cidade" required value="${i(e.cidade||"")}" placeholder="Cidade"/>
        </div>
        <div class="field">
          <label>Estado (UF) *</label>
          <input id="cf_uf" required maxlength="2" placeholder="SP" style="text-transform:uppercase"/>
        </div>
        <label class="cta-terms">
          <input type="checkbox" id="cf_termos" required/>
          <span>Li e estou de acordo com os termos do contrato e as condições comerciais apresentadas acima.</span>
        </label>
        <div id="cf_status"></div>
        <button class="cta-btn" id="cf_submit" type="submit">ENVIAR DADOS →</button>
      </form>
      </div>
    </div>
  </section>

</div>

<script>
(function() {
  // Desliga restauração de scroll do navegador — assim cada reload começa no slide 1
  if ('scrollRestoration' in history) {
    try { history.scrollRestoration = 'manual'; } catch (e) {}
  }
  function init() {
    var carousel = document.querySelector('.carousel');
    if (!carousel) return;
    var slides = carousel.querySelectorAll('.slide');
    var total = slides.length;
    if (total === 0) return;

    // Força começar no slide 1 (intro) em todo carregamento
    try {
      carousel.scrollLeft = 0;
      if (slides[0]) slides[0].scrollTop = 0;
    } catch (e) {}
    // E também depois de um tick (alguns navegadores restauram após o load)
    setTimeout(function(){
      try {
        carousel.scrollLeft = 0;
        for (var _i = 0; _i < slides.length; _i++) slides[_i].scrollTop = 0;
        window.scrollTo(0, 0);
      } catch (e) {}
    }, 0);
    window.addEventListener('pageshow', function(ev){
      // pageshow dispara inclusive em back/forward cache (Safari/Firefox)
      if (ev.persisted) {
        try {
          carousel.scrollLeft = 0;
          for (var _j = 0; _j < slides.length; _j++) slides[_j].scrollTop = 0;
        } catch (e) {}
        // re-dispara vídeo do começo
        var _v = document.querySelector('.intro-video');
        if (_v) { try { _v.currentTime = 0; _v.play(); } catch (e) {} }
      }
    });

    // ── Intro: troca vídeo por desktop/mobile + acelera + auto-scroll em 4s ──
