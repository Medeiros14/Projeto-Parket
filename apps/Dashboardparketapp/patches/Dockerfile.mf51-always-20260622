FROM parket-dashboard:golden
# PKT-MF51 2026-06-22: query Supabase async SEMPRE ao abrir modal, sem condição.
# Garante que Preço/m² mostre o valor all-in real (soma das 3 linhas / m²_perda_ceil)
COPY orcamento-simulador-tab-MARCFIX51.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX51.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX50\.js|orcamento-simulador-tab-MARCFIX51.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf51-always'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
