/**
 * Recalc proporcional ao editar valor do PRODUTO no simulador (modal Editar).
 *
 * v3 (2026-06-22):
 *   - Lê do banco LOCAL via api.parket.works (fresh data, sem lag de cron)
 *   - Busca siblings permissiva: parent_item_id OU mesmo simulacao_id + categoria
 *   - Overlay aparece mesmo sem siblings encontrados (mostra mensagem clara)
 *   - Erros são VISÍVEIS no overlay (não mais silent fallback)
 *
 * Hook: MARCFIX46.js — botão Salvar do modal Editar.
 * Signature:
 *   window.__pktSaveItemWithRecalc(uItemFn, itemId, newDesc, newVal, extra)
 *     extra = { m, perda, unit }
 *   Retorna {cancelled:true} se usuário cancelar; undefined em sucesso.
 */
(function () {
  if (typeof window === "undefined") return;
  if (window.__pktSaveItemWithRecalc) return;

  // Lê via gateway LOCAL (fresh) — fallback pra Cloud se falhar
  var LOCAL_URL = "https://api.parket.works";
  var CLOUD_URL = "https://hbxpilrxmitvzebluoom.supabase.co";
  var ANON_KEY  = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhieHBpbHJ4bWl0dnplYmx1b29tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI5NDI1MjcsImV4cCI6MjA4ODUxODUyN30.ciZA1H-UvlYG2OPWqrFChj-_ttiFD5W5BmrST-gUJ-0";

  function getToken() {
    try {
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i);
        var raw = k && localStorage.getItem(k);
        if (!raw || (raw[0] !== "{" && raw[0] !== "[")) continue;
        try {
          var p = JSON.parse(raw);
          var t = (p && p.access_token) || (p && p.currentSession && p.currentSession.access_token) || null;
          if (t && t.length > 40) return t;
        } catch (e) {}
      }
    } catch (e) {}
    return ANON_KEY;
  }
  function headers() {
    return { apikey: ANON_KEY, Authorization: "Bearer " + getToken(), "Content-Type": "application/json" };
  }

  async function tryFetch(path) {
    // Tenta Local primeiro, fallback Cloud
    var urls = [LOCAL_URL + path, CLOUD_URL + path];
    for (var i = 0; i < urls.length; i++) {
      try {
        var r = await fetch(urls[i], { headers: headers() });
        if (r.ok) {
          var data = await r.json();
          return { ok: true, data: data, source: i === 0 ? "local" : "cloud" };
        }
      } catch (e) {
        console.warn("[pkt-recalc] fetch falhou em " + urls[i], e);
      }
    }
    return { ok: false };
  }

  function fetchSimulacaoItens(simId) {
    return tryFetch("/rest/v1/simulacao_itens?simulacao_id=eq." + encodeURIComponent(simId) + "&select=*");
  }

  function isInsumos(it) { return /^\s*INSUMOS/i.test(String((it && it.descritivo) || "").trim()); }
  function isInstal(it)  { return /^\s*INSTALA/i.test(String((it && it.descritivo) || "").trim()); }
  function isAux(it)     { return isInsumos(it) || isInstal(it); }

  function getSplit(categoria) {
    var c = String(categoria || "").toUpperCase().split("||")[0].trim();
    var isPisoPorta = c === "PISO" || c === "PORTA";
    return isPisoPorta ? { prod: 0.70, ins: 0.10, inst: 0.20 } : { prod: 0.60, ins: 0.15, inst: 0.25 };
  }

  function fmtBRL(v) { return "R$ " + Number(v).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function signed(v) { return (v >= 0 ? "+" : "") + fmtBRL(v); }
  function fmtM2(v) { return Number(v).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " m²"; }

  function showOverlay(html) {
    var ov = document.createElement("div");
    ov.className = "pkt-recalc-overlay";
    ov.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:99999999;display:flex;align-items:center;justify-content:center;padding:16px;font-family:-apple-system,Segoe UI,system-ui,sans-serif;";
    var box = document.createElement("div");
    box.style.cssText = "background:#0e0e0e;border:1px solid rgba(255,255,255,0.15);border-radius:12px;padding:24px;width:100%;max-width:580px;color:#fff;box-sizing:border-box;max-height:92vh;overflow-y:auto;";
    box.innerHTML = html;
    ov.appendChild(box);
    document.body.appendChild(ov);
    return { overlay: ov, box: box };
  }
  function closeOverlay(ov) { if (ov && ov.parentNode) ov.parentNode.removeChild(ov); }

  function showError(title, msg) {
    return new Promise(function (resolve) {
      var html =
        '<div style="font-size:14px;color:#ef4444;margin-bottom:12px;font-weight:600;">⚠️ ' + title + '</div>' +
        '<div style="font-size:13px;color:#ccc;margin-bottom:18px;line-height:1.6;">' + msg + '</div>' +
        '<div style="display:flex;gap:10px;justify-content:flex-end;">' +
        '<button id="pkt-e-cancel" style="padding:9px 18px;border:1px solid rgba(255,255,255,0.2);background:transparent;color:#fff;border-radius:8px;cursor:pointer;font-size:12px;">Cancelar edição</button>' +
        '<button id="pkt-e-save" style="padding:9px 22px;border:none;background:#fbbf24;color:#000;border-radius:8px;cursor:pointer;font-weight:700;font-size:13px;">Salvar mesmo assim</button>' +
        '</div>';
      var x = showOverlay(html);
      x.box.querySelector("#pkt-e-cancel").onclick = function () { closeOverlay(x.overlay); resolve("cancel"); };
      x.box.querySelector("#pkt-e-save").onclick   = function () { closeOverlay(x.overlay); resolve("save"); };
    });
  }

  function confirmRecalc(ctx) {
    return new Promise(function (resolve) {
      var s = ctx.split;
      var rows = ctx.rows;
      var newTotal = rows.prod.novo + rows.ins.novo + rows.inst.novo;
      var oldTotal = rows.prod.antigo + rows.ins.antigo + rows.inst.antigo;
      var pctStr = Math.round(s.prod * 100) + " / " + Math.round(s.ins * 100) + " / " + Math.round(s.inst * 100);

      var inputsBlock = "";
      var computeBlock = "";
      if (ctx.m > 0 && ctx.unit > 0) {
        var mWithPerda = ctx.m * (1 + (ctx.perda || 0) / 100);
        inputsBlock =
          '<div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;margin-bottom:14px;">' +
          '<div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">Inputs do simulador</div>' +
          '<table style="width:100%;font-size:12px;">' +
          '<tr><td style="color:#aaa;padding:3px 0;">Metragem real:</td><td style="text-align:right;color:#fff;padding:3px 0;">' + fmtM2(ctx.m) + '</td></tr>' +
          '<tr><td style="color:#aaa;padding:3px 0;">Perda:</td><td style="text-align:right;color:#fff;padding:3px 0;">' + (ctx.perda || 0) + '%</td></tr>' +
          '<tr><td style="color:#aaa;padding:3px 0;">m² com perda:</td><td style="text-align:right;color:#fff;padding:3px 0;">' + fmtM2(mWithPerda) + '</td></tr>' +
          '<tr><td style="color:#aaa;padding:3px 0;">Preço unitário:</td><td style="text-align:right;color:#fff;padding:3px 0;font-weight:600;">' + fmtBRL(ctx.unit) + ' / m²</td></tr>' +
          '</table></div>';
        computeBlock =
          '<div style="background:rgba(34,197,94,0.06);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px;margin-bottom:14px;font-size:12px;">' +
          '<div style="color:#888;margin-bottom:4px;">Cálculo do novo PRODUTO:</div>' +
          '<div style="font-family:monospace;color:#22c55e;">' +
          ctx.m.toLocaleString("pt-BR", {minimumFractionDigits:2}) + ' × (1 + ' + (ctx.perda||0) + '%) × ' + fmtBRL(ctx.unit) + ' = <b>' + fmtBRL(rows.prod.novo) + '</b>' +
          '</div></div>';
      }

      function row(label, old, novo) {
        var d = novo - old;
        return '<tr>' +
          '<td style="padding:6px 4px;">' + label + '</td>' +
          '<td style="text-align:right;padding:6px 4px;color:#999;">' + fmtBRL(old) + '</td>' +
          '<td style="text-align:right;padding:6px 4px;color:#fff;">' + fmtBRL(novo) + '</td>' +
          '<td style="text-align:right;padding:6px 4px;color:' + (d >= 0 ? '#22c55e' : '#ef4444') + ';">' + signed(d) + '</td>' +
          '</tr>';
      }

      var splitBlock =
        '<table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:18px;">' +
        '<thead><tr style="color:#888;border-bottom:1px solid #333;">' +
        '<th style="text-align:left;padding:6px 4px;">Linha</th>' +
        '<th style="text-align:right;padding:6px 4px;">Antes</th>' +
        '<th style="text-align:right;padding:6px 4px;">Depois</th>' +
        '<th style="text-align:right;padding:6px 4px;">Δ</th>' +
        '</tr></thead><tbody>' +
        row("PRODUTO",    rows.prod.antigo, rows.prod.novo) +
        row("INSUMOS",    rows.ins.antigo,  rows.ins.novo) +
        row("INSTALAÇÃO", rows.inst.antigo, rows.inst.novo) +
        '<tr style="border-top:1px solid #333;font-weight:700;">' +
        '<td style="padding:8px 4px;">TOTAL</td>' +
        '<td style="text-align:right;padding:8px 4px;color:#999;">' + fmtBRL(oldTotal) + '</td>' +
        '<td style="text-align:right;padding:8px 4px;color:#fff;">' + fmtBRL(newTotal) + '</td>' +
        '<td style="text-align:right;padding:8px 4px;color:' + ((newTotal - oldTotal) >= 0 ? '#22c55e' : '#ef4444') + ';">' + signed(newTotal - oldTotal) + '</td>' +
        '</tr>' +
        '</tbody></table>';

      var html =
        '<div style="font-size:14px;color:#22c55e;margin-bottom:8px;font-weight:600;">Confirmar recálculo</div>' +
        '<div style="font-size:11px;color:#888;margin-bottom:14px;text-transform:uppercase;letter-spacing:0.5px;">' + (ctx.categoriaLabel || "Item") + ' · Split ' + pctStr + '</div>' +
        inputsBlock +
        computeBlock +
        '<div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Split proporcional</div>' +
        splitBlock +
        '<div style="font-size:11px;color:#fbbf24;margin-bottom:14px;">⚠️ Vai sobrescrever 3 linhas no banco. Confere e confirma?</div>' +
        '<div style="display:flex;gap:10px;justify-content:flex-end;">' +
        '<button id="pkt-c-cancel" style="padding:9px 18px;border:1px solid rgba(255,255,255,0.2);background:transparent;color:#fff;border-radius:8px;cursor:pointer;font-size:12px;">Cancelar</button>' +
        '<button id="pkt-c-ok"     style="padding:9px 22px;border:none;background:#22c55e;color:#000;border-radius:8px;cursor:pointer;font-weight:700;font-size:13px;">OK, está certo</button>' +
        '</div>';
      var x = showOverlay(html);
      x.box.querySelector("#pkt-c-cancel").onclick = function () { closeOverlay(x.overlay); resolve(false); };
      x.box.querySelector("#pkt-c-ok").onclick     = function () { closeOverlay(x.overlay); resolve(true); };
    });
  }

  window.__pktSaveItemWithRecalc = async function (uItemFn, itemId, newDesc, newVal, extra) {
    extra = extra || {};
    var saveSolo = function () { return uItemFn(itemId, { descritivo: newDesc, valor: newVal }); };

    // ── Lookup do simulacao_id e do item via window.__pktSimsList (já existe no MARCFIX46)
    // Não temos acesso direto ao items array, então fazemos uma busca larga via api.parket.works.
    // Estratégia: buscar TODAS as sims do user via tabela; pesquisar item itemId.
    // Alternativa: usar PATCH com filter id=eq.itemId + retornar a linha pra pegar simulacao_id.

    var itemRes;
    try {
      itemRes = await tryFetch("/rest/v1/simulacao_itens?id=eq." + encodeURIComponent(itemId) + "&select=*");
    } catch (e) {
      console.error("[pkt-recalc] erro buscando item:", e);
    }
    if (!itemRes || !itemRes.ok || !itemRes.data || !itemRes.data.length) {
      // Item não encontrado → save direto (não bloqueia o user)
      console.warn("[pkt-recalc] item não achado, save direto");
      return saveSolo();
    }
    var item = itemRes.data[0];
    var oldVal = Number(item.valor) || 0;
    var n = Number(newVal) || 0;

    if (Math.abs(n - oldVal) < 0.01) {
      // Valor não mudou, save direto
      return saveSolo();
    }
    if (isAux(item)) {
      // Edita aux direto — usuario quer só salvar essa linha
      return saveSolo();
    }
    var cat = String(item.categoria || "").toUpperCase();
    if (/^(ESCADA|MARCENARIA|MAO|MÃO|LOGI|LOG[IÍ]STICA|RECORTES|RODAP)/.test(cat)) {
      return saveSolo();
    }
    if (!item.simulacao_id) {
      return saveSolo();
    }

    // Busca TODOS os itens da simulação
    var allRes;
    try {
      allRes = await fetchSimulacaoItens(item.simulacao_id);
    } catch (e) {
      console.error("[pkt-recalc] erro buscando simulacao:", e);
    }
    if (!allRes || !allRes.ok) {
      var choice0 = await showError(
        "Não consegui buscar a simulação",
        "Não foi possível recalcular os auxiliares automaticamente. Deseja salvar só o PRODUTO?"
      );
      if (choice0 === "cancel") return { cancelled: true };
      return saveSolo();
    }
    var allItems = allRes.data || [];

    // Procura INSUMOS e INSTALAÇÃO vinculados:
    // Prioridade 1: parent_item_id === item.id
    // Prioridade 2: mesmo categoria + sem parent_item_id
    var insumos = allItems.find(function (s) {
      return s.id !== item.id && isInsumos(s) && s.meta && s.meta.parent_item_id === item.id;
    });
    var instal = allItems.find(function (s) {
      return s.id !== item.id && isInstal(s) && s.meta && s.meta.parent_item_id === item.id;
    });
    if (!insumos) {
      insumos = allItems.find(function (s) {
        return s.id !== item.id && s.categoria === item.categoria && isInsumos(s) &&
               (!s.meta || !s.meta.parent_item_id);
      });
    }
    if (!instal) {
      instal = allItems.find(function (s) {
        return s.id !== item.id && s.categoria === item.categoria && isInstal(s) &&
               (!s.meta || !s.meta.parent_item_id);
      });
    }

    if (!insumos && !instal) {
      var choice1 = await showError(
        "Sem INSUMOS / INSTALAÇÃO vinculados",
        "Este item não tem linhas de INSUMOS nem INSTALAÇÃO na simulação. Só vou salvar o PRODUTO."
      );
      if (choice1 === "cancel") return { cancelled: true };
      return saveSolo();
    }

    var split = getSplit(item.categoria);
    var newF = n / split.prod;
    var newIns = +(newF * split.ins).toFixed(2);
    var newInst = +(newF * split.inst).toFixed(2);

    var ok = await confirmRecalc({
      categoriaLabel: String(item.categoria || "").replace(/\|\|/g, " · "),
      split: split,
      m: Number(extra.m) || 0,
      perda: Number(extra.perda) || 0,
      unit: Number(extra.unit) || 0,
      rows: {
        prod: { antigo: oldVal, novo: n },
        ins:  { antigo: insumos ? (Number(insumos.valor) || 0) : 0, novo: insumos ? newIns : 0 },
        inst: { antigo: instal ? (Number(instal.valor) || 0) : 0,  novo: instal ? newInst : 0 },
      },
    });
    if (!ok) return { cancelled: true };

    try {
      await uItemFn(itemId, { descritivo: newDesc, valor: n });
      if (insumos) await uItemFn(insumos.id, { valor: newIns });
      if (instal)  await uItemFn(instal.id,  { valor: newInst });
      console.log("[pkt-recalc] APLICADO:", { produto: n, insumos: newIns, instalacao: newInst });
    } catch (e) {
      console.error("[pkt-recalc] erro aplicando updates:", e);
      alert("Erro ao salvar o recálculo: " + (e && e.message ? e.message : e));
    }
  };
})();
