// ────────────────────────────────────────────────────────────────────────
// /tracking — swipe do vendedor
// ────────────────────────────────────────────────────────────────────────
type TrackingTab = "fila" | "pipeline" | "tarefas" | "carteira";

function TrackingInner({ appUser }: { appUser: AppUser }) {
  const { T } = useTheme();
  const [cards, setCards] = useState<TrackingCard[]>([]);
  const [ags, setAgs] = useState<Map<string, Agendamento[]>>(new Map()); // card_id → agendamentos
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState<string | null>(null);
  const [idx, setIdx] = useState(0);
  const [busy, setBusy] = useState(false);
  const [showMoveMenu, setShowMoveMenu] = useState(false);
  const [pendingAction, setPendingAction] = useState<PendingAction | null>(null);
  // Nova: tab atual (Fila/Clientes/Tarefas/Carteira). Persiste em localStorage.
  const [tab, setTab] = useState<TrackingTab>(() => (localStorage.getItem("hb-tracking-tab") as TrackingTab) || "fila");
  useEffect(() => { localStorage.setItem("hb-tracking-tab", tab); }, [tab]);

  const isAdmin = appUser.isGestor || appUser.canSeeAll;
  const nome = appUser.nome || "";

  const reload = async () => {
    if (!nome) { setErr("Seu usuário não tem nome cadastrado."); setLoading(false); return; }
    setLoading(true);
    try {
      // 1) Cards onde EU sou responsável
      const cardsByResp = supabase
        .from("kanban_cards")
        .select("id, title, responsavel, column_id, dept_id, value, tags, created_at, updated_at, details")
        .eq("dept_id", DEPT)
        .in("column_id", ACTIVE_STAGES as unknown as string[])
        .eq("responsavel", nome)
        .limit(500);

      // 2) Agendamentos meus de hoje em diante (não cancelados)
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const todayYmd = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
      const agsQuery = supabase
        .from("agendamentos")
        .select("id, card_id, vendedor, data, hora_inicio, hora_fim, modalidade, meet_link, endereco, cliente_nome, observacoes, status")
        .eq("vendedor", nome)
        .neq("status", "cancelado")
        .gte("data", todayYmd)
        .order("data", { ascending: true })
        .order("hora_inicio", { ascending: true })
        .limit(500);

      const [respR, agsR] = await Promise.all([cardsByResp, agsQuery]);
      if (respR.error) throw respR.error;
      if (agsR.error) throw agsR.error;

      const cardsFromResp = (respR.data as TrackingCard[]) || [];
      const agsData = (agsR.data as Agendamento[]) || [];

      // Map agendamentos por card_id
      const agsByCard = new Map<string, Agendamento[]>();
      const extraCardIds = new Set<string>();
      const haveCardIds = new Set(cardsFromResp.map((c) => c.id));
      agsData.forEach((a) => {
        if (!a.card_id) return;
        const arr = agsByCard.get(a.card_id) || [];
        arr.push(a);
        agsByCard.set(a.card_id, arr);
        if (!haveCardIds.has(a.card_id)) extraCardIds.add(a.card_id);
      });

      // 3) Buscar cards extra (que tenho agendamento mas não sou responsavel)
      let extraCards: TrackingCard[] = [];
      if (extraCardIds.size > 0) {
        const r2 = await supabase
          .from("kanban_cards")
          .select("id, title, responsavel, column_id, dept_id, value, tags, created_at, updated_at, details")
          .eq("dept_id", DEPT)
          .in("column_id", ACTIVE_STAGES as unknown as string[])
          .in("id", [...extraCardIds])
          .limit(500);
        if (r2.error) throw r2.error;
        extraCards = (r2.data as TrackingCard[]) || [];
      }

      // Merge + ordenação: cards com agendamento HOJE primeiro, depois pelos com
      // agendamento futuro, depois pelo updated_at mais antigo.
      const all = [...cardsFromResp, ...extraCards];
      const score = (c: TrackingCard) => {
        const a = agsByCard.get(c.id)?.[0];
        if (!a) return 9_999_999_999_999;
        if (a.data === todayYmd) return 0; // top
        return new Date(a.data + "T00:00:00").getTime();
      };
      all.sort((a, b) => {
        const sa = score(a), sb = score(b);
        if (sa !== sb) return sa - sb;
        return (a.updated_at || "").localeCompare(b.updated_at || "");
      });

      setCards(all);
      setAgs(agsByCard);
      setErr(null);
    } catch (e: any) {
      setErr(e?.message || String(e)); setCards([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { reload(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [nome]);
  useEffect(() => { setShowMoveMenu(false); setPendingAction(null); }, [idx]);

  const removeCurrentAndAdvance = () => {
    setCards((prev) => prev.filter((_, i) => i !== idx));
    setIdx((i) => Math.max(0, Math.min(i, cards.length - 2)));
  };

  // Helper: empilha obs em details.observacoes_tracking[]
  function buildDetailsWithObs(curr: any, entry: {
    kind: "match" | "cadencia" | "move" | "win" | "lost";
    fromColumn: string; toColumn: string | null; text: string | null;
  }) {
    const list = Array.isArray(curr?.observacoes_tracking) ? curr.observacoes_tracking : [];
    const newEntry = {
      at: new Date().toISOString(),
      by: nome,
      kind: entry.kind,
      from_column: entry.fromColumn,
      to_column: entry.toColumn,
      text: entry.text || null,
    };
    return { list: [...list, newEntry], entry: newEntry };
  }

  const moveTo = async (toColumn: string, obs?: string, extraDetails?: Record<string, any>) => {
    const c = cards[idx]; if (!c) return;
    setBusy(true);
    try {
      const kind = toColumn === "ganho" ? "win" : "move";
      const { list } = buildDetailsWithObs(c.details, { kind, fromColumn: c.column_id, toColumn, text: obs || null });
      const nextDetails = { ...(c.details || {}), observacoes_tracking: list, ...(extraDetails || {}) };
      const r = await supabase.from("kanban_cards").update({ column_id: toColumn, details: nextDetails }).eq("id", c.id);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      await supabase.from("card_movements").insert({
        card_id: c.id, from_column: c.column_id, to_column: toColumn,
        moved_by: nome, moved_at: new Date().toISOString(),
      });
      removeCurrentAndAdvance();
    } finally { setBusy(false); }
  };

  const markCadencia = async (obs?: string) => {
    const c = cards[idx]; if (!c) return;
    setBusy(true);
    try {
      const { list } = buildDetailsWithObs(c.details, { kind: "cadencia", fromColumn: c.column_id, toColumn: null, text: obs || null });
      const nextDetails = {
        ...(c.details || {}),
        cadencia_ultima_at: new Date().toISOString(),
        cadencia_ultima_por: nome,
        cadencia_ultima_obs: obs || null,
        observacoes_tracking: list,
      };
      const r = await supabase.from("kanban_cards").update({ details: nextDetails }).eq("id", c.id);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      removeCurrentAndAdvance();
    } finally { setBusy(false); }
  };

  const matchHot = async (obs?: string) => {
    const c = cards[idx]; if (!c) return;
    setBusy(true);
    try {
      const tagsSet = new Set([...(c.tags || []), "quente"]);
      const { list } = buildDetailsWithObs(c.details, { kind: "match", fromColumn: c.column_id, toColumn: "contato-inicial", text: obs || null });
      const nextDetails = { ...(c.details || {}), observacoes_tracking: list };
      const r = await supabase
        .from("kanban_cards")
        .update({ column_id: "contato-inicial", tags: [...tagsSet], details: nextDetails })
        .eq("id", c.id);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      await supabase.from("card_movements").insert({
        card_id: c.id, from_column: c.column_id, to_column: "contato-inicial",
        moved_by: nome, moved_at: new Date().toISOString(),
      });
      removeCurrentAndAdvance();
    } finally { setBusy(false); }
  };

  const markLost = async (obs?: string) => {
    const c = cards[idx]; if (!c) return;
    setBusy(true);
    try {
      const reason = obs || null;
      const { list } = buildDetailsWithObs(c.details, { kind: "lost", fromColumn: c.column_id, toColumn: "perda", text: reason || null });
      const nextDetails = {
        ...(c.details || {}),
        motivo_perda: reason || null,
        perda_em: new Date().toISOString(),
        perda_por: nome,
        observacoes_tracking: list,
      };
      const r = await supabase
        .from("kanban_cards")
        .update({ column_id: "perda", details: nextDetails })
        .eq("id", c.id);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      await supabase.from("card_movements").insert({
        card_id: c.id, from_column: c.column_id, to_column: "perda",
        moved_by: nome, moved_at: new Date().toISOString(),
      });
      removeCurrentAndAdvance();
    } finally { setBusy(false); }
  };

  const skip = () => {
    if (idx + 1 >= cards.length) setIdx(0);
    else setIdx((i) => i + 1);
  };

  if (loading) return <Boot label="Carregando fila" />;
  if (err) return <Boot label={err} variant="error" />;

  const current = cards[idx];

  return (
    <div style={{
      position: "fixed", inset: 0,
      backgroundColor: T.bg, color: T.textPrimary,
      fontFamily: FONT_BODY,
      display: "flex", flexDirection: "column",
      overscrollBehavior: "contain",
      transition: "background 0.35s, color 0.35s",
    }}>
      <PageHeader title={`TRACKING · ${nome.toUpperCase()}`} sub={
        tab === "fila"     ? `${String(cards.length).padStart(2, "0")} CARDS NA FILA` :
        tab === "pipeline" ? `${String(cards.length).padStart(2, "0")} CLIENTES NO PIPELINE` :
        tab === "tarefas"  ? "MINHAS TAREFAS" :
        "CARTEIRA DE PARCEIROS"
      }
        right={
          <>
            <ThemeToggle />
            <IconButton onClick={reload} title="Recarregar"><RefreshCw size={11} /></IconButton>
            <LinkButton to="/tracking/agenda" icon={<Calendar size={10} />}>AGENDA</LinkButton>
            {isAdmin && <LinkButton to="/tracking/admin">ADMIN</LinkButton>}
            <LinkButton to="/" muted>SAIR</LinkButton>
          </>
        }
        extra={<TabsBar tab={tab} onChange={setTab} T={T} />}
      />

      <InstallPrompt />
      <TarefasVendedorBar nome={nome} />

      {tab === "fila" && (!current ? (
        <FilaZerada onReload={reload} />
      ) : (
        <CardSwipe
          card={current}
          ags={ags.get(current.id) || []}
          idx={idx}
          total={cards.length}
          busy={busy}
          showMoveMenu={showMoveMenu}
          setShowMoveMenu={setShowMoveMenu}
          pendingAction={pendingAction}
          setPendingAction={setPendingAction}
          onMoveTo={moveTo}
          onMatchHot={matchHot}
          onMarkCadencia={markCadencia}
          onMarkLost={markLost}
          onSkip={skip}
          onPrev={() => setIdx((i) => Math.max(0, i - 1))}
          onNext={() => setIdx((i) => Math.min(cards.length - 1, i + 1))}
          onCardDetailsUpdated={(newDetails) => {
            setCards((prev) => prev.map((c, i) => i === idx ? { ...c, details: newDetails } : c));
          }}
        />
      ))}
      {tab === "pipeline" && <PipelineView cards={cards} appUser={appUser} T={T} />}
      {tab === "tarefas"  && <TarefasView appUser={appUser} T={T} />}
      {tab === "carteira" && <CarteiraView appUser={appUser} T={T} />}
    </div>
  );
}

function TabsBar({ tab, onChange, T }: { tab: TrackingTab; onChange: (t: TrackingTab) => void; T: Theme }) {
  const TABS: { key: TrackingTab; label: string; icon: any }[] = [
    { key: "fila",     label: "FILA",     icon: ChevronsLeftRight },
    { key: "pipeline", label: "PIPELINE", icon: LayoutList },
    { key: "tarefas",  label: "TAREFAS",  icon: ListTodo },
    { key: "carteira", label: "CARTEIRA", icon: Users },
  ];
  return (
    <div style={{ display: "flex", gap: 0, borderTop: `1px solid ${T.border}` }}>
      {TABS.map((t) => {
        const active = tab === t.key;
        const Icon = t.icon;
        return (
          <button key={t.key} onClick={() => onChange(t.key)}
            style={{
              flex: 1, padding: "10px 14px",
              background: active ? T.surfaceHover : "transparent",
              borderBottom: active ? `2px solid ${T.textPrimary}` : "2px solid transparent",
              color: active ? T.textPrimary : T.textSecondary,
              fontFamily: FONT_BODY, fontSize: 10, letterSpacing: "0.18em",
              display: "flex", alignItems: "center", justifyContent: "center", gap: 6,
              cursor: "pointer", transition: "all 0.15s",
            }}>
            <Icon size={11} /> {t.label}
          </button>
        );
      })}
    </div>
  );
}

// ─── Card swipe ─────────────────────────────────────────────────────────
function CardSwipe(props: {
  card: TrackingCard; ags: Agendamento[];
  idx: number; total: number; busy: boolean;
  showMoveMenu: boolean; setShowMoveMenu: (v: boolean) => void;
  pendingAction: PendingAction | null;
  setPendingAction: (a: PendingAction | null) => void;
  onMoveTo: (col: string, obs?: string) => Promise<void> | void;
  onMatchHot: (obs?: string) => Promise<void> | void;
  onMarkCadencia: (obs?: string) => Promise<void> | void;
  onMarkLost: (obs?: string) => Promise<void> | void;
  onSkip: () => void; onPrev: () => void; onNext: () => void;
  onCardDetailsUpdated: (newDetails: any) => void;
}) {
  const { T, mode } = useTheme();
  const { card, ags, idx, total, busy } = props;
  const det = card.details || {};
  const stage = card.column_id;
  const stageLabel = (STAGE_LABEL[stage] || stage).toUpperCase();

  const phone = (det.celular || det.telefone || det.contato_principal || "").toString().replace(/\D/g, "");
  const phoneIntl = phone.startsWith("55") ? phone : phone ? "55" + phone : "";

  const nome = det.contato_principal || det.nome || card.title || "(sem nome)";
  const cidade = det.cidade || "";
  const estado = det.estado || "";
  const produto = det.produto_interesse || "";
  const metragem = det.metragem_estimada || det.area_m2 || det.metragem;
  const faixa = det.faixa_investimento || "";
  const valorEnviado = det.valor_orcamento_enviado || card.value || "";
  const valor = parseValueText(valorEnviado);
  const empresa = det.empresa_contato || det.empresa_lead || det.escritorio_empresa;
  const ultima = det.cadencia_ultima_at || card.updated_at;
  const resumo = det.resumo_qualificacao;
  const overviewIA = det.overview_ia;

  const relacao = det.relacao_obra;
  const prazo = det.previsao_instalacao || det.prazo || det.previsao;
  const madeira = det.preferencia_madeira;
  const arquitetura = det.arquitetura;
  const escritorio = det.escritorio_empresa && det.escritorio_empresa !== empresa ? det.escritorio_empresa : null;
  const endereco = det.endereco_obra;

  const { nivel, fonte: nivelFonte } = classificarNivel({
    valor, slug: stage, ultimaMsgAt: card.updated_at,
    tags: card.tags, det, aguardando: false,
  });
  const NIVEL_META = getNivelMeta(T, mode);
  const nivelMeta = NIVEL_META[nivel];

  const isNova = stage === "novas-oportunidades";
  const isCadencia = (CADENCIA_STAGES as string[]).includes(stage);
  const canMoveNext = !!NEXT_STAGE[stage];

  // Próximo agendamento — exibido em destaque se for hoje
  const proxAg = ags[0];
  const todayYmd = (() => {
    const d = new Date(); d.setHours(0, 0, 0, 0);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  })();
  const agHoje = proxAg?.data === todayYmd;

  return (
    <>
      <div style={{ flex: 1, overflow: "auto", WebkitOverflowScrolling: "touch" }}>
        <div style={{ maxWidth: 480, margin: "0 auto", padding: "20px 18px" }}>
          {/* Índice */}
          <div style={{
            display: "flex", justifyContent: "space-between", alignItems: "center",
            fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em",
            color: T.textMuted, textTransform: "uppercase", marginBottom: 18,
          }}>
            <span>CARD {String(idx + 1).padStart(2, "0")} · {String(total).padStart(2, "0")}</span>
            <span style={{ fontFamily: FONT_BODY }}>#{card.id.slice(0, 6)}</span>
          </div>

          {/* Banner AGENDAMENTO HOJE — destaque máximo */}
          {agHoje && proxAg && (
            <div style={{
              marginBottom: 14, padding: "12px 14px",
              border: `1px solid ${CHAI}`, backgroundColor: `${CHAI}22`,
              display: "flex", alignItems: "center", gap: 12,
            }}>
              <Calendar size={16} color={CHAI} />
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: CHAI, fontWeight: 700, marginBottom: 2 }}>
                  AGENDAMENTO HOJE · {proxAg.hora_inicio.slice(0, 5)}
                </div>
                <div style={{ fontFamily: FONT_BODY, fontSize: 10, color: T.textPrimary, letterSpacing: "0.04em" }}>
                  {proxAg.modalidade === "meet" ? "MEET" : "PRESENCIAL"}
                  {proxAg.endereco && proxAg.modalidade === "presencial" && ` · ${proxAg.endereco}`}
                </div>
              </div>
              {proxAg.modalidade === "meet" && proxAg.meet_link && (
                <a href={proxAg.meet_link} target="_blank" rel="noreferrer" style={{
                  padding: "6px 10px", backgroundColor: CHAI, color: T.onPrimary,
                  textDecoration: "none", fontFamily: FONT_BODY, fontSize: 8,
                  letterSpacing: "0.20em", fontWeight: 700,
                  display: "flex", alignItems: "center", gap: 5,
                }}>
                  <Video size={11} /> ABRIR
                </a>
              )}
            </div>
          )}

          {/* Etapa + Temperatura */}
          <div style={{ marginBottom: 14, display: "flex", gap: 6, flexWrap: "wrap" }}>
            <Pill borderColor={T.borderHover} bg={T.surface}>
              <div style={{ width: 4, height: 4, backgroundColor: CHAI }} />
              <span style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.20em", color: mode === "light" ? T.textPrimary : CREAM, fontWeight: 500 }}>
                {stageLabel}
              </span>
            </Pill>
            <Pill borderColor={nivelMeta.border} bg={nivelMeta.bg} title={nivelFonte === "ia" ? "Classificação IA" : "Heurística"}>
              <span style={{ color: nivelMeta.color, fontSize: 10, lineHeight: 1 }}>{nivelMeta.mark}</span>
              <span style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.20em", color: nivelMeta.color, fontWeight: 500 }}>
                {nivelMeta.label}
              </span>
              {nivelFonte === "ia" && (
                <span style={{
                  fontFamily: FONT_BODY, fontSize: 7, letterSpacing: "0.16em",
                  color: nivelMeta.color, opacity: 0.65, paddingLeft: 4, borderLeft: `1px solid ${nivelMeta.border}`,
                }}>IA</span>
              )}
            </Pill>
          </div>

          {/* Nome */}
          <div style={{ marginBottom: 6 }}>
            <div style={{ fontFamily: FONT_DISPLAY, fontSize: 22, letterSpacing: "0.04em", color: T.textPrimary, fontWeight: 500, lineHeight: 1.15 }}>
              {nome}
            </div>
            {empresa && (
              <div style={{ fontFamily: FONT_BODY, fontSize: 10, letterSpacing: "0.10em", color: T.textSecondary, marginTop: 4, textTransform: "uppercase" }}>
                {empresa}
              </div>
            )}
          </div>

          {/* Tags */}
          {(card.tags?.length ?? 0) > 0 && (
            <div style={{ display: "flex", flexWrap: "wrap", gap: 5, marginTop: 12, marginBottom: 4 }}>
              {card.tags!.map((t, i) => {
                const isHot = /quente|hot|urgent/i.test(t);
                return (
                  <span key={i} style={{
                    fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.12em",
                    color: isHot ? (mode === "light" ? WALNUT : CREAM) : T.textMuted,
                    backgroundColor: isHot ? `${WALNUT}40` : `${CREAM}18`,
                    border: `1px solid ${isHot ? WALNUT : CREAM}50`,
                    padding: "3px 8px", textTransform: "uppercase",
                  }}>
                    {isHot && "▲ "}{t}
                  </span>
                );
              })}
            </div>
          )}

          {/* COPILOTO IA — resumo do lead via Claude */}
          <CopilotoSection card={card} onUpdated={props.onCardDetailsUpdated} />

          {/* RESUMO DO PROJETO */}
          <SectionHeader label="RESUMO DO PROJETO" />
          <div>
            {produto && <InfoRow label="PRODUTO" value={produto} icon={<Briefcase size={9} />} />}
            {metragem && <InfoRow label="METRAGEM" value={`${metragem} m²`} icon={<Ruler size={9} />} />}
            {(cidade || estado) && <InfoRow label="LOCAL" value={`${cidade}${estado ? " — " + estado : ""}`} icon={<MapPin size={9} />} />}
            {relacao && <InfoRow label="RELAÇÃO C/ OBRA" value={relacao} />}
            {prazo && <InfoRow label="PRAZO" value={prazo} />}
            {madeira && <InfoRow label="PREF. MADEIRA" value={madeira} />}
            {arquitetura && <InfoRow label="ARQUITETURA" value={arquitetura} />}
            {escritorio && <InfoRow label="ESCRITÓRIO" value={escritorio} />}
            {endereco && <InfoRow label="ENDEREÇO OBRA" value={endereco} multiline />}
          </div>

          {/* COMERCIAL */}
          {(valor > 0 || faixa || phoneIntl) && (
            <>
              <SectionHeader label="COMERCIAL" />
              <div>
                {valor > 0 && <InfoRow label="VALOR NA MESA" value={fmtBRL(valor)} accent />}
                {!valor && faixa && <InfoRow label="FAIXA INVESTIMENTO" value={faixa} accent />}
                {valor > 0 && faixa && faixa !== fmtBRL(valor) && <InfoRow label="FAIXA INFORMADA" value={faixa} />}
                {phoneIntl && <InfoRow label="TELEFONE" value={`+${phoneIntl}`} mono icon={<Phone size={9} />} />}
              </div>
            </>
          )}

          {/* AGENDA — todos os agendamentos do vendedor pra esse card */}
          {ags.length > 0 && (
            <>
              <SectionHeader label={`AGENDA · ${String(ags.length).padStart(2, "0")}`} />
              <div>
                {ags.slice(0, 6).map((a) => {
                  const isHoje = a.data === todayYmd;
                  const dataFmt = formatDataAg(a.data);
                  return (
                    <div key={a.id} style={{
                      display: "flex", gap: 10, padding: "11px 0", borderBottom: `1px solid ${T.border}`,
                      alignItems: "center",
                    }}>
                      <div style={{ width: 36, textAlign: "center", flexShrink: 0 }}>
                        <div style={{ fontFamily: FONT_DISPLAY, fontSize: 14, color: isHoje ? CHAI : T.textPrimary, lineHeight: 1, fontWeight: 500 }}>
                          {dataFmt.dia}
                        </div>
                        <div style={{ fontFamily: FONT_BODY, fontSize: 7, letterSpacing: "0.18em", color: T.textMuted, marginTop: 2, textTransform: "uppercase" }}>
                          {dataFmt.mes}
                        </div>
                      </div>
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div style={{ fontFamily: FONT_BODY, fontSize: 10, color: T.textPrimary, letterSpacing: "0.04em" }}>
                          {a.hora_inicio.slice(0, 5)}{a.hora_fim ? ` · ${a.hora_fim.slice(0, 5)}` : ""}
                          {isHoje && <span style={{ marginLeft: 8, padding: "1px 5px", fontSize: 7, letterSpacing: "0.16em", color: T.onPrimary, backgroundColor: CHAI }}>HOJE</span>}
                        </div>
                        <div style={{ fontFamily: FONT_BODY, fontSize: 9, color: T.textSecondary, letterSpacing: "0.06em", marginTop: 2, textTransform: "uppercase" }}>
                          {a.modalidade === "meet" ? "MEET" : "PRESENCIAL"}
                          {a.cliente_nome && a.cliente_nome !== nome && ` · ${a.cliente_nome}`}
                        </div>
                      </div>
                      {a.modalidade === "meet" && a.meet_link && (
                        <a href={a.meet_link} target="_blank" rel="noreferrer" style={{
                          padding: "4px 8px", border: `1px solid ${CHAI}80`, color: CHAI,
                          fontFamily: FONT_BODY, fontSize: 7, letterSpacing: "0.20em", fontWeight: 600,
                          textDecoration: "none", display: "flex", alignItems: "center", gap: 4,
                        }}>
                          <Video size={9} /> ABRIR
                        </a>
                      )}
                    </div>
                  );
                })}
              </div>
            </>
          )}

          {/* Qualificação */}
          {resumo && (
            <>
              <SectionHeader label="QUALIFICAÇÃO DO LEAD" />
              <TextBlock>{String(resumo).slice(0, 700)}</TextBlock>
            </>
          )}

          {/* Overview IA */}
          {overviewIA && overviewIA !== resumo && (
            <>
              <SectionHeader label="ANÁLISE IA" />
              <TextBlock>{String(overviewIA).slice(0, 700)}</TextBlock>
            </>
          )}

          {/* Última atividade */}
          {ultima && (
            <div style={{
              marginTop: 18, display: "flex", alignItems: "center", gap: 6,
              fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.10em",
              color: T.textMuted, textTransform: "uppercase",
            }}>
              <CalendarClock size={10} />
              <span>
                {det.cadencia_ultima_at ? "ÚLTIMA CADÊNCIA" : "ATUALIZADO"} · {fmtRelative(ultima).toUpperCase()}
                {det.cadencia_ultima_por && ` · ${String(det.cadencia_ultima_por).toUpperCase()}`}
              </span>
            </div>
          )}

          {/* Link card completo */}
          <Link to={`/card/${card.id}`} target="_blank" style={{
            display: "inline-flex", alignItems: "center", gap: 6, marginTop: 22,
            fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.20em",
            color: CHAI, textDecoration: "none", textTransform: "uppercase",
            paddingBottom: 4, borderBottom: `1px solid ${CHAI}50`,
          }}>
            ABRIR CARD COMPLETO <ExternalLink size={9} />
          </Link>

          <div style={{ height: 240 }} />
        </div>
      </div>

      {/* Form de observação — abre antes de executar a ação */}
      {props.pendingAction && (
        <ObsForm
          action={props.pendingAction}
          busy={busy}
          onCancel={() => props.setPendingAction(null)}
        />
      )}

      {/* Menu mover — escolha de etapa, depois entra no ObsForm */}
      {props.showMoveMenu && !props.pendingAction && (
        <div style={{
          borderTop: `1px solid ${T.borderHover}`, backgroundColor: T.surface,
          padding: "14px 18px", flexShrink: 0, maxHeight: "60vh", overflowY: "auto",
        }}>
          <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted, marginBottom: 10 }}>
            MOVER PARA
          </div>
          {ACTIVE_STAGES.filter((s) => s !== stage).map((s) => (
            <StageOption key={s} label={STAGE_LABEL[s]} onClick={() => {
              props.setShowMoveMenu(false);
              props.setPendingAction({
                kind: "move",
                label: `MOVER PARA · ${STAGE_LABEL[s].toUpperCase()}`,
                hint: "Por que está movendo? (opcional)",
                variant: "primary",
                exec: async (obs) => { await props.onMoveTo(s, obs); },
              });
            }} disabled={busy} />
          ))}
          <StageOption label="✓ GANHO" onClick={() => {
            props.setShowMoveMenu(false);
            props.setPendingAction({
              kind: "win",
              label: "MARCAR COMO GANHO",
              hint: "Conta como fechou (opcional)",
              variant: "primary",
              exec: async (obs) => { await props.onMoveTo("ganho", obs); },
            });
          }} disabled={busy} variant="positive" />
          <button onClick={() => props.setShowMoveMenu(false)} style={{
            width: "100%", marginTop: 10, padding: "8px 0", background: "none", border: "none",
            cursor: "pointer", fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.18em",
            color: T.textMuted, textTransform: "uppercase",
          }}>CANCELAR</button>
        </div>
      )}

      {/* Botões rodapé */}
      {!props.showMoveMenu && !props.pendingAction && (
        <div style={{
          borderTop: `1px solid ${T.border}`, backgroundColor: T.bg, flexShrink: 0,
          paddingBottom: "env(safe-area-inset-bottom)",
        }}>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 1, padding: "12px 12px 6px" }}>
            <ContactButton href={phoneIntl ? `tel:+${phoneIntl}` : undefined} icon={<Phone size={14} />} label="LIGAR" />
            <ContactButton href={phoneIntl ? `https://wa.me/${phoneIntl}` : undefined} target="_blank" icon={<MessageCircle size={14} />} label="WHATSAPP" />
          </div>

          {isNova ? (
            <div style={{ padding: "0 12px 6px" }}>
              <BigButton onClick={() => props.setPendingAction({
                kind: "match", label: NEXT_LABEL[stage],
                hint: "Por que é uma oportunidade? (opcional)",
                variant: "primary",
                exec: async (obs) => { await props.onMatchHot(obs); },
              })} disabled={busy} variant="primary" icon={<Flame size={13} />}>
                {NEXT_LABEL[stage]}
              </BigButton>
            </div>
          ) : isCadencia ? (
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 6, padding: "0 12px 6px" }}>
              <BigButton onClick={() => props.setPendingAction({
                kind: "cadencia", label: "CADÊNCIA FEITA",
                hint: "Resumo do contato de hoje (opcional)",
                variant: "primary",
                exec: async (obs) => { await props.onMarkCadencia(obs); },
              })} disabled={busy} variant="primary" icon={<Check size={13} />}>CADÊNCIA FEITA</BigButton>
              <BigButton onClick={() => props.setPendingAction({
                kind: canMoveNext && NEXT_STAGE[stage] === "ganho" ? "win" : "move",
                label: NEXT_LABEL[stage],
                hint: canMoveNext && NEXT_STAGE[stage] === "ganho" ? "Conta como fechou (opcional)" : "Por que está avançando? (opcional)",
                variant: "primary",
                exec: async (obs) => { await props.onMoveTo(NEXT_STAGE[stage] as string, obs); },
              })} disabled={busy || !canMoveNext} variant="ghost">{NEXT_LABEL[stage]}</BigButton>
            </div>
          ) : canMoveNext ? (
            <div style={{ padding: "0 12px 6px" }}>
              <BigButton onClick={() => props.setPendingAction({
                kind: NEXT_STAGE[stage] === "ganho" ? "win" : "move",
                label: NEXT_LABEL[stage],
                hint: NEXT_STAGE[stage] === "ganho" ? "Conta como fechou (opcional)" : "Por que está avançando? (opcional)",
                variant: "primary",
                exec: async (obs) => { await props.onMoveTo(NEXT_STAGE[stage] as string, obs); },
              })} disabled={busy} variant="primary" icon={<ArrowRight size={13} />}>
                {NEXT_LABEL[stage]}
              </BigButton>
            </div>
          ) : null}

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 6, padding: "0 12px 10px" }}>
            <BigButton onClick={() => props.setShowMoveMenu(true)} disabled={busy} variant="ghost" small icon={<ChevronDown size={11} />}>MOVER</BigButton>
            <BigButton onClick={props.onSkip} disabled={busy} variant="ghost" small icon={<ArrowRight size={11} />}>PRÓXIMO</BigButton>
            <BigButton onClick={() => props.setPendingAction({
              kind: "lost", label: "MOTIVO DA PERDA",
              hint: "Sem orçamento · escolheu concorrente · projeto cancelado",
              variant: "walnut",
              exec: async (obs) => { await props.onMarkLost(obs); },
            })} disabled={busy} variant="walnut-ghost" small icon={<XCircle size={11} />}>PERDA</BigButton>
          </div>

          <div style={{
            display: "flex", justifyContent: "space-between", alignItems: "center",
            padding: "8px 18px", borderTop: `1px solid ${T.border}`,
            fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.18em",
            color: T.textMuted, textTransform: "uppercase",
          }}>
            <button onClick={props.onPrev} disabled={idx === 0} style={navBtnStyle(T, idx === 0)}>
              <ArrowLeft size={10} /> ANTERIOR
            </button>
            <span>{String(idx + 1).padStart(2, "0")} / {String(total).padStart(2, "0")}</span>
            <button onClick={props.onNext} disabled={idx >= total - 1} style={navBtnStyle(T, idx >= total - 1)}>
              PRÓXIMO <ArrowRight size={10} />
            </button>
          </div>
        </div>
      )}
    </>
  );
}

function navBtnStyle(T: Theme, disabled: boolean): React.CSSProperties {
  return {
    background: "none", border: "none", cursor: disabled ? "default" : "pointer",
    color: disabled ? T.textMuted : T.textSecondary, opacity: disabled ? 0.4 : 1,
    fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.18em",
    display: "flex", alignItems: "center", gap: 6, textTransform: "uppercase",
  };
}

// ─── /tracking/admin — gestor ──────────────────────────────────────────
type AdminTab = "cards" | "tarefas";

function TrackingAdminInner({ appUser }: { appUser: AppUser }) {
  const { T } = useTheme();
  const nav = useNavigate();
  const isAdmin = appUser.isGestor || appUser.canSeeAll;
  const [tab, setTab] = useState<AdminTab>("cards");
  const [cards, setCards] = useState<TrackingCard[]>([]);
  const [vendedores, setVendedores] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState<string | null>(null);
  const [filterVendedor, setFilterVendedor] = useState<string>("__all__");
  const [filterStage, setFilterStage] = useState<string>("__all__");
  const [selected, setSelected] = useState<Set<string>>(new Set());
  const [bulkAssignTo, setBulkAssignTo] = useState<string>("");
  const [busy, setBusy] = useState(false);

  const reload = async () => {
    setLoading(true);
    const r = await supabase
      .from("kanban_cards")
      .select("id, title, responsavel, column_id, dept_id, value, tags, created_at, updated_at, details")
      .eq("dept_id", DEPT)
      .in("column_id", ACTIVE_STAGES as unknown as string[])
      .order("updated_at", { ascending: false })
      .limit(2000);
    if (r.error) { setErr(r.error.message); setCards([]); }
    else {
      const data = (r.data as TrackingCard[]) || [];
      setCards(data);
      const set = new Set<string>();
      data.forEach((c) => { if (c.responsavel) set.add(c.responsavel); });
      setVendedores([...set].sort());
      setErr(null);
    }
    setLoading(false);
  };

  useEffect(() => { if (isAdmin) reload(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [isAdmin]);

  const filtered = useMemo(() => cards.filter((c) => {
    if (filterVendedor === "__unassigned__" && c.responsavel) return false;
    if (filterVendedor !== "__all__" && filterVendedor !== "__unassigned__" && c.responsavel !== filterVendedor) return false;
    if (filterStage !== "__all__" && c.column_id !== filterStage) return false;
    return true;
  }), [cards, filterVendedor, filterStage]);

  const assignOne = async (cardId: string, to: string) => {
    setBusy(true);
    try {
      const r = await supabase.from("kanban_cards").update({ responsavel: to || null }).eq("id", cardId);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      setCards((prev) => prev.map((c) => c.id === cardId ? { ...c, responsavel: to || null } : c));
    } finally { setBusy(false); }
  };

  const assignBulk = async () => {
    if (!bulkAssignTo || selected.size === 0) return;
    if (!confirm(`Atribuir ${selected.size} cards a ${bulkAssignTo}?`)) return;
    setBusy(true);
    try {
      const ids = [...selected];
      const r = await supabase.from("kanban_cards").update({ responsavel: bulkAssignTo }).in("id", ids);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      setCards((prev) => prev.map((c) => ids.includes(c.id) ? { ...c, responsavel: bulkAssignTo } : c));
      setSelected(new Set());
    } finally { setBusy(false); }
  };

  if (!isAdmin) {
    return (
      <Boot icon={<ShieldCheck size={26} color={WALNUT} />} label="ACESSO RESTRITO"
        sub="Apenas gestores podem acessar o admin." actionLabel="VOLTAR" onAction={() => nav("/tracking")} />
    );
  }
  if (loading) return <Boot label="Carregando" />;
  if (err) return <Boot label={err} variant="error" />;

  const counts: Record<string, number> = {};
  cards.forEach((c) => {
    const k = c.responsavel || "__sem__";
    counts[k] = (counts[k] || 0) + 1;
  });

  return (
    <div style={{
      position: "fixed", inset: 0, backgroundColor: T.bg, color: T.textPrimary,
      fontFamily: FONT_BODY, display: "flex", flexDirection: "column",
      overscrollBehavior: "contain", transition: "background 0.35s, color 0.35s",
    }}>
      <PageHeader title="TRACKING · ADMIN" sub={`${String(cards.length).padStart(2, "0")} CARDS · ${vendedores.length} VENDEDORES`}
        right={
          <>
            <ThemeToggle />
            <IconButton onClick={reload} title="Recarregar"><RefreshCw size={11} /></IconButton>
            <LinkButton to="/tracking" muted>VOLTAR</LinkButton>
          </>
        }
        extra={
          <>
            {/* Tabs Cards | Tarefas */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 4, marginBottom: 8 }}>
              <AgendaTab active={tab === "cards"} onClick={() => setTab("cards")}>CARDS · {cards.length}</AgendaTab>
              <AgendaTab active={tab === "tarefas"} onClick={() => setTab("tarefas")}>TAREFAS</AgendaTab>
            </div>
            {tab === "cards" && (
              <>
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 6 }}>
                  <NativeSelect value={filterVendedor} onChange={setFilterVendedor}>
                    <option value="__all__">TODOS · {cards.length}</option>
                    <option value="__unassigned__">SEM RESPONSÁVEL · {counts["__sem__"] || 0}</option>
                    {vendedores.map((v) => <option key={v} value={v}>{v.toUpperCase()} · {counts[v] || 0}</option>)}
                  </NativeSelect>
                  <NativeSelect value={filterStage} onChange={setFilterStage}>
                    <option value="__all__">TODAS AS ETAPAS</option>
                    {ACTIVE_STAGES.map((s) => <option key={s} value={s}>{STAGE_LABEL[s].toUpperCase()}</option>)}
                  </NativeSelect>
                </div>
                {selected.size > 0 && (
                  <div style={{
                    marginTop: 8, padding: "10px 12px",
                    border: `1px solid ${T.borderHover}`, backgroundColor: T.surface,
