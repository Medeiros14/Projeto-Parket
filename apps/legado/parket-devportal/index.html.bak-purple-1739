<body>
<div id="app"></div>
<script>
const API='/api',
APPS={dashboardparket:{nome:'Dashboard Parket',icon:'📊'},
'parket-draw':{nome:'Draw / WoodPlanner',icon:'✏️'},
'parket-ai-squad':{nome:'AI Squad',icon:'🤖'},
'parket-skills':{nome:'Parket Skills',icon:'📚'}},
SETORES=['comercial','projetos','compras','producao','logistica','obras','financeiro','fiscal','pmo','orcamento','marketing','rh','ia','atendimento'];

let me=null,devs=[],curApp='dashboardparket',curSetor='',tab='terminal',showAddDev=false,newDev={},showResetSenha=null;
let ws=null,sessionId=null,connected=false,mode='claude',processing=false;
let authToken=null,loginError='',loginStep='credentials',pendingEmail='',pendingName='';
// Pipeline: 1=code, 2=preview, 3=deploy
let pipeStep=1;

function connectWS(){
  if(ws && ws.readyState<=1) return;
  sessionId=crypto.randomUUID();
  const proto=location.protocol==='https:'?'wss:':'ws:';
  ws=new WebSocket(proto+'//'+location.host+'/ws/terminal/'+sessionId);
  ws.onopen=()=>{connected=true;addLine('system','Conectado ao Parket Code Terminal','accent');addLine('system','Pipeline: Editar Codigo → Build Preview → Deploy Producao','dim');addLine('system','','dim');updateConn()};
  ws.onclose=()=>{connected=false;updateConn();setTimeout(connectWS,3000)};
  ws.onerror=()=>{connected=false;updateConn()};
  ws.onmessage=(e)=>{
    try{
      const d=JSON.parse(e.data);
      handleWsMessage(d);
    }catch(err){addLine('raw',e.data,'dim')}
  };
}

function handleWsMessage(d){
  const t=d.type;
  if(t==='line') addLine('line',d.text,d.style||'text');
  else if(t==='tool'){ updateOrbit('Executando: '+(d.tool||'ferramenta')); addTool(d.tool,d.input); }
  else if(t==='result') addResult(d.text);
  else if(t==='status'){ updateOrbit(d.text); /* o orbit é o ÚNICO indicador de processamento — não acumular spinners no log */ }
  else if(t==='done'){
    hideOrbit();
    purgeStuckProcessing();
    addStatus(d.text,'done');
    processing=false;
    updateInput();
  }
  else if(t==='error'){
    hideOrbit();
    purgeStuckProcessing();
    addLine('line',d.text,'error');
    processing=false;
    updateInput();
  }
  else if(t==='offer_preview'){
    hideOrbit();
    purgeStuckProcessing();
    pipeStep=2;
    updatePipeline();
    addPreviewButtons();
  }
  else if(t==='offer_deploy'){
    hideOrbit();
    purgeStuckProcessing();
    pipeStep=3;
    updatePipeline();
    addDeployButtons();
  }
  scrollTerminal();
}

/* ── Neon Orb renderer (Canvas 2D, partículas Fibonacci na esfera) ── */
const neonOrb=(function(){
  let canvas=null,ctx=null,particles=[],t=0,rot=0,running=false,raf=null,resizeHooked=false;
  const N=1400;

  function init(){
    particles=[];
    for(let i=0;i<N;i++){
      // Distribuição Fibonacci na esfera unitária — cobertura uniforme
      const phi=Math.acos(1-2*(i+0.5)/N);
      const theta=Math.PI*(1+Math.sqrt(5))*i;
      const sx=Math.sin(phi)*Math.cos(theta);
      const sy=Math.sin(phi)*Math.sin(theta);
      const sz=Math.cos(phi);
      const jitter=0.965+Math.random()*0.07;
      particles.push({
        x:sx*jitter,y:sy*jitter,z:sz*jitter,
        size:0.8+Math.random()*1.3,
        phase:Math.random()*Math.PI*2,
      });
    }
  }

  function resize(){
    if(!canvas||!ctx) return;
    const rect=canvas.getBoundingClientRect();
    const dpr=Math.min(window.devicePixelRatio||1,2);
    canvas.width=Math.max(1,Math.floor(rect.width*dpr));
    canvas.height=Math.max(1,Math.floor(rect.height*dpr));
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  function colorForPos(x,y,z){
    // 4-way blend baseado na posição na esfera (gira com a rotação pra parecer tex fixa)
    // Cyan (topo-esq), Roxo (topo-dir), Magenta (baixo-dir), Azul (baixo-esq)
    const top=Math.max(0,-y),bot=Math.max(0,y);
    const right=Math.max(0,x),left=Math.max(0,-x);
    const wC=Math.pow(top,0.8)*Math.pow(left,0.65);
    const wP=Math.pow(top,0.8)*Math.pow(right,0.65);
    const wM=Math.pow(bot,0.8)*Math.pow(right,0.65);
    const wB=Math.pow(bot,0.8)*Math.pow(left,0.65);
    const base=0.12;
    const s=wC+wP+wM+wB+base*4;
    // RGB das 4 cores + base neutra indigo
    const r=(wC*34 +wP*168+wM*236+wB*59 +base*4*90)/s;
    const g=(wC*211+wP*85 +wM*72 +wB*130+base*4*70)/s;
    const b=(wC*238+wP*247+wM*153+wB*246+base*4*220)/s;
    return [r|0,g|0,b|0];
  }

  function render(){
    if(!running||!canvas||!canvas.isConnected){running=false;return;}
    const rect=canvas.getBoundingClientRect();
    const W=rect.width,H=rect.height;
    if(W<2||H<2){raf=requestAnimationFrame(render);return;}
    const cx=W/2,cy=H/2;
    // R conservador: rim glow (R*1.25*pulse*~1.04) cabe dentro do canvas
    // min(W,H)/2 com folga; nunca maior que 45% da menor dimensão.
    const R=Math.min(W,H)*0.33;

    t+=0.012;rot+=0.0035;
    const pulse=1+Math.sin(t*0.9)*0.035;
    const wobble=Math.sin(t*0.55)*0.11;

    ctx.clearRect(0,0,W,H);

    // Halo atmosférico interno
    const halo=ctx.createRadialGradient(cx,cy,R*0.55,cx,cy,R*1.45);
    halo.addColorStop(0,'rgba(22,12,44,0.55)');
    halo.addColorStop(0.55,'rgba(22,12,44,0.2)');
    halo.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=halo;
    ctx.beginPath();ctx.arc(cx,cy,R*1.5,0,Math.PI*2);ctx.fill();

    const cosR=Math.cos(rot),sinR=Math.sin(rot);
    const cosW=Math.cos(wobble),sinW=Math.sin(wobble);

    ctx.globalCompositeOperation='lighter';
    for(let i=0;i<particles.length;i++){
      const p=particles[i];
      // Rotação em Y
      const rx=p.x*cosR+p.z*sinR;
      const rz1=-p.x*sinR+p.z*cosR;
      // Wobble em X
      const ry=p.y*cosW-rz1*sinW;
      const rz=p.y*sinW+rz1*cosW;

      const persp=1+rz*0.08;
      const sx=cx+rx*R*pulse*persp;
      const sy=cy+ry*R*pulse*persp;

      const depth=(rz+1)/2;          // 0 fundo → 1 frente
      const rim=1-Math.abs(rz);      // 1 na borda, 0 nos polos
      const shimmer=0.78+0.22*Math.sin(t*2+p.phase);

      const col=colorForPos(rx,ry,rz);
      const alpha=(depth*0.32+rim*0.68)*shimmer;
      const sz=p.size*(0.55+depth*0.85+rim*0.35);

      ctx.fillStyle='rgba('+col[0]+','+col[1]+','+col[2]+','+alpha.toFixed(3)+')';
      ctx.beginPath();ctx.arc(sx,sy,sz,0,Math.PI*2);ctx.fill();
    }

    // Rim glow externo: anel colorido suave ao redor da esfera
    // R*1.25*pulse (~1.04) = R*1.30 máx → cabe em min(W,H)/2 = R/0.33 = 1.52R
    const rimGrad=ctx.createRadialGradient(cx,cy,R*0.97,cx,cy,R*1.28);
    rimGrad.addColorStop(0,'rgba(168,85,247,0)');
    rimGrad.addColorStop(0.18,'rgba(168,85,247,0.28)');
    rimGrad.addColorStop(0.45,'rgba(34,211,238,0.17)');
    rimGrad.addColorStop(0.75,'rgba(236,72,153,0.12)');
    rimGrad.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=rimGrad;
    ctx.beginPath();ctx.arc(cx,cy,R*1.28*pulse,0,Math.PI*2);ctx.fill();

    ctx.globalCompositeOperation='source-over';

    raf=requestAnimationFrame(render);
  }

  return {
    attach(cvs){
      canvas=cvs;
      ctx=cvs.getContext('2d',{alpha:true});
      init();
      resize();
      if(!resizeHooked){window.addEventListener('resize',resize);resizeHooked=true;}
      return this;
    },
    start(){
      if(running) return this;
      running=true;t=0;rot=0;
      render();
      return this;
    },
    stop(){
      running=false;
      if(raf) cancelAnimationFrame(raf);
      raf=null;
    }
  };
})();

/* ── Orbit loader controls ── */
function showOrbit(label){
  const wrap=document.getElementById('terminal-wrap');
  if(!wrap) return;
  wrap.classList.add('processing');
  let o=document.getElementById('orbit-overlay');
  if(o){ updateOrbit(label); return; }
  o=document.createElement('div');
  o.id='orbit-overlay';
  o.className='orbit-overlay';
  o.innerHTML=`
    <div class="orbit-stage">
      <canvas class="orbit-canvas" id="orbit-canvas"></canvas>
    </div>
    <div class="orbit-label" id="orbit-label">${escHtml(label||'Processando')}</div>
    <div class="orbit-substatus"><span class="dot"></span> Parket Code · IA em conversa</div>
  `;
  wrap.appendChild(o);
  const cvs=document.getElementById('orbit-canvas');
  if(cvs) neonOrb.attach(cvs).start();
}
function updateOrbit(label){
  const o=document.getElementById('orbit-overlay');
  if(!o){ showOrbit(label); return; }
  const el=document.getElementById('orbit-label');
  if(el){
    el.textContent=label||'Processando';
    el.style.animation='none';
    void el.offsetWidth;
    el.style.animation='';
  }
}
function hideOrbit(){
  const wrap=document.getElementById('terminal-wrap');
  if(wrap) wrap.classList.remove('processing');
  const o=document.getElementById('orbit-overlay');
  if(!o) return;
  o.classList.add('fading');
  neonOrb.stop();
  setTimeout(()=>{ if(o.parentNode) o.parentNode.removeChild(o); },500);
}

function addLine(kind,text,style){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-line '+(style||'');
  div.textContent=text;
  term.appendChild(div);
}

function addTool(name,input){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-tool';
  let inputStr='';
  if(input){
    if(typeof input==='string') inputStr=input;
    else{try{const s=JSON.stringify(input,null,0);inputStr=s.length>200?s.substring(0,200)+'...':s}catch(e){inputStr=String(input)}}
  }
  div.innerHTML='<div class="tool-name">🔧 '+escHtml(name)+'</div>'+(inputStr?'<div class="tool-input">'+escHtml(inputStr)+'</div>':'');
  term.appendChild(div);
}

function addResult(text){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-result';
  div.textContent=text;
  term.appendChild(div);
}

function addStatus(text,type){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-status '+type;
  div.innerHTML=(type==='processing'?'<div class="spinner"></div>':type==='done'?'✅':'❌')+' '+escHtml(text);
  term.appendChild(div);
}

/** Remove qualquer t-status.processing órfão do terminal — chamado em done/error/offer_*
 * para garantir que nenhum spinner fique girando depois de a operação terminar.
 * Defesa extra além de já ter parado de criar esses elementos no handleWsMessage. */
function purgeStuckProcessing(){
  document.querySelectorAll('#terminal .t-status.processing').forEach(el=>el.remove());
}

function addSeparator(){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-line separator';
  term.appendChild(div);
}

function addPreviewButtons(){
  const term=document.getElementById('terminal');
  if(!term)return;
  const div=document.createElement('div');
  div.className='t-actions';
  div.id='action-buttons';
  div.innerHTML=`
    <button class="abtn preview" onclick="doPreview()">🔨 Build Preview</button>
    <button class="abtn cancel" onclick="skipPreview()">Pular (sem preview)</button>
  `;
  term.appendChild(div);
}

function addDeployButtons(){
  const term=document.getElementById('terminal');
  if(!term)return;
  const isAdmin=me&&(me.role==='superadmin'||me.role==='admin');
  const div=document.createElement('div');
  div.className='t-actions';
  div.id='action-buttons';
  div.innerHTML=`
    <button class="abtn deploy" ${isAdmin?'':'disabled title="Apenas admin pode deployar"'} onclick="doDeploy()">🚀 Deploy Producao</button>
    <button class="abtn cancel" onclick="skipDeploy()">Cancelar</button>
  `;
  term.appendChild(div);
}

function removeActionButtons(){
  const el=document.getElementById('action-buttons');
  if(el) el.remove();
}

function doPreview(){
  removeActionButtons();
  if(!ws||ws.readyState!==1)return;
  processing=true;
  updateInput();
  showOrbit('Construindo preview');
  ws.send(JSON.stringify({action:'preview',app:curApp,dev_email:me.dev_email}));
}

function skipPreview(){
  removeActionButtons();
  addLine('line','Preview pulado.','dim');
  pipeStep=1;
  updatePipeline();
}

function doDeploy(){
  removeActionButtons();
  if(!ws||ws.readyState!==1)return;
  processing=true;
  updateInput();
  showOrbit('Fazendo deploy em produção');
  ws.send(JSON.stringify({action:'deploy',app:curApp,dev_email:me.dev_email,role:me.role}));
}

function skipDeploy(){
  removeActionButtons();
  addLine('line','Deploy cancelado. A imagem staging permanece disponivel para deploy futuro.','dim');
  pipeStep=1;
  updatePipeline();
}

function scrollTerminal(){
  const term=document.getElementById('terminal');
  if(term) requestAnimationFrame(()=>term.scrollTop=term.scrollHeight);
}

function updateConn(){
  const el=document.getElementById('conn-dot');
  if(el) el.className='conn-dot '+(connected?'on':'off');
  const label=document.getElementById('conn-label');
  if(label) label.textContent=connected?'Conectado':'Desconectado';
}

function updateInput(){
  const btn=document.getElementById('send-btn');
  const inp=document.getElementById('cmd-input');
  if(btn) btn.disabled=processing;
  if(inp) inp.disabled=processing;
}

function updatePipeline(){
  [1,2,3].forEach(i=>{
    const el=document.getElementById('pipe-'+i);
    if(!el)return;
    el.className='pipe-step'+(pipeStep===i?' active':'')+(pipeStep>i?' done':'');
  });
}

function sendMessage(){
  const inp=document.getElementById('cmd-input');
  if(!inp||!inp.value.trim()||!ws||ws.readyState!==1||processing)return;
  const text=inp.value.trim();
  inp.value='';

  addSeparator();
  pipeStep=1;
  updatePipeline();

  if(mode==='claude'){
    addLine('line','👤 '+me.dev_name+' → '+APPS[curApp].nome+(curSetor?' / '+curSetor:''),'user-msg');
    addLine('line',text,'user-msg');
    ws.send(JSON.stringify({action:'message',dev_email:me.dev_email,app:curApp,setor:curSetor,content:text}));
    processing=true;
    showOrbit('Analisando solicitação');
  } else {
    addLine('line','$ '+text,'cmd');
    ws.send(JSON.stringify({action:'command',app:curApp,cmd:text}));
    processing=true;
    showOrbit('Executando comando shell');
  }
  updateInput();
  scrollTerminal();
}

function clearTerminal(){
  const term=document.getElementById('terminal');
  if(term) term.innerHTML='';
  pipeStep=1;updatePipeline();
  addLine('system','Terminal limpo. '+APPS[curApp].nome+(curSetor?' / '+curSetor:''),'dim');
}

function escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}

// ── API ──
async function login(email,senha){
  loginError='';
  if(!email||!senha){loginError='Preencha email e senha';R();return}
  try{
    const r=await fetch(API+'/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,senha})});
    const d=await r.json();
    if(d.error){loginError=d.error;R();return}
    if(d.step==='2fa'){
      // Senha OK, agora precisa do código 2FA
      loginStep='2fa';pendingEmail=email;pendingName=d.dev_name||'';loginError='';
      R();return;
    }
    // Login direto (fallback)
    finishLogin(d);
  }catch(e){loginError='Erro de conexão';R()}
}

async function verify2fa(code){
  loginError='';
  if(!code||code.length!==6){loginError='Digite o código de 6 dígitos';R();return}
  try{
    const r=await fetch(API+'/verify-2fa',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:pendingEmail,code})});
    const d=await r.json();
    if(d.error){loginError=d.error;R();return}
    finishLogin(d);
  }catch(e){loginError='Erro de conexão';R()}
}

function finishLogin(d){
  me=d;authToken=d.token;
  localStorage.setItem('dev-token',authToken);
  localStorage.setItem('dev-email',d.dev_email);
  loginStep='credentials';pendingEmail='';loginError='';
  connectWS();
  if(me.role==='superadmin'||me.role==='admin') fetch(API+'/devs').then(r=>r.json()).then(d=>{devs=d;R()});
  R();
}

async function checkSession(){
  const token=localStorage.getItem('dev-token');
  const email=localStorage.getItem('dev-email');
  if(!token||!email)return false;
  const r=await fetch(API+'/me?token='+token+'&email='+email);
  const d=await r.json();
  if(d.error){localStorage.removeItem('dev-token');localStorage.removeItem('dev-email');return false}
  me=d;authToken=token;
  connectWS();
  if(me.role==='superadmin'||me.role==='admin') devs=await(await fetch(API+'/devs')).json();
  return true;
}

async function addDev(){
  if(!newDev.dev_name||!newDev.dev_email||!newDev.senha){alert('Nome, email e senha obrigatórios');return}
  if(newDev.senha.length<6){alert('Senha mínimo 6 caracteres');return}
  try{
    const res=await fetch(API+'/devs',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({dev_name:newDev.dev_name,dev_email:newDev.dev_email,senha:newDev.senha,
        telefone:newDev.telefone||null,role:newDev.role||'dev',
        apps_permitidos:newDev.apps||[],setores_permitidos:newDev.setores||[]})});
    if(!res.ok){const e=await res.text();alert('Erro ao criar dev: '+e);return}
    showAddDev=false;newDev={};
    devs=await(await fetch(API+'/devs')).json();R();
  }catch(e){alert('Erro de conexão: '+e.message)}
}

async function removeDev(id){
  if(!confirm('Remover dev?'))return;
  await fetch(API+'/devs/'+id,{method:'DELETE'});
  devs=await(await fetch(API+'/devs')).json();R();
}

async function resetSenha(id){
  const senha=document.getElementById('new-senha-'+id)?.value;
  if(!senha||senha.length<6){alert('Senha mínimo 6 caracteres');return}
  const r=await fetch(API+'/devs/'+id+'/reset-senha',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({senha})});
  const d=await r.json();
  if(d.ok){alert('Senha atualizada!');showResetSenha=null;R()}
  else alert(d.error||'Erro');
}

// ── Render ──
