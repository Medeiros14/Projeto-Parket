FROM parket-dashboard:golden-complete
COPY orcamento-simulador-tab-MARCFIX44.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX44.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec sed -i 's|orcamento-simulador-tab-MARCFIX43\.js|orcamento-simulador-tab-MARCFIX44.js|g' {} +
RUN sed -i "s|'/assets/orcamento-simulador-tab-MARCFIX43.js'|'/assets/orcamento-simulador-tab-MARCFIX44.js'|g" /usr/share/nginx/html/index.html
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-mf44-modal-optimistic'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
