FROM parket-dashboard:golden
# PKT-MF52 2026-06-22: restaura botao Refazer wizard (🔧) entre ✏️ e Excluir nos items
COPY orcamento-simulador-tab-MARCFIX52.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX52.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX51\.js|orcamento-simulador-tab-MARCFIX52.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf52-refazer'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
