// ─── Copiloto IA — resumo do card via agente.parket.works/api/hb-ia/analyze ──
const AGENTE_URL = "https://agente.parket.works";

type IAAnalise = {
  nivel?: string; score?: number;
  motivo?: string; proxima_acao?: string;
  feita_at?: string; feita_por?: string;
};

function CopilotoSection({ card, onUpdated }: {
  card: TrackingCard;
  onUpdated: (newDetails: any) => void;
}) {
  const { T, mode } = useTheme();
  const det = card.details || {};
  const persisted: IAAnalise | null = det.ia_analise && typeof det.ia_analise === "object" ? det.ia_analise : null;
  const [analise, setAnalise] = useState<IAAnalise | null>(persisted);
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState<string | null>(null);
  const [diasNaEtapa, setDiasNaEtapa] = useState<number | null>(null);
  const autoTriggered = useRef<string | null>(null);

  useEffect(() => {
    const p = card.details?.ia_analise;
    setAnalise(p && typeof p === "object" ? p : null);
  }, [card.id, card.details]);

  // Calcula quantos dias o card está na etapa atual via card_movements
  useEffect(() => {
    let alive = true;
    (async () => {
      const r = await supabase
        .from("card_movements")
        .select("moved_at")
        .eq("card_id", card.id)
        .eq("to_column", card.column_id)
        .order("moved_at", { ascending: false })
        .limit(1);
      if (!alive) return;
      let since: string | null = null;
      if (!r.error && r.data && r.data.length > 0) since = r.data[0].moved_at;
      else since = card.updated_at || card.created_at; // fallback
      if (since) {
        const dias = Math.max(0, Math.floor((Date.now() - new Date(since).getTime()) / 86400000));
        setDiasNaEtapa(dias);
      }
    })();
    return () => { alive = false; };
  }, [card.id, card.column_id, card.updated_at, card.created_at]);

  const analisar = async () => {
    setLoading(true); setErr(null);
    try {
      const payload = {
        card_id: card.id,
        card_title: card.title,
        slug: card.column_id,
        produto_interesse: det.produto_interesse,
        metragem: Number(det.metragem_estimada || det.area_m2 || det.metragem) || null,
        valor_mesa: parseValueText(det.valor_orcamento_enviado || card.value || "") || null,
        cidade: det.cidade,
        responsavel: card.responsavel,
        mensagens: Array.isArray(det.mensagens_ia)
          ? det.mensagens_ia.slice(-15).map((m: any) => ({
              direction: m.de === "cliente" ? "in" : "out",
              text: m.texto || "", at: m.ts,
            }))
          : [],
      };
      const r = await fetch(`${AGENTE_URL}/api/hb-ia/analyze`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}: ${(await r.text()).slice(0, 200)}`);
      const data = await r.json();
      const novo: IAAnalise = {
        nivel: data.nivel, score: data.score,
        motivo: data.motivo, proxima_acao: data.proxima_acao,
        feita_at: new Date().toISOString(), feita_por: "ia",
      };
      setAnalise(novo);
      const nextDetails = { ...(det), ia_analise: novo };
      await supabase.from("kanban_cards").update({ details: nextDetails }).eq("id", card.id);
      onUpdated(nextDetails);
    } catch (e: any) {
      setErr(e?.message || "Erro");
    } finally { setLoading(false); }
  };

  // Auto-trigger: se não tem análise persistida pra esse card, gera automaticamente
  useEffect(() => {
    if (autoTriggered.current === card.id) return;
    if (persisted) return; // já tem
    autoTriggered.current = card.id;
    analisar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [card.id]);

  const accent = mode === "light" ? WALNUT : CREAM;
  const hasAnalise = !!(analise && (analise.motivo || analise.proxima_acao));

  return (
    <>
      <SectionHeader label="COPILOTO IA" />
      <div style={{ border: `1px solid ${T.border}`, backgroundColor: T.surface, padding: "12px 14px" }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: hasAnalise || diasNaEtapa != null ? 10 : 0, gap: 8 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8, minWidth: 0 }}>
            <Bot size={12} color={CHAI} />
            <span style={{ fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.20em", color: T.textSecondary, textTransform: "uppercase", fontWeight: 600 }}>
              ANÁLISE DO LEAD
            </span>
          </div>
          <button onClick={analisar} disabled={loading} style={{
            padding: "5px 10px",
            backgroundColor: "transparent",
            border: `1px solid ${CHAI}`,
            color: CHAI,
            fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.20em", fontWeight: 600,
            textTransform: "uppercase", cursor: loading ? "wait" : "pointer",
            display: "flex", alignItems: "center", gap: 5, opacity: loading ? 0.6 : 1,
          }}>
            {loading
              ? <><Loader2 size={9} style={{ animation: "spin 1s linear infinite" }} /> ANALISANDO</>
              : <><RefreshCw size={9} /> ATUALIZAR</>}
          </button>
        </div>

        {/* Dias na etapa atual */}
        {diasNaEtapa != null && (
          <div style={{
            display: "flex", alignItems: "center", gap: 10, padding: "6px 10px", marginBottom: 10,
            border: `1px solid ${T.border}`,
            backgroundColor: diasNaEtapa > 7 ? `${WALNUT}25` : T.bg,
          }}>
            <CalendarClock size={11} color={diasNaEtapa > 7 ? WALNUT : T.textSecondary} />
            <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted, textTransform: "uppercase" }}>
              NA ETAPA ATUAL
            </div>
            <div style={{ marginLeft: "auto", fontFamily: FONT_DISPLAY, fontSize: 14, color: diasNaEtapa > 7 ? WALNUT : T.textPrimary, fontWeight: 500, letterSpacing: "0.04em" }}>
              {diasNaEtapa === 0 ? "HOJE" : `${diasNaEtapa} ${diasNaEtapa === 1 ? "DIA" : "DIAS"}`}
            </div>
          </div>
        )}

        {err && (
          <div style={{ fontFamily: FONT_BODY, fontSize: 9, color: WALNUT, marginTop: 8, letterSpacing: "0.06em" }}>
            ⚠ {err}
          </div>
        )}

        {!hasAnalise && loading && (
          <div style={{ fontFamily: FONT_BODY, fontSize: 10, color: T.textMuted, letterSpacing: "0.06em", lineHeight: 1.6, marginTop: 8, display: "flex", alignItems: "center", gap: 8 }}>
            <Loader2 size={11} style={{ animation: "spin 1s linear infinite", color: CHAI }} />
            Analisando lead...
          </div>
        )}

        {hasAnalise && (
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {(analise!.nivel || analise!.score != null) && (
              <div style={{ display: "flex", gap: 14, alignItems: "center", paddingBottom: 8, borderBottom: `1px solid ${T.border}` }}>
                {analise!.nivel && (
                  <div>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted }}>NÍVEL</div>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 11, color: accent, fontWeight: 600, letterSpacing: "0.06em", textTransform: "uppercase", marginTop: 2 }}>
                      {analise!.nivel}
                    </div>
                  </div>
                )}
                {analise!.score != null && (
                  <div>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted }}>SCORE</div>
                    <div style={{ fontFamily: FONT_DISPLAY, fontSize: 16, color: T.textPrimary, fontWeight: 500, letterSpacing: "0.04em", marginTop: 2 }}>
                      {analise!.score}<span style={{ fontSize: 9, color: T.textMuted, letterSpacing: "0.14em", marginLeft: 4 }}>/100</span>
                    </div>
                  </div>
                )}
                {analise!.feita_at && (
                  <div style={{ marginLeft: "auto", textAlign: "right" }}>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted }}>QUANDO</div>
                    <div style={{ fontFamily: FONT_BODY, fontSize: 9, color: T.textSecondary, marginTop: 2, letterSpacing: "0.04em" }}>
                      {fmtRelative(analise!.feita_at)}
                    </div>
                  </div>
                )}
              </div>
            )}

            {analise!.motivo && (
              <div>
                <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted, marginBottom: 4 }}>
                  ANÁLISE
                </div>
                <div style={{ fontFamily: FONT_BODY, fontSize: 11, lineHeight: 1.6, color: T.textPrimary, fontWeight: 300, whiteSpace: "pre-wrap" }}>
                  {analise!.motivo}
                </div>
              </div>
            )}

            {analise!.proxima_acao && (
              <div style={{ padding: "10px 12px", border: `1px solid ${CHAI}50`, backgroundColor: `${CHAI}12` }}>
                <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: CHAI, marginBottom: 5, fontWeight: 600 }}>
                  ▸ PRÓXIMA AÇÃO RECOMENDADA
                </div>
                <div style={{ fontFamily: FONT_BODY, fontSize: 11, lineHeight: 1.6, color: T.textPrimary, fontWeight: 400 }}>
                  {analise!.proxima_acao}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </>
  );
}

// ─── Form genérico de observação antes de confirmar ação ───────────────
function ObsForm({ action, busy, onCancel }: {
  action: PendingAction;
  busy: boolean;
  onCancel: () => void;
}) {
  const { T } = useTheme();
  const [text, setText] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const isWalnut = action.variant === "walnut";

  const confirm = async () => {
    setSubmitting(true);
    try { await action.exec(text.trim() || undefined); }
    finally { setSubmitting(false); }
  };

  return (
    <div style={{
      borderTop: `1px solid ${T.borderHover}`, backgroundColor: T.surface,
      padding: "14px 18px", flexShrink: 0,
    }}>
      <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: isWalnut ? WALNUT : T.textPrimary, marginBottom: 8, fontWeight: 700 }}>
        {action.label}
      </div>
      <textarea
        autoFocus
        value={text}
        onChange={(e) => setText(e.target.value)}
        rows={3}
        placeholder={action.hint || "Observação (opcional)"}
        style={{
          width: "100%", padding: "10px 12px",
          fontFamily: FONT_BODY, fontSize: 11, color: T.textPrimary,
          backgroundColor: T.bg, border: `1px solid ${isWalnut ? `${WALNUT}80` : T.borderHover}`, outline: "none",
          resize: "vertical",
        }}
      />
      <div style={{ display: "flex", gap: 8, marginTop: 10 }}>
        <BigButton onClick={confirm} disabled={busy || submitting} loading={busy || submitting} variant={isWalnut ? "walnut" : "primary"}>
          {text.trim() ? "CONFIRMAR · COM NOTA" : "CONFIRMAR"}
        </BigButton>
        <BigButton onClick={onCancel} disabled={submitting} variant="ghost">CANCELAR</BigButton>
      </div>
    </div>
  );
}

function AgendaTab({ active, onClick, children }: { active: boolean; onClick: () => void; children: React.ReactNode }) {
  const { T } = useTheme();
  return (
