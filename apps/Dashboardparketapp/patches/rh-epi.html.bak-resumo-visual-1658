        '</div>'+

        '<div id="bk-summary" style="background:#0f0f0f;border:1px solid #1f1f1f;border-radius:6px;padding:10px;margin-bottom:12px;font-size:11px"></div>'+

        '<div class="row" style="justify-content:flex-end">'+
          '<button class="ghost" id="bk-cancel">Cancelar</button>'+
          '<button id="bk-save">Criar entregas</button>'+
        '</div>'+
      '</div>';
    document.body.appendChild(modal);
    $("bk-data").value = new Date().toISOString().slice(0,10);

    var selectedFuncs = {}; // id -> bool
    var itemConfig = {};    // item_id -> {qty: int, enabled: bool, tamanho: "-"}

    function renderFuncList(){
      var fltFunc = $("bk-funcao").value;
      var fltLocal = $("bk-local").value;
      var matches = state.funcionarios.filter(function(f){
        if(fltFunc && f.funcao!==fltFunc) return false;
        if(fltLocal && f.local!==fltLocal) return false;
        return true;
      });
      // Reset selectedFuncs com novos matches (default: todos selecionados)
      var newSel = {};
      matches.forEach(function(f){
        newSel[f.id] = (selectedFuncs[f.id]!==undefined) ? selectedFuncs[f.id] : true;
      });
      selectedFuncs = newSel;

      $("bk-funcs").innerHTML = matches.map(function(f){
        var sizes = ["C:"+(f.tam_camisa||"—"), "P:"+(f.tam_calca||"—"), "B:"+(f.tam_bota||"—")].join(" · ");
        return '<label style="display:flex;align-items:center;padding:4px 6px;font-size:11px;cursor:pointer;border-bottom:1px solid #111">'+
          '<input type="checkbox" data-fid="'+f.id+'" '+(selectedFuncs[f.id]?'checked':'')+' style="width:auto;margin-right:8px">'+
          '<span style="flex:1"><b>'+escape(f.nome)+'</b> <span style="color:#666">·</span> '+escape(f.funcao||"")+' / '+escape(f.local||"")+'</span>'+
          '<span style="color:#666;font-size:10px">'+sizes+'</span>'+
        '</label>';
      }).join("") || '<div class="empty" style="font-size:11px">Nenhum funcionário no filtro</div>';
      $("bk-funcs").querySelectorAll("[data-fid]").forEach(function(c){
        c.onchange = function(){ selectedFuncs[c.dataset.fid] = c.checked; updateCount(); updateSummary(); };
      });
      updateCount();
      updateSummary();
    }

    function updateCount(){
      var sel = Object.keys(selectedFuncs).filter(function(k){return selectedFuncs[k];}).length;
      $("bk-count").textContent = "(" + sel + " selecionados)";
    }

    function renderItemList(){
      // Ordena: uniforme primeiro, depois calçado, depois EPIs
      var ordered = state.itens.slice().sort(function(a,b){return (a.ordem||0)-(b.ordem||0);});
      $("bk-itens").innerHTML = ordered.map(function(i){
        var key = i.id;
        if(itemConfig[key]===undefined){
          itemConfig[key] = { enabled: false, qty: 1, tamanho: "-" };
        }
        var cfg = itemConfig[key];
        var tField = autoTamanhoField(i);
        var auto = tField ? '<small style="color:#34D399">tamanho do funcionário ('+tField.replace("tam_","")+')</small>' : '<small style="color:#888">tamanho único: ' +
          '<input data-tam="'+key+'" value="'+escape(cfg.tamanho)+'" style="width:60px;display:inline-block;margin-left:4px;padding:2px 4px"/></small>';
        var ca = i.ca_numero && i.ca_numero!=="NA" ? ' <span style="color:#888;font-size:10px">CA '+escape(i.ca_numero)+'</span>' : '';
        return '<div style="display:flex;align-items:center;padding:4px 6px;font-size:11px;border-bottom:1px solid #111;gap:8px">'+
          '<input type="checkbox" data-it="'+key+'" '+(cfg.enabled?'checked':'')+' style="width:auto">'+
          '<span style="flex:1"><b>'+escape(i.nome)+'</b>'+ca+' '+auto+'</span>'+
          '<input type="number" min="1" data-qty="'+key+'" value="'+cfg.qty+'" style="width:60px;padding:2px 4px" placeholder="qty"/>'+
        '</div>';
      }).join("");
      $("bk-itens").querySelectorAll("[data-it]").forEach(function(c){
        c.onchange = function(){ itemConfig[c.dataset.it].enabled = c.checked; updateSummary(); };
      });
      $("bk-itens").querySelectorAll("[data-qty]").forEach(function(c){
        c.oninput = function(){ itemConfig[c.dataset.qty].qty = +c.value || 1; updateSummary(); };
      });
      $("bk-itens").querySelectorAll("[data-tam]").forEach(function(c){
        c.oninput = function(){ itemConfig[c.dataset.tam].tamanho = c.value || "-"; updateSummary(); };
      });
    }

    function updateSummary(){
      var sel = Object.keys(selectedFuncs).filter(function(k){return selectedFuncs[k];});
      var enabledItems = state.itens.filter(function(i){ return itemConfig[i.id] && itemConfig[i.id].enabled; });
      if(sel.length===0 || enabledItems.length===0){
        $("bk-summary").innerHTML = '<div style="color:#888">Selecione funcionários e itens pra ver o resumo.</div>';
        return;
      }
      // Calcula total necessário por (item_id × tamanho)
      var need = {}; // key -> qty
      sel.forEach(function(fid){
        var f = state.funcionarios.find(function(x){return x.id===fid;});
        if(!f) return;
        enabledItems.forEach(function(i){
          var cfg = itemConfig[i.id];
          var tField = autoTamanhoField(i);
          var tam = tField ? ((f[tField]||"").trim() || "-") : (cfg.tamanho || "-");
          tam = tam.toUpperCase();
          var k = i.id + "|" + tam;
          need[k] = (need[k] || 0) + cfg.qty;
        });
      });
      // Cruza com estoque (qualquer empresa/local)
      var estoqueDispo = {};
      state.estoque.forEach(function(s){
        var k = s.item_id + "|" + (s.tamanho||"-").toUpperCase();
        estoqueDispo[k] = (estoqueDispo[k] || 0) + (s.qty||0);
      });
      var falta = [], ok = [];
      Object.keys(need).forEach(function(k){
        var parts = k.split("|");
        var item = state.itens.find(function(x){return x.id===parts[0];}) || {};
        var entry = { nome: item.nome, tamanho: parts[1], precisa: need[k], tem: estoqueDispo[k]||0 };
        if(entry.tem < entry.precisa) falta.push(entry); else ok.push(entry);
      });
      var total = sel.length;
      var html = '<div><b>'+total+' entregas serão criadas</b> · '+enabledItems.length+' tipos de itens</div>';
      if(falta.length>0){
        html += '<div style="margin-top:8px;color:#F87171"><b>⚠ Estoque insuficiente:</b><ul style="margin:4px 0 0 18px;padding:0;font-size:10px">'+
          falta.map(function(e){return '<li>'+escape(e.nome||"")+' tam '+escape(e.tamanho)+': precisa '+e.precisa+', tem '+e.tem+'</li>';}).join("")+
        '</ul><div style="font-size:10px;margin-top:4px">As entregas serão criadas mesmo assim, mas considere reabastecer antes.</div></div>';
      } else {
        html += '<div style="margin-top:6px;color:#34D399">✓ Estoque disponível pra todas as entregas</div>';
      }
      $("bk-summary").innerHTML = html;
    }

    $("bk-funcao").onchange = renderFuncList;
    $("bk-local").onchange = renderFuncList;
    $("bk-all").onchange = function(){
      var checked = this.checked;
      Object.keys(selectedFuncs).forEach(function(k){ selectedFuncs[k] = checked; });
      $("bk-funcs").querySelectorAll("[data-fid]").forEach(function(c){ c.checked = checked; });
      updateCount(); updateSummary();
    };
    renderFuncList();
    renderItemList();

    $("bk-cancel").onclick = function(){ document.body.removeChild(modal); };
    $("bk-save").onclick = function(){
      var sel = Object.keys(selectedFuncs).filter(function(k){return selectedFuncs[k];});
      var enabledItems = state.itens.filter(function(i){ return itemConfig[i.id] && itemConfig[i.id].enabled; });
      if(sel.length===0){ alert("Selecione pelo menos 1 funcionário"); return; }
      if(enabledItems.length===0){ alert("Selecione pelo menos 1 item"); return; }
      if(!confirm("Criar "+sel.length+" entregas?\n\nUma entrega individual será criada pra cada funcionário, com os tamanhos do perfil dele. Cada um terá um link de assinatura único.")) return;

      var btn = this; btn.disabled = true; btn.textContent = "Criando…";
      var body = {
        funcionario_ids: sel,
        empresa_id: $("bk-emp").value || null,
        local: "",  // backend usa local do funcionário se vazio
        entregue_por: $("bk-rh").value.trim(),
        data_entrega: $("bk-data").value,
        observacao: $("bk-obs").value.trim(),
        itens: enabledItems.map(function(i){
          var cfg = itemConfig[i.id];
          var tField = autoTamanhoField(i);
          return {
            item_id: i.id,
            qty: cfg.qty,
            tamanho: cfg.tamanho || "-",
            tamanho_de: tField || null,
          };
        }),
      };
      fetch(BACKEND+"/entregas/bulk", {method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(body)})
        .then(function(r){ if(!r.ok) return r.text().then(function(t){throw new Error(t);}); return r.json(); })
        .then(function(d){
          // Mostra lista de links pra copiar
          var listHtml = d.entregas.map(function(e){
            var f = state.funcionarios.find(function(x){return x.id===e.funcionario_id;}) || {};
            return '<div style="display:flex;align-items:center;padding:4px 0;font-size:11px;border-bottom:1px solid #1a1a1a;gap:8px">'+
              '<span style="flex:1"><b>'+escape(f.nome||"—")+'</b></span>'+
              '<button class="ghost" data-copy="'+escape(e.signature_link)+'" style="font-size:10px">Copiar link</button>'+
            '</div>';
          }).join("");
          modal.querySelector(".modal").innerHTML =
            '<h2>✓ '+d.criadas+' entregas criadas</h2>'+
            '<div style="font-size:11px;color:#888;margin-bottom:10px">Mande o link de assinatura pra cada funcionário (WhatsApp, e-mail, ou tablet pessoalmente).</div>'+
            '<div style="max-height:300px;overflow-y:auto;background:#0a0a0a;border:1px solid #1a1a1a;border-radius:4px;padding:8px">'+listHtml+'</div>'+
            '<div class="row" style="margin-top:14px;justify-content:flex-end">'+
              '<button id="bk-close-final">Fechar</button>'+
            '</div>';
          modal.querySelectorAll("[data-copy]").forEach(function(b){
            b.onclick = function(){ navigator.clipboard.writeText(b.dataset.copy).then(function(){ b.textContent="✓"; setTimeout(function(){b.textContent="Copiar link";},1500); }); };
          });
          $("bk-close-final").onclick = function(){ document.body.removeChild(modal); loadAll().then(render); };
        })
        .catch(function(e){ alert("Erro: "+e.message); btn.disabled=false; btn.textContent="Criar entregas"; });
    };
  }

