  function drawEstoque(){
    var fEmp = state.filters.estoque_empresa || "";
    var fLocal = state.filters.estoque_local || "";
    var defaultEmp = fEmp || (state.empresas[0] && state.empresas[0].id) || "";
    var defaultLocal = fLocal || "SP";

    // Index estoque por item_id+empresa_id+local
    var idx = {};
    state.estoque.forEach(function(s){
      var k = s.item_id+"|"+(s.empresa_id||"")+"|"+(s.local||"");
      if(!idx[k]) idx[k] = [];
      idx[k].push(s);
    });

    // Ordenar tamanhos canonicamente
    var SIZE_ORDER = {"P":1,"M":2,"G":3,"GG":4,"G1":5,"G2":6,"G3":7,"-":99};
    function sortSizes(a, b){
      var sa = SIZE_ORDER[a.tamanho] || (parseInt(a.tamanho)||50);
      var sb = SIZE_ORDER[b.tamanho] || (parseInt(b.tamanho)||50);
      return sa - sb;
    }

    // Renderizar TODOS os itens do catálogo
    var html = state.itens.map(function(item){
      // Estoque deste item, filtrado por empresa/local
      var rows = state.estoque.filter(function(s){
        if(s.item_id!==item.id) return false;
        if(fEmp && s.empresa_id!==fEmp) return false;
        if(fLocal && s.local!==fLocal) return false;
        return true;
      }).sort(sortSizes);

      // Agrupa por (empresa+local) pra mostrar separadamente
      var byScope = {};
      rows.forEach(function(s){
        var emp = state.empresas.find(function(x){return x.id===s.empresa_id;}) || {};
        var key = (emp.nome||"-")+" · "+(s.local||"-");
        if(!byScope[key]) byScope[key] = [];
        byScope[key].push(s);
      });

      var totalQty = rows.reduce(function(a,s){return a+(s.qty||0);}, 0);
      var hasLow = rows.some(function(s){ return s.qty_minimo>0 && s.qty < s.qty_minimo; });
      var badge = rows.length===0
        ? '<span class="badge err">Sem estoque cadastrado</span>'
        : hasLow
          ? '<span class="badge err">⚠ Algum tamanho abaixo do mínimo</span>'
          : '<span class="badge ok">'+totalQty+' un. total</span>';

      var scopeRows = "";
      if(rows.length===0){
        scopeRows = '<div style="padding:14px;color:#666;font-size:11px;text-align:center;border-top:1px solid #1a1a1a">Nenhuma quantidade lançada para este item. Use <b>+ Adicionar / Ajustar</b>.</div>';
      } else {
        scopeRows = Object.keys(byScope).map(function(key){
          var sizes = byScope[key];
          var cells = sizes.map(function(s){
            var low = s.qty_minimo>0 && s.qty < s.qty_minimo;
            var minTxt = s.qty_minimo>0 ? '<small style="color:#888;display:block;font-size:9px">mín '+s.qty_minimo+'</small>' : '';
            return '<td style="padding:6px 8px;text-align:center;border-left:1px solid #1a1a1a">'+
              '<div style="font-size:9px;color:#888;text-transform:uppercase;letter-spacing:0.05em">'+escape(s.tamanho||"-")+'</div>'+
              '<div style="font-size:18px;font-weight:700;color:'+(low?"#F87171":"#34D399")+'">'+s.qty+'</div>'+
              minTxt+
            '</td>';
          }).join("");
          return '<div style="border-top:1px solid #1a1a1a">'+
            '<div style="padding:6px 12px;font-size:10px;color:#B8AA9A;background:#0f0f0f;letter-spacing:0.05em">'+escape(key)+'</div>'+
            '<table style="width:100%;border-collapse:collapse"><tr>'+cells+'</tr></table>'+
          '</div>';
        }).join("");
      }

      return '<div class="card" style="padding:0;margin-bottom:10px">'+
        '<div class="row" style="padding:10px 14px;justify-content:space-between">'+
          '<div>'+
            '<b>'+escape(item.nome)+'</b> '+
            '<span class="badge" style="margin-left:6px">'+escape(item.categoria||"")+'</span>'+
            (item.ca_numero && item.ca_numero!=="NA" ? ' <span class="badge" style="margin-left:4px">CA '+escape(item.ca_numero)+'</span>' : '')+
          '</div>'+
          '<div class="row">'+
            badge+
            ' <button class="ghost" data-add-item="'+item.id+'" style="margin-left:8px">+ Estoque</button>'+
          '</div>'+
        '</div>'+
        scopeRows+
      '</div>';
    }).join("");

    $("est-container").innerHTML = html || '<div class="card empty">Nenhum item no catálogo. Cadastre EPIs em "Catálogo de EPIs".</div>';
    document.querySelectorAll("[data-add-item]").forEach(function(b){
      b.onclick = function(){ openAjustarEstoque(b.dataset.addItem); };
    });
  }

  function openAjustarEstoque(presetItemId){
    var modal = document.createElement("div");
    modal.className = "modal-overlay";
    var itemOpts = state.itens.map(function(i){
      var sel = (presetItemId===i.id) ? ' selected' : '';
      var ca = i.ca_numero && i.ca_numero!=="NA" ? ' (CA '+escape(i.ca_numero)+')' : '';
      return '<option value="'+i.id+'"'+sel+'>'+escape(i.nome)+ca+'</option>';
    }).join("");
    modal.innerHTML =
      '<div class="modal"><h2>Adicionar / ajustar estoque</h2>'+
      '<div class="form-grid">'+
        '<div class="full"><label>Item (EPI / uniforme)</label><select id="es-item">'+itemOpts+'</select></div>'+
        '<div><label>Tamanho</label><input id="es-tam" placeholder="P / M / G / GG / 40 / -" /></div>'+
        '<div><label>Quantidade atual</label><input id="es-qty" type="number" min="0" value="0" /></div>'+
        '<div><label>Local</label><select id="es-local">'+["SP","PR","DF","AL","MT"].map(function(l){return '<option'+(state.filters.estoque_local===l?' selected':'')+'>'+l+'</option>';}).join("")+'</select></div>'+
        '<div><label>Empresa</label><select id="es-emp">'+state.empresas.map(function(e){var sel=(state.filters.estoque_empresa===e.id)?' selected':'';return '<option value="'+e.id+'"'+sel+'>'+escape(e.nome)+'</option>';}).join("")+'</select></div>'+
        '<div class="full"><label>Estoque mínimo (alerta quando atual fica abaixo)</label><input id="es-min" type="number" min="0" value="0" /></div>'+
      '</div>'+
      '<div class="row" style="margin-top:14px;justify-content:flex-end">'+
        '<button class="ghost" id="es-cancel">Cancelar</button>'+
        '<button id="es-save">Salvar</button>'+
      '</div></div>';
    document.body.appendChild(modal);
    $("es-cancel").onclick = function(){ document.body.removeChild(modal); };
    $("es-save").onclick = function(){
      var body = {
        item_id: $("es-item").value,
        tamanho: ($("es-tam").value || "-").trim().toUpperCase(),
        local: $("es-local").value,
        empresa_id: $("es-emp").value,
        qty: +$("es-qty").value || 0,
        qty_minimo: +$("es-min").value || 0,
      };
      if(!body.item_id){ alert("Escolha um item"); return; }
      var existing = state.estoque.find(function(s){
        return s.item_id===body.item_id && (s.tamanho||"-")===body.tamanho && s.local===body.local && s.empresa_id===body.empresa_id;
      });
      var p;
      if(existing) p = sb("rh_epi_estoque", {method:"PATCH", q:"id=eq."+existing.id, body: {qty: body.qty, qty_minimo: body.qty_minimo}});
      else p = sb("rh_epi_estoque", {method:"POST", body: body});
      p.then(function(){ document.body.removeChild(modal); loadAll().then(render); }).catch(function(e){ alert("Erro: "+e.message); });
    };
  }

  // ─── ITENS (catálogo) ───
  function renderItens(m){
    m.innerHTML =
      '<div class="card">'+
        '<div class="row" style="justify-content:space-between">'+
          '<div><b>Catálogo de EPIs / Uniformes</b> <small>('+state.itens.length+')</small></div>'+
          '<button id="btn-new-it">+ Novo item</button>'+
        '</div>'+
      '</div>'+
      '<div class="card" style="padding:0"><table id="tab-it"></table></div>';
    var rows = state.itens.map(function(i){
      return '<tr>'+
        '<td><b>'+escape(i.nome)+'</b></td>'+
        '<td><span class="badge">'+escape(i.categoria||"")+'</span></td>'+
        '<td>'+escape(i.ca_numero||"NA")+'</td>'+
        '<td>'+escape(i.tipo_tamanho||"")+'</td>'+
        '<td><button class="ghost" data-it-edit="'+i.id+'">Editar</button> <button class="danger" data-it-del="'+i.id+'">×</button></td>'+
      '</tr>';
    }).join("");
    $("tab-it").innerHTML = '<thead><tr><th>Nome</th><th>Categoria</th><th>C.A.</th><th>Tipo tamanho</th><th></th></tr></thead><tbody>'+rows+'</tbody>';
    $("btn-new-it").onclick = function(){ openItemModal(null); };
    document.querySelectorAll("[data-it-edit]").forEach(function(b){ b.onclick = function(){ openItemModal(b.dataset.itEdit); }; });
    document.querySelectorAll("[data-it-del]").forEach(function(b){ b.onclick = function(){
      if(!confirm("Remover item?")) return;
      sb("rh_epi_itens", {method:"DELETE", q:"id=eq."+b.dataset.itDel}).then(function(){ loadAll().then(render); });
    }; });
  }

  function openItemModal(id){
    var i = id ? state.itens.find(function(x){return x.id===id;}) : { categoria:"epi", tipo_tamanho:"unico" };
    i = JSON.parse(JSON.stringify(i||{}));
    var modal = document.createElement("div");
    modal.className = "modal-overlay";
    modal.innerHTML =
      '<div class="modal"><h2>'+(id?"Editar":"Novo")+' item</h2>'+
      '<div class="form-grid">'+
        '<div class="full"><label>Nome</label><input id="im-nome" value="'+escape(i.nome||"")+'" /></div>'+
        '<div><label>Categoria</label><select id="im-cat">'+["uniforme","calcado","epi","acessorio"].map(function(x){return '<option'+(i.categoria===x?' selected':'')+'>'+x+'</option>';}).join("")+'</select></div>'+
        '<div><label>C.A. (Certificado Aprovação)</label><input id="im-ca" value="'+escape(i.ca_numero||"")+'" placeholder="NA ou número" /></div>'+
        '<div><label>Tipo de tamanho</label><select id="im-ts">'+["letras","numerico","unico"].map(function(x){return '<option'+(i.tipo_tamanho===x?' selected':'')+'>'+x+'</option>';}).join("")+'</select></div>'+
        '<div><label>Ordem</label><input id="im-ord" type="number" value="'+(i.ordem||0)+'" /></div>'+
      '</div>'+
      '<div class="row" style="margin-top:14px;justify-content:flex-end">'+
        '<button class="ghost" id="im-cancel">Cancelar</button>'+
        '<button id="im-save">Salvar</button>'+
      '</div></div>';
    document.body.appendChild(modal);
    $("im-cancel").onclick = function(){ document.body.removeChild(modal); };
    $("im-save").onclick = function(){
      var body = { nome: $("im-nome").value.trim(), categoria: $("im-cat").value, ca_numero: $("im-ca").value.trim()||"NA", tipo_tamanho: $("im-ts").value, ordem: +$("im-ord").value||0 };
      if(!body.nome){ alert("Nome obrigatório"); return; }
      var p = id ? sb("rh_epi_itens",{method:"PATCH",q:"id=eq."+id,body:body}) : sb("rh_epi_itens",{method:"POST",body:body});
      p.then(function(){ document.body.removeChild(modal); loadAll().then(render); }).catch(function(e){ alert("Erro: "+e.message); });
    };
  }

  // ─── EMPRESAS ───
  function renderEmpresas(m){
    m.innerHTML =
      '<div class="card">'+
        '<div class="row" style="justify-content:space-between">'+
          '<div><b>Empresas</b> <small>('+state.empresas.length+')</small></div>'+
          '<button id="btn-new-e">+ Nova empresa</button>'+
        '</div>'+
      '</div>'+
      '<div class="card" style="padding:0"><table id="tab-emp"></table></div>';
    var rows = state.empresas.map(function(e){
      return '<tr><td><b>'+escape(e.nome)+'</b></td><td>'+escape(e.cnpj||"-")+'</td><td><button class="ghost" data-e-edit="'+e.id+'">Editar</button></td></tr>';
    }).join("") || '<tr><td colspan="3" class="empty">Nenhuma empresa</td></tr>';
    $("tab-emp").innerHTML = '<thead><tr><th>Nome</th><th>CNPJ</th><th></th></tr></thead><tbody>'+rows+'</tbody>';
    $("btn-new-e").onclick = function(){ openEmpresaModal(null); };
    document.querySelectorAll("[data-e-edit]").forEach(function(b){ b.onclick = function(){ openEmpresaModal(b.dataset.eEdit); }; });
  }

  function openEmpresaModal(id){
    var e = id ? state.empresas.find(function(x){return x.id===id;}) : {};
    e = JSON.parse(JSON.stringify(e||{}));
    var modal = document.createElement("div");
    modal.className = "modal-overlay";
    modal.innerHTML =
      '<div class="modal"><h2>'+(id?"Editar":"Nova")+' empresa</h2>'+
      '<div><label>Nome</label><input id="em-nome" value="'+escape(e.nome||"")+'" /></div>'+
      '<div style="margin-top:10px"><label>CNPJ</label><input id="em-cnpj" value="'+escape(e.cnpj||"")+'" /></div>'+
      '<div class="row" style="margin-top:14px;justify-content:flex-end">'+
        (id?'<button class="danger" id="em-del" style="margin-right:auto">Remover</button>':'')+
        '<button class="ghost" id="em-cancel">Cancelar</button>'+
        '<button id="em-save">Salvar</button>'+
      '</div></div>';
    document.body.appendChild(modal);
    $("em-cancel").onclick = function(){ document.body.removeChild(modal); };
    if(id){
      $("em-del").onclick = function(){
        if(!confirm("Remover empresa?")) return;
        sb("rh_empresas",{method:"DELETE",q:"id=eq."+id}).then(function(){ document.body.removeChild(modal); loadAll().then(render); });
      };
    }
    $("em-save").onclick = function(){
      var body = { nome: $("em-nome").value.trim(), cnpj: $("em-cnpj").value.trim() };
      if(!body.nome){ alert("Nome obrigatório"); return; }
      var p = id ? sb("rh_empresas",{method:"PATCH",q:"id=eq."+id,body:body}) : sb("rh_empresas",{method:"POST",body:body});
      p.then(function(){ document.body.removeChild(modal); loadAll().then(render); }).catch(function(err){ alert("Erro: "+err.message); });
    };
  }

  function el(html){ var d=document.createElement("div"); d.innerHTML=html.trim(); return d.firstChild; }

  loadAll().then(render).catch(function(e){ $("main").innerHTML = '<div class="card" style="color:#F87171">Erro ao carregar: '+escape(e.message)+'</div>'; });
})();
</script>
</body>
</html>
