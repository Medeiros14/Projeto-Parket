                        o.jsx("td", { style: { padding: "6px 8px", color: TXT_DIM }, children: caract.join(", ") || "—" }),
                        o.jsx("td", { style: { padding: "6px 8px", color: TXT_DIM }, children: ests.join(", ") || "—" }),
