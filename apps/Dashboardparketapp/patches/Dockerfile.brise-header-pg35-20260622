FROM parket-dashboard:golden
# PKT-BRISE-HEADER 2026-06-22: header coluna mostra "BRISE" quando categoria contem BRISE
COPY propostaGenerator-PGSTRUCT35.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT35.js
COPY orcamento-simulador-tab-MARCFIX47.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX47.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|propostaGenerator-PGSTRUCT3[0-4]\.js|propostaGenerator-PGSTRUCT35.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-pg35-brise-header'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
