FROM parket-dashboard:golden
# PKT-MF54 2026-06-22: expoe _refazerItem + setSel + setStep no window pro 🔧 funcionar
COPY orcamento-simulador-tab-MARCFIX54.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX54.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX53\.js|orcamento-simulador-tab-MARCFIX54.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf54-refazer-fix'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
