      <span class="pipe-arrow">→</span>
      <div class="pipe-step ${pipeStep===3?'active':''}" id="pipe-3"><div class="pipe-num">3</div> Deploy Producao</div>
    </div>`;

    a.innerHTML=header+`<div class="lay">${sidebar}<div class="mn">${tabsHtml}${pipelineHtml}
      <div class="terminal-wrap" id="terminal-wrap">
        <div class="terminal" id="terminal"></div>
      </div>
      <div class="input-bar">
        <div class="mode-toggle">
          <button class="mode-btn ${mode==='claude'?'active':''}" onclick="mode='claude';updatePlaceholder()">Claude</button>
          <button class="mode-btn ${mode==='shell'?'active':''}" onclick="mode='shell';updatePlaceholder()">Shell</button>
        </div>
        <input id="cmd-input" placeholder="${placeholder}" ${processing?'disabled':''} onkeydown="if(event.key==='Enter')sendMessage()"/>
        <button class="btn bp" id="send-btn" ${processing?'disabled':''} onclick="sendMessage()">${mode==='claude'?'⚡ Enviar':'▶ Run'}</button>
        <button class="btn bg" onclick="clearTerminal()" title="Limpar terminal" style="padding:8px 10px">🗑</button>
      </div>
    </div></div>`;

    const term=document.getElementById('terminal');
    if(term && term.children.length===0){
      addLine('system','⚡ Parket Code Terminal — '+APPS[curApp].nome+(curSetor?' / '+curSetor:''),'accent');
      addLine('system','','dim');
      addLine('system','FLUXO DE TRABALHO:','dim');
      addLine('system','  1. Descreva a alteracao no modo Claude → codigo editado automaticamente','dim');
      addLine('system','  2. Clique "Build Preview" → imagem staging gerada + container de teste','dim');
      addLine('system','  3. Valide o preview → clique "Deploy" para enviar a producao','dim');
      addLine('system','','dim');
      addLine('system','Modo Shell disponivel para comandos diretos (git status, ls, etc.)','dim');
      addLine('system','','dim');
    }
  }
  else if(tab==='admin'&&isAdmin){
    const devsHtml=(Array.isArray(devs)?devs:[]).map(d=>{
      const isAdminRole=(d.role==='superadmin'||d.role==='admin');
