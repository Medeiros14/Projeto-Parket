<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Controle de EPIs — Parket RH</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: -apple-system, "Segoe UI", system-ui, sans-serif; background: #0a0a0a; color: #fff; font-size: 13px; }
  a { color: #34D399; }
  header { background: #111; border-bottom: 2px solid #B8AA9A; padding: 12px 18px; display: flex; align-items: center; gap: 12px; }
  header h1 { font-size: 14px; font-weight: 800; letter-spacing: 0.05em; color: #B8AA9A; text-transform: uppercase; flex: 1; }
  .tabs { display: flex; gap: 4px; padding: 0 16px; background: #111; border-bottom: 1px solid #222; }
  .tab { padding: 10px 14px; cursor: pointer; color: #888; border-bottom: 2px solid transparent; font-weight: 600; font-size: 12px; }
  .tab.active { color: #B8AA9A; border-bottom-color: #B8AA9A; }
  main { padding: 18px; max-width: 1400px; margin: 0 auto; }
  .card { background: #141414; border: 1px solid #222; border-radius: 8px; padding: 16px; margin-bottom: 14px; }
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .row > * { flex: 0 0 auto; }
  input, select, textarea { background: #0a0a0a; border: 1px solid #333; border-radius: 4px; color: #fff; padding: 6px 8px; font-size: 12px; outline: none; font-family: inherit; }
  input:focus, select:focus, textarea:focus { border-color: #B8AA9A; }
  button { background: #B8AA9A; color: #000; border: none; border-radius: 4px; padding: 6px 12px; font-size: 12px; font-weight: 700; cursor: pointer; }
  button.ghost { background: transparent; color: #ccc; border: 1px solid #333; }
  button.danger { background: transparent; color: #F87171; border: 1px solid #F87171; }
  button:hover { opacity: 0.9; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th { background: #1a1a1a; padding: 8px 10px; text-align: left; font-weight: 700; color: #B8AA9A; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid #222; }
  td { padding: 8px 10px; border-bottom: 1px solid #1a1a1a; vertical-align: top; }
  tr:hover td { background: #181818; }
  .badge { display: inline-block; padding: 2px 7px; border-radius: 3px; font-size: 10px; background: #2a2a2a; color: #ccc; font-weight: 600; }
  .badge.ok { background: rgba(16,185,129,0.15); color: #34D399; }
  .badge.warn { background: rgba(245,158,11,0.15); color: #FBBF24; }
  .badge.err { background: rgba(239,68,68,0.15); color: #F87171; }
  .filter-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 100; }
  .modal { background: #141414; border: 1px solid #B8AA9A; border-radius: 10px; padding: 20px; width: min(700px, 100%); max-height: 90vh; overflow-y: auto; }
  .modal h2 { font-size: 14px; color: #B8AA9A; margin-bottom: 14px; letter-spacing: 0.05em; text-transform: uppercase; }
  label { display: block; font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .full { grid-column: 1 / -1; }
  .item-row { display: grid; grid-template-columns: 2fr 1fr 80px 30px; gap: 6px; align-items: center; margin-bottom: 6px; }
  .stock-badge { font-weight: 700; font-size: 13px; }
  .stock-badge.low { color: #F87171; }
  .stock-badge.ok { color: #34D399; }
  small { color: #666; font-size: 10px; }
  .empty { text-align: center; padding: 40px; color: #666; }
</style>
</head>
<body>
<header>
  <h1>📋 Controle de EPIs e Uniformes</h1>
  <a href="/rh" style="color:#888;font-size:11px;text-decoration:none;">← Voltar ao RH</a>
</header>
<div class="tabs">
  <div class="tab active" data-tab="entregas">Entregas</div>
  <div class="tab" data-tab="funcionarios">Funcionários</div>
  <div class="tab" data-tab="estoque">Estoque</div>
  <div class="tab" data-tab="controle">Controle</div>
  <div class="tab" data-tab="itens">Catálogo de EPIs</div>
  <div class="tab" data-tab="empresas">Empresas</div>
</div>
<main id="main"><div class="empty">Carregando…</div></main>

<script>
(function(){
  var SUPA_URL = "https://hbxpilrxmitvzebluoom.supabase.co";
  var SUPA_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhieHBpbHJ4bWl0dnplYmx1b29tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI5NDI1MjcsImV4cCI6MjA4ODUxODUyN30.ya-G4__-X_xlaA-Pw3qP_uWlvz8KqCsZbN3cLNG7Ohk";
  var SVC_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhieHBpbHJ4bWl0dnplYmx1b29tIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3Mjk0MjUyNywiZXhwIjoyMDg4NTE4NTI3fQ.fTovVTCBFcMrrhVCR6TsneALfMRLLLHZdMmSJH16L4A";
  var BACKEND = "https://draw.parket.works/api/rh/epi";
  var H = { apikey: SVC_KEY, Authorization: "Bearer "+SVC_KEY, "Content-Type": "application/json" };

  function $(id){ return document.getElementById(id); }
  function escape(s){ return (s==null?"":String(s)).replace(/[<>&"]/g,function(c){return {"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;"}[c];}); }

  function sb(table, opts){
    opts = opts||{};
    var url = SUPA_URL+"/rest/v1/"+table+(opts.q?("?"+opts.q):"");
    var init = { method: opts.method||"GET", headers: H };
    if(opts.body) init.body = JSON.stringify(opts.body);
    if(opts.method==="POST"||opts.method==="PATCH") init.headers = Object.assign({}, H, {Prefer:"return=representation"});
    return fetch(url, init).then(function(r){ if(!r.ok) return r.text().then(function(t){throw new Error("HTTP "+r.status+" "+t);}); return r.status===204?null:r.json(); });
  }

  // Cache
  var state = {
    empresas: [], funcionarios: [], itens: [], estoque: [], entregas: [],
    activeTab: "entregas",
    filters: { local: "", funcao: "", empresa: "", q: "", estoque_empresa: "", estoque_local: "" },
  };

  function loadAll(){
    return Promise.all([
      sb("rh_empresas", {q:"select=*&order=nome.asc"}).then(function(r){state.empresas=r||[];}),
      sb("rh_funcionarios", {q:"select=*&order=nome.asc"}).then(function(r){state.funcionarios=r||[];}),
      sb("rh_epi_itens", {q:"select=*&order=ordem.asc"}).then(function(r){state.itens=r||[];}),
      sb("rh_epi_estoque", {q:"select=*"}).then(function(r){state.estoque=r||[];}),
      sb("rh_epi_entregas", {q:"select=*&order=data_entrega.desc&limit=300"}).then(function(r){state.entregas=r||[];}),
    ]);
  }

  // ─── Tabs ───
  document.querySelectorAll(".tab").forEach(function(t){
    t.onclick = function(){
      document.querySelectorAll(".tab").forEach(function(x){x.classList.remove("active");});
      t.classList.add("active");
      state.activeTab = t.dataset.tab;
      render();
    };
  });

  // ─── Render principal ───
  function render(){
    var m = $("main");
    if(state.activeTab==="entregas") return renderEntregas(m);
    if(state.activeTab==="funcionarios") return renderFuncionarios(m);
    if(state.activeTab==="estoque") return renderEstoque(m);
    if(state.activeTab==="controle") return renderControle(m);
    if(state.activeTab==="itens") return renderItens(m);
    if(state.activeTab==="empresas") return renderEmpresas(m);
  }

  // ─── CONTROLE (Resumo Executivo / Funcionários / Distribuição Local) ───
  // Estado interno da aba Controle
  state.controleSub = state.controleSub || "resumo"; // resumo | func | dist
  state.controleFilter = state.controleFilter || null; // { categoria, tamanho } quando vem do click no resumo
  state.controleBusca = state.controleBusca || "";
  state.controleLocal = state.controleLocal || "";
  state.controleCargo = state.controleCargo || "";

  // Categorias de uniforme (mapeia campo do rh_funcionarios → label)
  var CONTROLE_CATEGORIAS = [
    { key: "tam_camisa", label: "CAMISA" },
    { key: "tam_polo", label: "POLO" },
    { key: "tam_calca", label: "CALÇA" },
    { key: "tam_bota", label: "BOTA" }
  ];

  var ORDEM_TAMANHOS = ["PP","P","M","G","GG","G1","G2","G3","EG"];

  function ordenarTamanhos(arr){
    return arr.slice().sort(function(a,b){
      var ai = ORDEM_TAMANHOS.indexOf(a), bi = ORDEM_TAMANHOS.indexOf(b);
      if(ai>=0 && bi>=0) return ai-bi;
      if(ai>=0) return -1;
      if(bi>=0) return 1;
      var an = parseFloat(a), bn = parseFloat(b);
      if(!isNaN(an) && !isNaN(bn)) return an-bn;
      return String(a).localeCompare(String(b));
    });
  }

  function renderControle(m){
    var sub = state.controleSub;
    var tabsHtml =
      '<div class="tabs" style="border-bottom:1px solid #222;margin-bottom:14px;gap:2px">'+
        '<div class="tab' + (sub==="resumo"?" active":"") + '" data-csub="resumo">Resumo executivo</div>'+
        '<div class="tab' + (sub==="func"?" active":"") + '" data-csub="func">Funcionários</div>'+
        '<div class="tab' + (sub==="dist"?" active":"") + '" data-csub="dist">Distribuição local</div>'+
      '</div>';

    var body = '';
    if(sub==="resumo") body = renderControleResumo();
    else if(sub==="func") body = renderControleFuncionarios();
    else if(sub==="dist") body = renderControleDistribuicao();

    m.innerHTML = tabsHtml + '<div id="ctl-body">'+body+'</div>';

    // sub-tabs handlers
    m.querySelectorAll("[data-csub]").forEach(function(t){
      t.onclick = function(){
        state.controleSub = t.dataset.csub;
        if(state.controleSub!=="func") state.controleFilter = null;
        renderControle($("main"));
      };
    });

    bindControleHandlers(m);
  }

  function renderControleResumo(){
    // Agrega: para cada categoria, conta funcionários por tamanho
    var contagens = {};
    CONTROLE_CATEGORIAS.forEach(function(cat){ contagens[cat.key] = {}; });
    state.funcionarios.forEach(function(f){
      if(f.ativo===false) return;
      CONTROLE_CATEGORIAS.forEach(function(cat){
        var v = (f[cat.key] || "").toString().trim();
        if(v && v !== "-") contagens[cat.key][v] = (contagens[cat.key][v]||0) + 1;
      });
    });

    var cards = CONTROLE_CATEGORIAS.map(function(cat){
      var sizes = ordenarTamanhos(Object.keys(contagens[cat.key]));
      var total = sizes.reduce(function(a,s){ return a+contagens[cat.key][s]; }, 0);
      var chips = sizes.length===0
        ? '<span class="empty" style="padding:6px;display:inline-block">sem dados</span>'
        : sizes.map(function(s){
            return '<button class="ctl-chip" data-cat="'+cat.key+'" data-tam="'+escape(s)+'" style="background:#1a1a1a;border:1px solid #333;color:#fff;padding:5px 10px;border-radius:4px;font-size:12px;cursor:pointer;margin:0 4px 4px 0">'+
              '<b>'+escape(s)+'</b> <span style="color:#888;margin-left:4px">'+contagens[cat.key][s]+'</span>'+
            '</button>';
          }).join("");
      return '<div class="card">'+
        '<div class="row" style="justify-content:space-between;margin-bottom:10px">'+
          '<b>'+escape(cat.label)+'</b>'+
          '<small>'+total+' pessoa(s)</small>'+
        '</div>'+
        '<div>'+chips+'</div>'+
      '</div>';
    }).join("");

    return '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px">'+cards+'</div>'+
      '<div style="margin-top:14px;color:#666;font-size:11px">Clique num tamanho pra abrir a lista de funcionários filtrada.</div>';
  }

  function renderControleFuncionarios(){
    var f = state.controleFilter;
    var filterPill = f
      ? '<span class="badge" style="background:rgba(184,170,154,0.15);color:#B8AA9A;border:1px solid #B8AA9A">'+
          escape(catLabel(f.categoria))+': <b>'+escape(f.tamanho)+'</b>'+
          ' <button class="ctl-clear-filter" style="background:transparent;color:#B8AA9A;border:none;cursor:pointer;font-size:14px;padding:0 0 0 8px">×</button>'+
        '</span>'
      : '';
    var totalFuncs = state.funcionarios.filter(function(x){return x.ativo!==false;}).length;

    // Listas únicas pra filtros
    var locaisUnicos = Array.from(new Set(state.funcionarios.map(function(x){return x.local;}).filter(Boolean))).sort();
    var cargosUnicos = Array.from(new Set(state.funcionarios.map(function(x){return x.cargo||x.funcao;}).filter(Boolean))).sort();

    var filtros =
      '<div class="card" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px">'+
        '<input id="ctl-busca" placeholder="Buscar por nome…" value="'+escape(state.controleBusca)+'" style="flex:1;min-width:200px"/>'+
        '<select id="ctl-local"><option value="">Todos os locais</option>'+
          locaisUnicos.map(function(l){ return '<option value="'+escape(l)+'"'+(state.controleLocal===l?' selected':'')+'>'+escape(l)+'</option>'; }).join("")+
        '</select>'+
        '<select id="ctl-cargo"><option value="">Todos os cargos</option>'+
          cargosUnicos.map(function(c){ return '<option value="'+escape(c)+'"'+(state.controleCargo===c?' selected':'')+'>'+escape(c)+'</option>'; }).join("")+
        '</select>'+
        filterPill+
      '</div>';

    // Aplica filtros
    var lista = state.funcionarios.filter(function(x){
      if(x.ativo===false) return false;
      if(state.controleFilter){
        var cf = state.controleFilter;
        var v = (x[cf.categoria]||"").toString().trim();
        if(v !== cf.tamanho) return false;
      }
      if(state.controleLocal && x.local !== state.controleLocal) return false;
      if(state.controleCargo){
        var carg = x.cargo || x.funcao || "";
        if(carg !== state.controleCargo) return false;
      }
      if(state.controleBusca && state.controleBusca.trim()){
        var q = state.controleBusca.trim().toLowerCase();
        if(!(x.nome||"").toLowerCase().includes(q)) return false;
      }
      return true;
    });

    var rows = lista.map(function(x){
      function highlight(catKey, val){
        var hi = state.controleFilter && state.controleFilter.categoria===catKey && state.controleFilter.tamanho===val;
        return '<td style="'+(hi?'background:rgba(184,170,154,0.18);color:#B8AA9A;font-weight:700':'')+'">'+escape(val||"—")+'</td>';
      }
      return '<tr>'+
        '<td><b>'+escape(x.nome||"")+'</b></td>'+
        '<td><small>'+escape(x.cargo||x.funcao||"")+'</small></td>'+
        '<td><small>'+escape(x.local||"")+'</small></td>'+
        highlight("tam_camisa", x.tam_camisa)+
        highlight("tam_polo", x.tam_polo)+
        highlight("tam_calca", x.tam_calca)+
        highlight("tam_bota", x.tam_bota)+
      '</tr>';
    }).join("") || '<tr><td colspan="7" class="empty">Nenhum funcionário com esses filtros.</td></tr>';

    var counter = '<div style="margin-bottom:10px;color:#666;font-size:11px">'+lista.length+' de '+totalFuncs+' funcionários</div>';

    return filtros + counter +
      '<div class="card" style="padding:0"><table>'+
        '<thead><tr><th>Nome</th><th>Cargo</th><th>Local</th><th>Camisa</th><th>Polo</th><th>Calça</th><th>Bota</th></tr></thead>'+
        '<tbody>'+rows+'</tbody>'+
      '</table></div>';
  }

  function renderControleDistribuicao(){
    // Agrega por local e cargo
    var porLocal = {};
    var porCargoLocal = {};
    state.funcionarios.forEach(function(f){
      if(f.ativo===false) return;
      var l = f.local || "—";
      var c = f.cargo || f.funcao || "—";
      porLocal[l] = (porLocal[l]||0) + 1;
      porCargoLocal[c] = porCargoLocal[c] || {};
      porCargoLocal[c][l] = (porCargoLocal[c][l]||0) + 1;
    });
    var locais = Object.keys(porLocal).sort();
    var cargos = Object.keys(porCargoLocal).sort();

    var headLocal = '<tr><th>Cargo</th>'+locais.map(function(l){ return '<th style="text-align:center">'+escape(l)+'</th>'; }).join("")+'<th style="text-align:center;color:#B8AA9A">Total</th></tr>';
    var bodyLocal = cargos.map(function(c){
      var tot = locais.reduce(function(a,l){ return a + (porCargoLocal[c][l]||0); }, 0);
      return '<tr><td><b>'+escape(c)+'</b></td>'+
        locais.map(function(l){
          var v = porCargoLocal[c][l]||0;
          return '<td style="text-align:center;'+(v===0?'color:#444':'')+'">'+v+'</td>';
        }).join("")+
        '<td style="text-align:center;font-weight:700;color:#B8AA9A">'+tot+'</td>'+
      '</tr>';
    }).join("");

    var totalGeral = locais.reduce(function(a,l){ return a + porLocal[l]; }, 0);
    bodyLocal += '<tr style="background:#0f0f0f;font-weight:700">'+
      '<td>TOTAL</td>'+
      locais.map(function(l){ return '<td style="text-align:center;color:#B8AA9A">'+porLocal[l]+'</td>'; }).join("")+
      '<td style="text-align:center;color:#B8AA9A">'+totalGeral+'</td>'+
    '</tr>';

    return '<div class="card" style="padding:0">'+
        '<table><thead>'+headLocal+'</thead><tbody>'+bodyLocal+'</tbody></table>'+
      '</div>';
  }

  function catLabel(catKey){
    var c = CONTROLE_CATEGORIAS.find(function(x){return x.key===catKey;});
    return c ? c.label : catKey;
  }

  function bindControleHandlers(m){
    // Chips do resumo: click → muda pra sub-aba Funcionários filtrada
    m.querySelectorAll(".ctl-chip").forEach(function(b){
      b.onclick = function(){
        state.controleFilter = { categoria: b.dataset.cat, tamanho: b.dataset.tam };
        state.controleSub = "func";
        renderControle($("main"));
      };
    });
    // Limpa filtro
    var cf = m.querySelector(".ctl-clear-filter");
    if(cf) cf.onclick = function(){
      state.controleFilter = null;
      renderControle($("main"));
    };
    // Busca + selects da sub-aba funcionários
    var bs = m.querySelector("#ctl-busca");
    if(bs) bs.oninput = function(){ state.controleBusca = bs.value; var b=$("ctl-body"); if(b) b.innerHTML = renderControleFuncionarios(); bindControleHandlers(m); };
    var sl = m.querySelector("#ctl-local");
    if(sl) sl.onchange = function(){ state.controleLocal = sl.value; renderControle($("main")); };
    var sc = m.querySelector("#ctl-cargo");
    if(sc) sc.onchange = function(){ state.controleCargo = sc.value; renderControle($("main")); };
  }

  // ─── ENTREGAS ───
  function renderEntregas(m){
    if(!state.selectedEntregas) state.selectedEntregas = {};
    m.innerHTML =
      '<div class="card">'+
        '<div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:8px">'+
          '<div><b>Entregas registradas</b> <small>('+state.entregas.length+')</small></div>'+
          '<div class="row"><button id="btn-bulk" class="ghost">+ Entrega geral por cargo</button> <button id="btn-nova">+ Nova entrega</button></div>'+
        '</div>'+
        '<div id="ent-bulkbar" class="row" style="margin-top:10px;display:none;background:#1a0f0f;border:1px solid rgba(248,113,113,0.3);border-radius:6px;padding:8px 10px;justify-content:space-between">'+
          '<div style="font-size:12px"><b id="ent-selcount">0</b> entregas selecionadas</div>'+
          '<div class="row"><button class="ghost" id="ent-clearsel">Desmarcar</button> <button class="danger" id="ent-bulkdel">Excluir selecionadas</button></div>'+
        '</div>'+
      '</div>'+
      '<div class="card" style="padding:0">'+
        '<table id="tab-ent"></table>'+
      '</div>';
    var rows = state.entregas.map(function(e){
      var f = state.funcionarios.find(function(x){return x.id===e.funcionario_id;}) || {};
      var emp = state.empresas.find(function(x){return x.id===e.empresa_id;}) || {};
      var nItens = (e.itens||[]).reduce(function(a,i){return a+(i.qty||0);},0);
      var st = e.status==="assinado" ? '<span class="badge ok">Assinado</span>' :
               e.status==="cancelado" ? '<span class="badge err">Cancelado</span>' :
               '<span class="badge warn">Aguardando</span>';
      var actions = '';
      if(e.status==="pendente_assinatura"){
        actions = '<button class="ghost" data-link="'+e.signature_token+'">Copiar link</button>';
      } else if(e.status==="assinado"){
        actions = '<button class="ghost" data-pdf="'+e.id+'">Baixar PDF</button>';
      }
      actions += ' <button class="danger" data-del="'+e.id+'" data-status="'+e.status+'" title="Excluir entrega">×</button>';
      var checked = state.selectedEntregas[e.id] ? ' checked' : '';
      return '<tr>'+
        '<td style="width:30px;text-align:center"><input type="checkbox" data-sel="'+e.id+'" data-status="'+e.status+'"'+checked+' style="width:auto;cursor:pointer"></td>'+
        '<td>'+(e.data_entrega||"")+'</td>'+
        '<td><b>'+escape(f.nome||"—")+'</b><br><small>'+escape(f.cargo||f.funcao||"")+' · '+escape(f.local||e.local||"")+'</small></td>'+
        '<td>'+escape(emp.nome||"")+'</td>'+
        '<td>'+nItens+' itens</td>'+
        '<td>'+st+'</td>'+
        '<td>'+actions+'</td>'+
      '</tr>';
    }).join("") || '<tr><td colspan="7" class="empty">Nenhuma entrega ainda. Clique em "+ Nova entrega".</td></tr>';
    $("tab-ent").innerHTML = '<thead><tr><th style="width:30px;text-align:center"><input type="checkbox" id="ent-selall" style="width:auto;cursor:pointer" title="Selecionar todas"></th><th>Data</th><th>Funcionário</th><th>Empresa</th><th>Itens</th><th>Status</th><th></th></tr></thead><tbody>'+rows+'</tbody>';
    $("btn-nova").onclick = openNovaEntrega;
    $("btn-bulk").onclick = openEntregaGeral;

    function updateBulkbar(){
      var ids = Object.keys(state.selectedEntregas).filter(function(k){return state.selectedEntregas[k];});
      var bar = $("ent-bulkbar");
      if(ids.length>0){
        bar.style.display = "flex";
        $("ent-selcount").textContent = ids.length;
      } else {
        bar.style.display = "none";
      }
    }
    document.querySelectorAll("[data-sel]").forEach(function(c){
      c.onchange = function(){
        state.selectedEntregas[c.dataset.sel] = c.checked;
        updateBulkbar();
      };
    });
    $("ent-selall").onchange = function(){
      var checked = this.checked;
      document.querySelectorAll("[data-sel]").forEach(function(c){
        c.checked = checked;
        state.selectedEntregas[c.dataset.sel] = checked;
      });
      updateBulkbar();
    };
    $("ent-clearsel").onclick = function(){
      state.selectedEntregas = {};
      document.querySelectorAll("[data-sel]").forEach(function(c){c.checked=false;});
      $("ent-selall").checked = false;
      updateBulkbar();
    };
    $("ent-bulkdel").onclick = function(){
      var ids = Object.keys(state.selectedEntregas).filter(function(k){return state.selectedEntregas[k];});
      if(ids.length===0) return;
      // Conta quantas assinadas (afetam estoque)
      var assinadas = state.entregas.filter(function(e){return state.selectedEntregas[e.id] && e.status==="assinado";}).length;
      var msg = "Excluir "+ids.length+" entrega(s)?\n\n";
      if(assinadas>0){
        msg += "• "+assinadas+" estão ASSINADAS — os PDFs serão apagados e o estoque RESTAURADO\n";
        msg += "• "+(ids.length-assinadas)+" pendentes — só removidas\n\n";
      }
      msg += "Confirma?";
      if(!confirm(msg)) return;
      var btn = this; btn.disabled = true; btn.textContent = "Excluindo…";
      var done = 0, errs = 0, restored = 0;
      Promise.all(ids.map(function(id){
        return fetch(BACKEND+"/entregas/"+id, {method:"DELETE"})
          .then(function(r){ if(!r.ok) throw new Error("HTTP "+r.status); return r.json(); })
          .then(function(d){ done++; if(d.estoque_restaurado) restored += d.estoque_restaurado; })
          .catch(function(){ errs++; });
      })).then(function(){
        var info = done+" entrega(s) excluída(s).";
        if(restored>0) info += " "+restored+" linha(s) de estoque restauradas.";
        if(errs>0) info += " "+errs+" falharam.";
        alert(info);
        state.selectedEntregas = {};
        loadAll().then(render);
      });
    };
    updateBulkbar();
    document.querySelectorAll("[data-link]").forEach(function(b){
      b.onclick = function(){
        var url = location.origin + "/rh-assinar.html?t=" + b.dataset.link;
        navigator.clipboard.writeText(url).then(function(){ b.textContent = "✓ Copiado!"; setTimeout(function(){b.textContent="Copiar link";},2000); });
      };
    });
    document.querySelectorAll("[data-pdf]").forEach(function(b){
      b.onclick = function(){
        b.textContent = "..."; b.disabled = true;
        fetch(BACKEND+"/entregas/"+b.dataset.pdf+"/pdf").then(function(r){return r.json();})
          .then(function(d){ if(d.url) window.open(d.url,"_blank"); b.textContent="Baixar PDF"; b.disabled=false; })
          .catch(function(){ b.textContent="Erro"; });
      };
    });
    document.querySelectorAll("[data-del]").forEach(function(b){
      b.onclick = function(){
        var st = b.dataset.status;
        var msg = st==="assinado"
          ? "Excluir esta entrega ASSINADA?\n\n• O termo PDF será apagado\n• O estoque dos itens será RESTAURADO (devolve as quantidades)\n• A linha será removida\n\nConfirma?"
          : "Excluir esta entrega pendente?";
        if(!confirm(msg)) return;
        b.disabled = true; b.textContent = "...";
        fetch(BACKEND+"/entregas/"+b.dataset.del, {method:"DELETE"})
          .then(function(r){ if(!r.ok) return r.text().then(function(t){throw new Error(t);}); return r.json(); })
          .then(function(d){
            var info = "Entrega excluída.";
            if(d.estoque_restaurado>0) info += " " + d.estoque_restaurado + " linha(s) de estoque restauradas.";
            alert(info);
            loadAll().then(render);
          })
          .catch(function(e){ alert("Erro: "+e.message); b.disabled=false; b.textContent="×"; });
      };
    });
  }

  // ─── Modal Nova Entrega ───
  function openNovaEntrega(){
    var modal = document.createElement("div");
    modal.className = "modal-overlay";
    var funcoes = Array.from(new Set(state.funcionarios.map(function(f){return f.funcao;}).filter(Boolean))).sort();
    var locais = Array.from(new Set(state.funcionarios.map(function(f){return f.local;}).filter(Boolean))).sort();
    modal.innerHTML =
      '<div class="modal">'+
        '<h2>Nova entrega de EPI</h2>'+
        '<div style="background:#0f0f0f;border:1px solid #1f1f1f;border-radius:6px;padding:10px;margin-bottom:12px">'+
          '<div style="font-size:10px;color:#888;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px">Filtrar funcionários</div>'+
          '<div style="display:grid;grid-template-columns:1fr 1fr 2fr;gap:8px">'+
            '<select id="ne-flt-func"><option value="">Todas funções</option>'+funcoes.map(function(f){return '<option value="'+f+'">'+f+'</option>';}).join("")+'</select>'+
            '<select id="ne-flt-local"><option value="">Todos locais</option>'+locais.map(function(l){return '<option value="'+l+'">'+l+'</option>';}).join("")+'</select>'+
            '<input id="ne-flt-q" placeholder="Buscar por nome..." />'+
          '</div>'+
        '</div>'+
        '<div class="form-grid">'+
          '<div class="full"><label>Funcionário <span id="ne-count" style="color:#B8AA9A;margin-left:6px"></span></label><select id="ne-func" size="6" style="height:auto;font-family:inherit"></select></div>'+
          '<div><label>Empresa</label><select id="ne-emp"></select></div>'+
          '<div><label>Local da entrega</label><input id="ne-local" placeholder="ex: SP" /></div>'+
          '<div><label>Entregue por (RH)</label><input id="ne-rh" /></div>'+
          '<div><label>Data</label><input id="ne-data" type="date" /></div>'+
          '<div class="full"><label>Observação</label><input id="ne-obs" /></div>'+
        '</div>'+
        '<h2 style="margin-top:14px">Itens</h2>'+
        '<div id="ne-itens"></div>'+
        '<button class="ghost" id="ne-add-item" style="margin-top:6px">+ Adicionar item</button>'+
        '<div class="row" style="margin-top:18px;justify-content:flex-end">'+
          '<button class="ghost" id="ne-cancel">Cancelar</button>'+
          '<button id="ne-save">Criar entrega + gerar link</button>'+
        '</div>'+
      '</div>';
    document.body.appendChild(modal);

    var fSel = $("ne-func");
    var eSel = $("ne-emp");
    state.empresas.forEach(function(e){
      eSel.appendChild(el('<option value="'+e.id+'">'+escape(e.nome)+'</option>'));
    });
    $("ne-data").value = new Date().toISOString().slice(0,10);

    function applyFuncFilter(){
      var fltFunc = $("ne-flt-func").value;
      var fltLocal = $("ne-flt-local").value;
      var fltQ = ($("ne-flt-q").value || "").toLowerCase().trim();
      var matches = state.funcionarios.filter(function(f){
        if(!f.ativo && f.ativo!==undefined && f.ativo!==null && f.ativo===false) return false;
        if(fltFunc && f.funcao!==fltFunc) return false;
        if(fltLocal && f.local!==fltLocal) return false;
        if(fltQ && (f.nome||"").toLowerCase().indexOf(fltQ)===-1) return false;
        return true;
      });
      fSel.innerHTML = "";
      if(matches.length===0){
        fSel.appendChild(el('<option disabled>— Nenhum funcionário encontrado —</option>'));
      } else {
        matches.forEach(function(f){
          fSel.appendChild(el('<option value="'+f.id+'">'+escape(f.nome)+'  ·  '+escape(f.funcao||"")+'  ·  '+escape(f.local||"")+'</option>'));
        });
        fSel.value = matches[0].id;
      }
      $("ne-count").textContent = "(" + matches.length + ")";
      fSel.onchange();
    }

    $("ne-flt-func").onchange = applyFuncFilter;
    $("ne-flt-local").onchange = applyFuncFilter;
    $("ne-flt-q").oninput = applyFuncFilter;

    fSel.onchange = function(){
      var f = state.funcionarios.find(function(x){return x.id===fSel.value;});
      if(f){ if(f.local) $("ne-local").value = f.local; if(f.empresa_id) eSel.value = f.empresa_id; }
    };
    applyFuncFilter();

    var itens = [];
    function addItemRow(){
      itens.push({item_id:"", tamanho:"", qty:1});
      renderItens();
    }
    function renderItens(){
      $("ne-itens").innerHTML = itens.map(function(it,i){
        var opts = state.itens.map(function(c){return '<option value="'+c.id+'"'+(it.item_id===c.id?' selected':'')+'>'+escape(c.nome)+(c.ca_numero&&c.ca_numero!=="NA"?' (CA '+escape(c.ca_numero)+')':'')+'</option>';}).join("");
        return '<div class="item-row">'+
          '<select data-i="'+i+'" data-k="item_id"><option value="">— selecione —</option>'+opts+'</select>'+
          '<input data-i="'+i+'" data-k="tamanho" placeholder="Tamanho (P/M/G/40/...)" value="'+escape(it.tamanho)+'" />'+
          '<input data-i="'+i+'" data-k="qty" type="number" min="1" value="'+it.qty+'" />'+
          '<button class="danger" data-rm="'+i+'">×</button>'+
        '</div>';
      }).join("");
      $("ne-itens").querySelectorAll("[data-i]").forEach(function(inp){
        inp.onchange = function(){ var i=+inp.dataset.i, k=inp.dataset.k; itens[i][k] = (k==="qty") ? (+inp.value||1) : inp.value; };
      });
      $("ne-itens").querySelectorAll("[data-rm]").forEach(function(b){
        b.onclick = function(){ itens.splice(+b.dataset.rm,1); renderItens(); };
      });
    }
    addItemRow();
    $("ne-add-item").onclick = addItemRow;
    $("ne-cancel").onclick = function(){ document.body.removeChild(modal); };
    $("ne-save").onclick = function(){
      var validItens = itens.filter(function(i){ return i.item_id; });
      if(validItens.length===0){ alert("Adicione pelo menos 1 item"); return; }
      var btn = this; btn.disabled = true; btn.textContent = "Criando…";
      var body = {
        funcionario_id: fSel.value,
        empresa_id: eSel.value || null,
        local: $("ne-local").value.trim(),
        entregue_por: $("ne-rh").value.trim(),
        data_entrega: $("ne-data").value,
        observacao: $("ne-obs").value.trim(),
        itens: validItens.map(function(i){ return {item_id:i.item_id, tamanho:i.tamanho, qty:i.qty}; }),
      };
      fetch(BACKEND+"/entregas", {method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(body)})
        .then(function(r){ if(!r.ok) return r.text().then(function(t){throw new Error(t);}); return r.json(); })
        .then(function(d){
          var link = location.origin + "/rh-assinar.html?t=" + d.entrega.signature_token;
          navigator.clipboard.writeText(link).then(function(){
            alert("Entrega criada!\n\nLink de assinatura copiado:\n"+link);
            document.body.removeChild(modal);
            loadAll().then(render);
          });
        }).catch(function(e){ alert("Erro: "+e.message); btn.disabled=false; btn.textContent="Criar entrega + gerar link"; });
    };
  }

