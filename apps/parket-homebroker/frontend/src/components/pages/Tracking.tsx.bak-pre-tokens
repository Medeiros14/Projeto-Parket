// ─── Painel de tarefas (admin) — criar/listar/cancelar tarefas delegadas ──
type TrackingTask = {
  id: string;
  created_by: string;
  assigned_to: string;
  title: string;
  description: string | null;
  target_count: number;
  current_count: number;
  due_date: string | null;
  status: "open" | "completed" | "cancelled";
  created_at: string;
  completed_at: string | null;
  updates: any[] | null;
};

function TarefasAdminPanel({ appUser, vendedores }: { appUser: AppUser; vendedores: string[] }) {
  const { T } = useTheme();
  const [tasks, setTasks] = useState<TrackingTask[]>([]);
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);
  const [filterStatus, setFilterStatus] = useState<"open" | "completed" | "all">("open");

  // Form state
  const [fTitle, setFTitle] = useState("");
  const [fDesc, setFDesc] = useState("");
  const [fTarget, setFTarget] = useState("1");
  const [fDue, setFDue] = useState<string>(todayYmd());
  const [fAssignees, setFAssignees] = useState<Set<string>>(new Set());
  const [submitting, setSubmitting] = useState(false);

  const reload = async () => {
    setLoading(true);
    let q = supabase.from("tracking_tasks")
      .select("*")
      .order("due_date", { ascending: true, nullsFirst: false })
      .order("created_at", { ascending: false })
      .limit(500);
    if (filterStatus !== "all") q = q.eq("status", filterStatus);
    const r = await q;
    if (r.error) { setErr(r.error.message); setTasks([]); }
    else { setTasks((r.data as TrackingTask[]) || []); setErr(null); }
    setLoading(false);
  };

  useEffect(() => { reload(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [filterStatus]);

  const resetForm = () => {
    setFTitle(""); setFDesc(""); setFTarget("1");
    setFDue(todayYmd()); setFAssignees(new Set());
  };

  const submit = async () => {
    const title = fTitle.trim();
    if (!title) { alert("Título obrigatório"); return; }
    if (fAssignees.size === 0) { alert("Escolha pelo menos um vendedor"); return; }
    const target = Math.max(1, Number(fTarget) || 1);
    setSubmitting(true);
    try {
      const rows = [...fAssignees].map((vend) => ({
        created_by: appUser.nome || appUser.email,
        assigned_to: vend,
        title,
        description: fDesc.trim() || null,
        target_count: target,
        current_count: 0,
        due_date: fDue || null,
        status: "open",
      }));
      const r = await supabase.from("tracking_tasks").insert(rows);
      if (r.error) { alert("Erro: " + r.error.message); return; }
      setShowForm(false); resetForm();
      await reload();
    } finally { setSubmitting(false); }
  };

  const cancelTask = async (id: string) => {
    if (!confirm("Cancelar essa tarefa?")) return;
    const r = await supabase.from("tracking_tasks").update({ status: "cancelled" }).eq("id", id);
    if (r.error) { alert("Erro: " + r.error.message); return; }
    reload();
  };

  const deleteTask = async (id: string) => {
    if (!confirm("Apagar tarefa (não pode desfazer)?")) return;
    const r = await supabase.from("tracking_tasks").delete().eq("id", id);
    if (r.error) { alert("Erro: " + r.error.message); return; }
    reload();
  };

  // Agrupa por vendedor
  const grouped = useMemo(() => {
    const g = new Map<string, TrackingTask[]>();
    tasks.forEach((t) => {
      const arr = g.get(t.assigned_to) || [];
      arr.push(t); g.set(t.assigned_to, arr);
    });
    return [...g.entries()].sort((a, b) => a[0].localeCompare(b[0]));
  }, [tasks]);

  return (
    <div style={{ flex: 1, overflow: "auto", padding: "12px 14px" }}>
      {/* Toolbar: novo + filtro */}
      <div style={{ display: "flex", gap: 8, marginBottom: 12, alignItems: "center" }}>
        <BigButton onClick={() => setShowForm((v) => !v)} variant="primary" small icon={<Sparkles size={11} />}>
          {showForm ? "FECHAR" : "NOVA TAREFA"}
        </BigButton>
        <NativeSelect value={filterStatus} onChange={(v) => setFilterStatus(v as any)} style={{ flex: 1, minWidth: 140 }}>
          <option value="open">ABERTAS · {tasks.filter((t) => t.status === "open").length}</option>
          <option value="completed">CONCLUÍDAS</option>
          <option value="all">TODAS</option>
        </NativeSelect>
      </div>

      {/* Formulário inline */}
      {showForm && (
        <div style={{ marginBottom: 12, padding: "14px 16px", border: `1px solid ${T.borderHover}`, backgroundColor: T.surface }}>
          <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textPrimary, marginBottom: 10, fontWeight: 700 }}>
            DELEGAR NOVA TAREFA
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            <FormField label="TÍTULO">
              <input value={fTitle} onChange={(e) => setFTitle(e.target.value)}
                placeholder="Fazer 5 conexões com arquitetos"
                style={formInputStyle(T)} />
            </FormField>
            <FormField label="DESCRIÇÃO · OPCIONAL">
              <textarea value={fDesc} onChange={(e) => setFDesc(e.target.value)}
                rows={2} placeholder="Detalhes, instruções, contexto..."
                style={formInputStyle(T)} />
            </FormField>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
              <FormField label="META · QUANTIDADE">
                <input type="number" min={1} value={fTarget} onChange={(e) => setFTarget(e.target.value)}
                  style={formInputStyle(T)} />
              </FormField>
              <FormField label="PRAZO">
                <input type="date" value={fDue} onChange={(e) => setFDue(e.target.value)}
                  style={formInputStyle(T)} />
              </FormField>
            </div>
            <FormField label={`DELEGAR PARA · ${fAssignees.size} SELECIONADOS`}>
              <div style={{
                display: "flex", flexWrap: "wrap", gap: 4,
                maxHeight: 200, overflow: "auto",
                padding: 8, border: `1px solid ${T.border}`, backgroundColor: T.bg,
              }}>
                <button type="button" onClick={() => setFAssignees(new Set(vendedores))} style={smallChipStyle(T, fAssignees.size === vendedores.length)}>
                  TODOS
                </button>
                <button type="button" onClick={() => setFAssignees(new Set())} style={smallChipStyle(T, false)}>
                  LIMPAR
                </button>
                {vendedores.map((v) => {
                  const on = fAssignees.has(v);
                  return (
                    <button type="button" key={v} onClick={() => {
                      setFAssignees((prev) => {
                        const next = new Set(prev);
                        on ? next.delete(v) : next.add(v);
                        return next;
                      });
                    }} style={smallChipStyle(T, on)}>
                      {v.toUpperCase()}
                    </button>
                  );
                })}
              </div>
            </FormField>
            <div style={{ display: "flex", gap: 8, marginTop: 4 }}>
              <BigButton onClick={submit} disabled={submitting} loading={submitting} variant="primary">
                {submitting ? "CRIANDO" : `CRIAR · ${fAssignees.size} TAREFA${fAssignees.size === 1 ? "" : "S"}`}
              </BigButton>
              <BigButton onClick={() => { setShowForm(false); resetForm(); }} disabled={submitting} variant="ghost">
                CANCELAR
              </BigButton>
            </div>
          </div>
        </div>
      )}

      {loading ? (
        <div style={{ textAlign: "center", padding: "40px 0", color: T.textMuted, fontFamily: FONT_BODY, fontSize: 10, letterSpacing: "0.18em", textTransform: "uppercase" }}>
          <Loader2 size={20} style={{ animation: "spin 1s linear infinite", color: CHAI }} />
        </div>
      ) : err ? (
        <div style={{ color: WALNUT, fontFamily: FONT_BODY, fontSize: 10, padding: 12, letterSpacing: "0.06em" }}>⚠ {err}</div>
      ) : grouped.length === 0 ? (
        <div style={{
          textAlign: "center", padding: "60px 0",
          fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.20em",
          color: T.textMuted, textTransform: "uppercase",
        }}>NENHUMA TAREFA</div>
      ) : (
        grouped.map(([vendedor, ts]) => {
          const openCount = ts.filter((t) => t.status === "open").length;
          return (
            <div key={vendedor} style={{ marginBottom: 18 }}>
              <div style={{
                display: "flex", alignItems: "center", gap: 8,
                paddingBottom: 6, marginBottom: 8,
                borderBottom: `1px solid ${T.border}`,
              }}>
                <div style={{ width: 3, height: 12, backgroundColor: CHAI }} />
                <div style={{ fontFamily: FONT_BODY, fontSize: 10, letterSpacing: "0.20em", color: T.textPrimary, textTransform: "uppercase", fontWeight: 600 }}>
                  {vendedor.toUpperCase()}
                </div>
                <div style={{ marginLeft: "auto", fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.18em", color: T.textMuted, textTransform: "uppercase" }}>
                  {openCount} ABERTAS · {ts.length} TOTAL
                </div>
              </div>
              {ts.map((t) => (
                <TaskRow key={t.id} task={t} onCancel={() => cancelTask(t.id)} onDelete={() => deleteTask(t.id)} />
              ))}
            </div>
          );
        })
      )}
    </div>
  );
}

function TaskRow({ task, onCancel, onDelete }: { task: TrackingTask; onCancel: () => void; onDelete: () => void }) {
  const { T } = useTheme();
  const pct = task.target_count > 0 ? Math.min(100, Math.round((task.current_count / task.target_count) * 100)) : 0;
  const done = task.status === "completed" || pct >= 100;
  const cancelled = task.status === "cancelled";
  const overdue = !done && !cancelled && task.due_date && task.due_date < todayYmd();

  return (
    <div style={{
      padding: "12px 14px", marginBottom: 6,
      border: `1px solid ${overdue ? WALNUT : T.border}`,
      backgroundColor: T.surface,
      opacity: cancelled ? 0.5 : 1,
    }}>
      <div style={{ display: "flex", gap: 10, alignItems: "flex-start", marginBottom: 6 }}>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{ fontFamily: FONT_BODY, fontSize: 12, fontWeight: 500, color: T.textPrimary, letterSpacing: "0.02em" }}>
            {task.title}
          </div>
          {task.description && (
            <div style={{ fontFamily: FONT_BODY, fontSize: 10, color: T.textSecondary, marginTop: 3, lineHeight: 1.5 }}>
              {task.description}
            </div>
          )}
        </div>
        <div style={{ display: "flex", gap: 4, flexShrink: 0 }}>
          {!cancelled && !done && (
            <button onClick={onCancel} title="Cancelar tarefa" style={iconBtnStyle(T)}>
              <X size={11} />
            </button>
          )}
          <button onClick={onDelete} title="Apagar" style={{ ...iconBtnStyle(T), color: WALNUT }}>
            <XCircle size={11} />
          </button>
        </div>
      </div>

      {/* Status / progresso */}
      <div style={{ display: "flex", alignItems: "center", gap: 10, fontSize: 9, fontFamily: FONT_BODY, letterSpacing: "0.10em", color: T.textMuted, textTransform: "uppercase" }}>
        {task.due_date && (
          <span style={{ color: overdue ? WALNUT : T.textSecondary }}>
            {overdue ? "⚠ ATRASADA · " : "PRAZO "}{task.due_date}
          </span>
        )}
        {cancelled && <span style={{ color: WALNUT, fontWeight: 700 }}>CANCELADA</span>}
        {done && !cancelled && <span style={{ color: CHAI, fontWeight: 700 }}>✓ CONCLUÍDA</span>}
      </div>

      {/* Barra de progresso */}
      {!cancelled && (
        <div style={{ marginTop: 8 }}>
          <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 3, fontFamily: FONT_BODY, fontSize: 9, letterSpacing: "0.08em", color: T.textMuted }}>
            <span>PROGRESSO</span>
            <span style={{ color: done ? CHAI : T.textPrimary, fontWeight: 600 }}>
              {task.current_count} / {task.target_count}
            </span>
          </div>
          <div style={{ height: 4, backgroundColor: T.border, position: "relative" }}>
            <div style={{
              position: "absolute", top: 0, left: 0, bottom: 0,
              width: `${pct}%`,
              backgroundColor: done ? CHAI : CHAI,
              opacity: done ? 1 : 0.6,
              transition: "width 0.3s",
            }} />
          </div>
        </div>
      )}
    </div>
  );
}

function FormField({ label, children }: { label: string; children: React.ReactNode }) {
  const { T } = useTheme();
  return (
    <div>
      <div style={{ fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.22em", color: T.textMuted, marginBottom: 4, textTransform: "uppercase", fontWeight: 600 }}>
        {label}
      </div>
      {children}
    </div>
  );
}

function formInputStyle(T: Theme): React.CSSProperties {
  return {
    width: "100%", padding: "8px 10px",
    fontFamily: FONT_BODY, fontSize: 11, color: T.textPrimary,
    backgroundColor: T.bg, border: `1px solid ${T.border}`, outline: "none",
  };
}

function smallChipStyle(T: Theme, active: boolean): React.CSSProperties {
  return {
    padding: "4px 9px",
    backgroundColor: active ? CHAI : "transparent",
    border: `1px solid ${active ? CHAI : T.border}`,
    color: active ? T.onPrimary : T.textSecondary,
    fontFamily: FONT_BODY, fontSize: 8, letterSpacing: "0.16em", fontWeight: 600,
    textTransform: "uppercase", cursor: "pointer",
  };
}

function iconBtnStyle(T: Theme): React.CSSProperties {
