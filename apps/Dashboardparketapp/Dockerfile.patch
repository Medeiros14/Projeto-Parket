# ══════════════════════════════════════════════════════════════
#  PATCH BUILD — aplica mudancas de codigo sobre a golden
#  
#  A golden funcional esta em dist_golden/ (extraida da imagem
#  parket-dashboard:real-golden-15setores).
#
#  Este Dockerfile:
#  1. Faz npm build do codigo fonte atual
#  2. Parte da golden funcional (nginx)
#  3. Copia APENAS os chunks que mudaram por cima
#
#  Uso:
#    cd /root/Dashboardparketapp
#    npm run build
#    docker build -f Dockerfile.patch -t parket-dashboard:staging .
#    ./deploy-dashboard.sh parket-dashboard:staging
# ══════════════════════════════════════════════════════════════

ARG GOLDEN=parket-dashboard:real-golden-15setores

# Stage 1: rebuild apenas os arquivos que mudaram
FROM node:20-alpine AS builder
RUN npm install -g pnpm@9
WORKDIR /app
COPY package.json ./
RUN pnpm add react@18.3.1 react-dom@18.3.1 --save-peer || true
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm build

# Stage 2: partir da golden e aplicar o build por cima
FROM ${GOLDEN} AS base
# Sobrescrever com o build fresco (index.html + assets atualizados)
COPY --from=builder /app/dist/ /usr/share/nginx/html/
