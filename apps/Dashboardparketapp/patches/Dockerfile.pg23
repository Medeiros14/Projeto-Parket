FROM parket-dashboard:golden-squash-20260617-1344
COPY propostaGenerator-PGSTRUCT23.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT23.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec sed -i 's|propostaGenerator-PGSTRUCT2[012]\.js|propostaGenerator-PGSTRUCT23.js|g' {} +
RUN sed -i "s|'/assets/propostaGenerator-PGSTRUCT2[012].js'|'/assets/propostaGenerator-PGSTRUCT23.js'|g" /usr/share/nginx/html/index.html
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-pg23-rodape-sem-negrito'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
