// custo-orcamento-modal-pkt1.js
// ────────────────────────────────────────────────────────────────────
// Gera FICHA HTML print-friendly de Custo de Orçamento.
//
// Lógica de INSUMOS herdada do handler antigo "Ficha de Insumos":
//   - PORTA: lê `orcamento_tabela_precos.dimensao_obs` + `insumos_precos`
//     pra montar lista de insumos específicos da porta (kit ferragens,
//     parafusos, dobradiças etc).
//   - PISO/FORRO/DECK/PAINEL: lê `orcamento_insumos_grade` por bloco e
//     multiplica `qtd_por_unidade × m² do ambiente × custo_unit`.
//
// Adicional NOVO — MÃO DE OBRA (instalação):
//   - Lê `orcamento_instalacao_precos` (tabela do PDF do user).
//   - Defaults por categoria: PISO RETO 27, FORRO FINCAPINO 35 +
//     REVESTIMENTO RIPADO 70, DECK C/ESTRUTURA 67, PAINEL C/ESTRUTURA
//     70, RODAPÉ 20/ml.
//
// Totais: Insumos (custo fab) + MDO (custo instalação) = CUSTO TOTAL.
//         Venda - Custo Total = Margem.
//
// Expõe `window.__pkt_openCustoOrcamento({simulacao, itens?, onSaved?})`.
// ────────────────────────────────────────────────────────────────────
import { s as supabase } from "./index-DZtetJYP.js";

const _brl = (v) => "R$ " + (Number(v) || 0).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

function _normCat(c) { return String(c || "").split("||")[0].trim().toUpperCase(); }
function _getM2(d) {
  const m = (d || "").match(/metragem.*?([\d.,]+)\s*m/i);
  if (!m) return 0;
  const v = parseFloat(m[1].replace(",", "."));
  return Number.isFinite(v) ? v : 0;
}
function _getMtl(d) {
  const m = (d || "").match(/(\d{1,5}(?:[.,]\d{1,3})?)\s*(?:ml|mtl|m\.l)\b/i);
  return m ? parseFloat(m[1].replace(",", ".")) : 0;
}
function _isAux(d) {
  const u = ((d || "").split("\n")[0] || "").toUpperCase().trim();
  return u.startsWith("INSTALAÇÃO") || u.startsWith("INSTALACAO") ||
         u.startsWith("INSUMOS DE") || u === "INSUMOS" ||
         u.startsWith("RECORTES") || u.startsWith("RODAP");
}
function _cleanCat(s) {
  return (s || "").replace(/^[A-ZÇÁÉÍÓÚÀÂÊÔÃÕ]+\|\|/, "").replace(/\|\|/g, " ").trim() || (s || "") || "—";
}

const ORDER = ["PORTA", "PISO", "PAINEL", "FORRO", "DECK", "SAUNA", "REVESTIMENTO", "ESCADA", "RODAPÉ", "RODAPE", "LOGISTICA", "LOGÍSTICA", "COMPRAS", "OUTROS"];

// Mapeamento categoria → bloco de insumos da `orcamento_insumos_grade`.
// (Default mais comum — futuramente pode ler subtipo do item pra escolher
// bloco específico tipo `pisos_chevron` vs `pisos_ate_19`.)
const CAT2BLOCO = {
  FORRO: "forro_fincapino",
  PISO: "pisos_ate_19",
  DECK: "deck_madeira_25x10",
  SAUNA: "deck_madeira_25x10",
  PAINEL: "paineis",
  REVESTIMENTO: "paineis",
  RODAPÉ: "rodape_cordao",
  RODAPE: "rodape_cordao",
};

// Defaults de mão de obra por categoria (PDF tabela PARKET)
const MDO_DEFAULTS = {
  PISO: ["PISO RETO"],
  FORRO: ["ESTRUTURA DE FORRO (FINCA PINO)", "REVESTIMENTO FORRO (RIPADO)"],
  DECK: ["DECK C/ ESTRUTURA"],
  PAINEL: ["PAINEL COM ESTRUTURA"],
  RODAPÉ: ["RODAPÉ"],
  RODAPE: ["RODAPÉ"],
};

function _findMdoPreco(precos, categoria, servico) {
  const cat = _normCat(categoria);
  const want = String(servico || "").toUpperCase().replace(/\s+/g, "");
  for (const p of precos) {
    if (_normCat(p.categoria) !== cat) continue;
    if (String(p.servico).toUpperCase().replace(/\s+/g, "") === want) return p;
  }
  return null;
}

async function openCustoOrcamento(opts) {
  const { simulacao, itens: itensInline, onSaved } = opts || {};
  const sim = simulacao || {};
  if (!sim.id) {
    alert("Simulação inválida — recarregue a página.");
    return;
  }

  // ── Carrega itens (busca via supabase se não vier inline) ──
  let itens = Array.isArray(itensInline) && itensInline.length > 0 ? itensInline : null;
  if (!itens) {
    const { data: rows, error } = await supabase
      .from("simulacao_itens")
      .select("*")
      .eq("simulacao_id", sim.id)
      .order("ordem");
    if (error) {
      alert("Erro ao buscar itens: " + error.message);
      return;
    }
    itens = rows || [];
  }
  console.log("[CustoOrcamento] itens:", itens.length);

  // ── Carrega catálogos em paralelo ──
  const [resDim, resInsPr, resGrade, resInstal] = await Promise.all([
    supabase.from("orcamento_tabela_precos").select("categoria,especie_nome,dimensao_label,dimensao_obs,tipo_porta,subtipo,preco,atributos_extras").eq("ativo", true),
    supabase.from("insumos_precos").select("descricao,preco,unid_med").eq("ativo", true),
    supabase.from("orcamento_insumos_grade").select("bloco_id,codigo,descricao,und,qtd_por_unidade,custo_unit").eq("ativo", true).order("ordem"),
    supabase.from("orcamento_instalacao_precos").select("*").eq("ativo", true).order("categoria").order("ordem"),
  ]);
  const dimRows = resDim.data || [];
  const insPrRows = resInsPr.data || [];
  const gradeRows = resGrade.data || [];
  const instalRows = resInstal.data || [];
  console.log("[CustoOrcamento] dim:", dimRows.length, "insumos_precos:", insPrRows.length, "grade:", gradeRows.length, "instalacao:", instalRows.length);

  // Mapa de preço por nome de insumo (upper) — pra PORTA
  const pricesMap = new Map();
  for (const pr of insPrRows) {
    pricesMap.set((pr.descricao || "").toUpperCase(), {
      preco: parseFloat(pr.preco) || 0,
      unid_med: pr.unid_med || "UN",
    });
  }
  // Grade de insumos por bloco_id
  const gradeByBloco = new Map();
  for (const it of gradeRows) {
    if (!gradeByBloco.has(it.bloco_id)) gradeByBloco.set(it.bloco_id, []);
    gradeByBloco.get(it.bloco_id).push(it);
  }

  // ── Monta seções (PORTA/PISO/FORRO/...) ──
  const sections = new Map();
  const getSec = (c) => {
    if (!sections.has(c)) sections.set(c, { insumos: new Map(), produtos: [], totalM2: 0, totalMtl: 0, vendaTotal: 0 });
    return sections.get(c);
  };
  let totalVendaBruto = 0;
  // Descontos calculados à moda do card: desconto da simulação +
  // desconto por item, ambos só sobre itens NÃO auxiliares (INSUMOS/
  // INSTAL/LOGÍSTICA/MAO). Mantém compatibilidade com o valor mostrado
  // no card da listagem.
  const auxRegex = /INSUMOS?|INSTAL|LOG[IÍ]STICA|MAO|MÃO/i;
  let descSim = 0;
  let descItem = 0;
  const descPercSim = Number(sim.desconto_perc) || 0;

  for (const o of itens) {
    const catU = String(o.categoria || "").toUpperCase();
    const descU = (o.descritivo || "").toUpperCase();
    let catBase = "OUTROS";
    for (const c of ORDER) {
      if (c !== "OUTROS" && catU.startsWith(c)) { catBase = c; break; }
    }
    const sec = getSec(catBase);
    const amb = (o.descritivo || "").split("\n")[0] || "—";
    const modelo = _cleanCat(catU);
    const valor = Number(o.valor) || 0;
    const m2 = _getM2(o.descritivo);
    const mtl = _getMtl(o.descritivo);
    const aux = _isAux(o.descritivo);
    if (m2 > 0 && !aux) sec.totalM2 += m2;
    if (mtl > 0 && !aux && (catBase === "RODAPÉ" || catBase === "RODAPE")) sec.totalMtl += mtl;
    sec.vendaTotal += valor;
    if (!aux) sec.produtos.push({ ambiente: amb, modelo, valor, m2 });
    totalVendaBruto += valor;
    if (!auxRegex.test(catU)) {
      descSim += valor * (descPercSim / 100);
      descItem += valor * ((Number(o.desconto_perc) || 0) / 100);
    }

    // PORTA: extrai insumos especiais via dimensao_obs
    if (catBase === "PORTA" && !aux) {
      let f = null;
      if (dimRows && catU) {
        const cand = dimRows.filter(re => {
          if (!re.dimensao_obs || re.dimensao_obs.length < 5) return false;
          const tp = (re.tipo_porta || "").toUpperCase();
          const ep = (re.especie_nome || "").toUpperCase();
          if (!tp || !ep) return false;
          const tpFirst = tp.split(/\s+/)[0];
          if (!catU.includes(tpFirst)) return false;
          const tpSuffix = (tp.match(/\b(WC|INTERNO|INTERNA|EXTERNA|BANHO)\b/) || [])[1] || "";
          const catSuffix = (catU.match(/\b(WC|INTERNO|INTERNA|EXTERNA|BANHO)\b/) || [])[1] || "";
          if (catSuffix && tpSuffix && catSuffix !== tpSuffix) return false;
          return true;
        });
        const scored = cand.map(re => {
          const tp = (re.tipo_porta || "").toUpperCase();
          const ep = (re.especie_nome || "").toUpperCase();
          const tpLast = tp.match(/\s+(WC|INTERNO|INTERNA|EXTERNA|BANHO)/);
          const tpSuffix = tpLast ? tpLast[1] : "";
          let score = (re.dimensao_obs || "").length;
          if (tpSuffix && catU.includes(tpSuffix)) score += 100000;
          if (ep && catU.includes(ep)) score += 200000;
          const subBrands = ["CIR", "GERIS", "ITALY LINE", "DN150", "RO82TOP", "3D"];
          for (const sb of subBrands) if (tp.includes(sb) && catU.includes(sb)) score += 300000;
          if (descU.includes("BANHEIR") || descU.includes("WC") || descU.includes("LAVABO")) {
            if (tpSuffix === "WC") score += 400000;
          }
          return { re, score };
        });
        scored.sort((a, b) => b.score - a.score);
        if (scored.length) f = scored[0].re;
      }
      if (f && f.dimensao_obs) {
        const raw = f.dimensao_obs;
        const sep = raw.includes("~") ? /~/ : /,\s*/;
        for (const re of raw.split(sep)) {
          let nome, q, unid;
          if (re.includes("|")) {
            const parts = re.split("|");
            nome = (parts[0] || "").trim();
            q = parseFloat(parts[1]) || 1;
            unid = (parts[2] || "UN").trim();
          } else {
            const br = re.match(/\[(\d+(?:\.\d+)?)\s*(UNI|UN|UNID|BARRAS|BARRA|UND)?\s*(POR\s*PORTA)?\s*\]/i);
            const pa = re.match(/\((\d+(?:\.\d+)?)\s*un\)/i);
            q = br ? parseFloat(br[1]) : pa ? parseFloat(pa[1]) : 1;
            nome = re.replace(/\[[^\]]*\]/g, "").replace(/\(\d+(?:\.\d+)?\s*un\)/i, "").trim();
            unid = "UN";
          }
          if (!nome) continue;
          let kNorm = nome.toUpperCase().replace(/–/g, "-").replace(/\s+/g, " ").trim();
          if (kNorm === "BUCHA 80MM") kNorm = "BUCHA 08MM";
          kNorm = kNorm.replace(/PORRTA/g, "PORTA");
          if (kNorm.length < 5 || kNorm === "LACA" || kNorm.startsWith("+") || kNorm.startsWith("ATÉ ") || kNorm.startsWith("ATE ")) continue;
          const k = kNorm;
          let pr = pricesMap.get(k);
          if (!pr) {
            const stripped = k.replace(/\s*\[.*$/, "").replace(/\s*–\s*.*$/, "").trim();
            pr = pricesMap.get(stripped);
          }
          if (!pr && k.startsWith("LAMINA NATURAL ")) pr = pricesMap.get("LAMINA NATURAL CARVALHO EUROPEU");
          if (!pr && k.startsWith("MADEIRA MACIÇA")) pr = pricesMap.get("MADEIRA MACIÇA TAUARI (0.02X0.20X3.00)");
          if (!pr) {
            for (const [pk, pv] of pricesMap) {
              const pkN = pk.replace(/–/g, "-").replace(/\s+/g, " ").trim();
              if (pkN === k) { pr = pv; break; }
            }
          }
          if (!pr) {
            for (const [pk, pv] of pricesMap) {
              const pkN = pk.replace(/–/g, "-").replace(/\s+/g, " ").trim();
              if (pkN.length > 12 && (k.includes(pkN) || pkN.includes(k))) { pr = pv; break; }
            }
          }
          const c = pr ? pr.preco : 0;
          if (pr && pr.unid_med) unid = pr.unid_med;
          if (sec.insumos.has(k)) {
            const e = sec.insumos.get(k);
            e.q += q;
            e.c = c;
            e.t = e.q * e.c;
          } else {
            sec.insumos.set(k, { p: nome, u: unid, q, c, t: q * c });
          }
        }
      }
      // ── Régua (insumo) cadastrada no produto ──
      const ax = f && f.atributos_extras ? f.atributos_extras : null;
      const reguaName = ax && (ax.regua || ax.Regua) ? String(ax.regua || ax.Regua).trim() : "";
      const qtdReguaM2 = ax ? parseFloat(ax.qtd_regua_m2 || ax.qtd_regua || 0) || 0 : 0;
      if (reguaName && qtdReguaM2 > 0) {
        // Quantas portas neste item (parse "1 Porta", "02 portas", etc.)
        const mQ = (o.descritivo || "").match(/^\s*(\d+)\s*porta/im);
        const nPortas = mQ ? parseInt(mQ[1], 10) : 1;
        // Preço da régua: tenta orcamento_tabela_precos por dimensao_label match
        const reguaNorm = reguaName.toUpperCase().replace(/\s+/g, " ").trim();
        const reguaRow = dimRows.find(re => {
          const dl = (re.dimensao_label || "").toUpperCase().replace(/\s+/g, " ").trim();
          return dl === reguaNorm;
        });
        const precoRegua = reguaRow ? (Number(reguaRow.preco) || 0) : 0;
        const qtdTotal = nPortas * qtdReguaM2;
        const kRegua = ("RÉGUA " + reguaName + " (PORTA)").toUpperCase();
        if (sec.insumos.has(kRegua)) {
          const e = sec.insumos.get(kRegua);
          e.q += qtdTotal;
          e.t = e.q * e.c;
        } else {
          sec.insumos.set(kRegua, { p: reguaName + " (régua p/ porta)", u: "M²", q: qtdTotal, c: precoRegua, t: qtdTotal * precoRegua });
        }
      }
    }
  }
  const totalVenda = totalVendaBruto - descSim - descItem;

  // Não-PORTA: aplica grade de insumos × m² (sobrescreve insumos)
  for (const [cat, sec] of sections) {
    if (cat === "PORTA") continue;
    const bloco = CAT2BLOCO[cat];
    if (!bloco) continue;
    const grade = gradeByBloco.get(bloco) || [];
    const qty = (cat === "RODAPÉ" || cat === "RODAPE") ? sec.totalMtl : sec.totalM2;
    if (qty <= 0 || grade.length === 0) continue;
    sec.insumos = new Map();
    for (const ins of grade) {
      const qpu = Number(ins.qtd_por_unidade) || 0;
      const cu = Number(ins.custo_unit) || 0;
      const qtd = qpu * qty;
      sec.insumos.set(ins.codigo, {
        codigo: ins.codigo,
        p: ins.descricao,
        u: ins.und || "UN",
        q: qtd, c: cu, t: qtd * cu,
      });
    }
  }

  let totalFab = 0;
  for (const sec of sections.values()) {
    for (const e of sec.insumos.values()) totalFab += e.t;
  }

  // ── Mão de Obra (defaults sobre m² agregado por categoria) ──
  const mdoByCat = new Map();
  let totalMdo = 0;
  for (const cat of Object.keys(MDO_DEFAULTS)) {
    const sec = sections.get(cat);
    if (!sec) continue;
    const qty = (cat === "RODAPÉ" || cat === "RODAPE") ? sec.totalMtl : sec.totalM2;
    if (qty <= 0) continue;
    for (const servico of MDO_DEFAULTS[cat]) {
      const p = _findMdoPreco(instalRows, cat, servico);
      if (!p) continue;
      const vu = Number(p.valor_unitario) || 0;
      const total = qty * vu;
      const catKey = _normCat(p.categoria);
      if (!mdoByCat.has(catKey)) mdoByCat.set(catKey, []);
      mdoByCat.get(catKey).push({ servico: p.servico, unidade: p.unidade, qtd: qty, vu, total });
      totalMdo += total;
    }
  }

  const custoTotal = totalFab + totalMdo;
  const margem = totalVenda - custoTotal;
  const margemPerc = totalVenda > 0 ? (margem / totalVenda * 100) : 0;
  console.log("[CustoOrcamento] insumos:", totalFab, "MDO:", totalMdo, "venda:", totalVenda);

  // ── Persiste meta (não-bloqueante) ──
  try {
    const mdoArr = [];
    for (const [, rows] of mdoByCat) {
      for (const r of rows) mdoArr.push({ ...r, valor_unit: r.vu });
    }
    const newMeta = {
      ...(sim.meta || {}),
      mao_de_obra: mdoArr,
      mao_de_obra_total: totalMdo,
      insumos_total: totalFab,
      custo_total: custoTotal,
      venda_total: totalVenda,
      custo_updated_at: new Date().toISOString(),
    };
    await supabase.from("simulacao_projetos").update({ meta: newMeta }).eq("id", sim.id);
    if (typeof onSaved === "function") { try { onSaved({ meta: newMeta }); } catch (_e) {} }
  } catch (e) {
    console.error("[CustoOrcamento] erro ao persistir meta:", e);
  }

  // ── Monta HTML — SEÇÕES por categoria ──
  let html = "";
  for (const cat of ORDER) {
    if (!sections.has(cat)) continue;
    const sec = sections.get(cat);
    if (sec.produtos.length === 0 && sec.vendaTotal === 0) continue;
    const secVenda = sec.vendaTotal;
    const secCusto = Array.from(sec.insumos.values()).reduce((s, e) => s + e.t, 0);
    const secMdo = (mdoByCat.get(cat) || []).reduce((s, r) => s + r.total, 0);
    const secCustoTotal = secCusto + secMdo;
    const secMargem = secVenda - secCustoTotal;
    const secMargemP = secVenda > 0 ? (secMargem / secVenda * 100) : 0;
    const showCodigo = Array.from(sec.insumos.values()).some(e => e.codigo);

    html += `<div class="catbox"><div class="cathead">${cat} <span class="catmeta">${sec.produtos.length} ${sec.produtos.length === 1 ? "item" : "itens"}${sec.totalM2 > 0 ? ` · ${sec.totalM2.toFixed(2)}m²` : ""}${sec.totalMtl > 0 ? ` · ${sec.totalMtl.toFixed(2)}ml` : ""}</span></div>`;

    // Tabela de produtos (orçamento)
    html += '<table class="prods"><thead><tr><th>#</th><th>Ambiente</th><th>Modelo</th><th>Valor</th></tr></thead><tbody>';
    let zp = 1;
    if (sec.produtos.length === 0) {
      html += '<tr><td colspan="4" class="empty">— Sem itens visíveis —</td></tr>';
    } else {
      for (const p of sec.produtos) {
        html += `<tr><td>${zp++}</td><td>${p.ambiente}</td><td>${p.modelo}</td><td>${_brl(p.valor)}</td></tr>`;
      }
    }
    html += '</tbody></table>';

    // Tabela de insumos (custo de fabricação)
    html += '<div class="subhead">Insumos (Custo de Fabricação)</div>';
    if (showCodigo) {
      html += '<table><thead><tr><th>#</th><th>Código</th><th>Descrição</th><th>UND</th><th>Qtde.</th><th>Custo Unit.</th><th>Total</th></tr></thead><tbody>';
      if (sec.insumos.size === 0) {
        html += '<tr><td colspan="7" class="empty">—</td></tr>';
      } else {
        let z = 1;
        for (const e of sec.insumos.values()) {
          const qf = (typeof e.q === "number") ? (Number.isInteger(e.q) ? e.q : e.q.toFixed(2)) : e.q;
          html += `<tr><td>${z++}</td><td>${e.codigo || ""}</td><td>${e.p}</td><td>${e.u}</td><td>${qf}</td><td>${_brl(e.c)}</td><td>${_brl(e.t)}</td></tr>`;
        }
      }
      html += '</tbody></table>';
    } else {
      html += '<table><thead><tr><th>#</th><th>Produto</th><th>UND</th><th>Qtde.</th><th>Custo Unit.</th><th>Total</th></tr></thead><tbody>';
      if (sec.insumos.size === 0) {
        html += '<tr><td colspan="6" class="empty">—</td></tr>';
      } else {
        let z = 1;
        for (const e of sec.insumos.values()) {
          html += `<tr><td>${z++}</td><td>${e.p}</td><td>${e.u}</td><td>${e.q}</td><td>${_brl(e.c)}</td><td>${_brl(e.t)}</td></tr>`;
        }
      }
      html += '</tbody></table>';
    }

    // Subtotais da categoria — só insumos (MDO calculada em background pra card)
    html += `<div class="secfoot"><span><strong>Insumos:</strong> ${_brl(secCusto)}</span></div>`;
    html += '</div>';
  }

  const numero = sim.numero || "—";
  const data = new Date().toLocaleDateString("pt-BR");

  const full = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Ficha de Insumos Nº ${numero}</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font:8pt 'Segoe UI',sans-serif;background:#fff;color:#1a1a1a}
.pg{width:210mm;min-height:297mm;margin:0 auto;padding:20pt 24pt}
.hd{display:flex;justify-content:space-between;border-bottom:2px solid #000;padding-bottom:10pt;margin-bottom:12pt}
.lo{font:700 20pt sans-serif;letter-spacing:2pt}
.em{text-align:right;font-size:7pt;line-height:1.4}
.inf{display:grid;grid-template-columns:1fr 1fr;gap:4pt 16pt;margin-bottom:12pt;font-size:7.5pt;border:1px solid #ccc;padding:8pt}
table{width:100%;border-collapse:collapse;font-size:7.5pt;margin-bottom:6pt}
th{background:#1a1a1a;color:#fff;padding:5pt 6pt;text-align:left;font-size:7pt}
