FROM parket-dashboard:golden-squash-20260617-1344
RUN sed -i 's|<script src="/catalogos.js" defer></script>||g' /usr/share/nginx/html/index.html && \
    rm -f /usr/share/nginx/html/catalogos.js
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-no-catalogos-overlay'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
