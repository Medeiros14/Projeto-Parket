FROM parket-dashboard:golden-squash-20260617-1344
COPY orcamento-simulador-tab-MARCFIX36.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX36.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec sed -i 's|orcamento-simulador-tab-MARCFIX35\.js|orcamento-simulador-tab-MARCFIX36.js|g' {} +
RUN sed -i "s|'/assets/orcamento-simulador-tab-MARCFIX35.js'|'/assets/orcamento-simulador-tab-MARCFIX36.js'|g" /usr/share/nginx/html/index.html
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260617-mf36-painel-sem-assoalho'|" /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
