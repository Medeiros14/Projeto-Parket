}

// ════════════════════════════════════════════════════════════════════════
// PIPELINE — Kanban do vendedor (colunas como /book/vendas) + botão Orçar
// ════════════════════════════════════════════════════════════════════════
const PIPELINE_COLS = [
  "novas-oportunidades",
  "contato-inicial",
  "em-briefing",
  "criacao-orcamento",
  "apresentacao-proposta",
  "em-negociacao",
] as const;
const PIPELINE_COL_COLOR: Record<string, string> = {
  "novas-oportunidades":   "#6B7280",
  "contato-inicial":       "#3B82F6",
  "em-briefing":           "#6366F1",
  "criacao-orcamento":     "#C8A14B",
  "apresentacao-proposta": "#F97316",
  "em-negociacao":         "#EC4899",
};

function PipelineView({ cards, appUser, T }: { cards: TrackingCard[]; appUser: AppUser; T: Theme }) {
  const [busca, setBusca] = useState("");
  const [orcCard, setOrcCard] = useState<TrackingCard | null>(null);

  const cardsByCol = useMemo(() => {
    const q = busca.trim().toLowerCase();
    const match = (c: TrackingCard) => {
      if (!q) return true;
      const d: any = c.details || {};
      return (c.title || "").toLowerCase().includes(q)
          || (d.cidade || "").toLowerCase().includes(q)
          || (d.celular || d.telefone || "").includes(q);
    };
    const map: Record<string, TrackingCard[]> = {};
    for (const col of PIPELINE_COLS) map[col] = [];
    for (const c of cards) {
      if (!match(c)) continue;
      const col = (c.column_id || "").toString();
      if (map[col]) map[col].push(c);
    }
    return map;
  }, [cards, busca]);

  const totalVisivel = useMemo(() =>
    Object.values(cardsByCol).reduce((s, arr) => s + arr.length, 0),
    [cardsByCol]
  );

  return (
    <div style={{ flex: 1, display: "flex", flexDirection: "column", background: T.bg, minHeight: 0 }}>
      {/* Toolbar busca */}
      <div style={{ padding: 12, display: "flex", gap: 8, borderBottom: `1px solid ${T.border}` }}>
        <input
          value={busca} onChange={(e) => setBusca(e.target.value)}
          placeholder="Buscar cliente, cidade ou telefone…"
          style={{
            flex: 1, padding: "8px 10px", background: T.surface, color: T.textPrimary,
            border: `1px solid ${T.border}`, fontSize: 12, fontFamily: FONT_BODY, outline: "none",
          }}
        />
        <div style={{ color: T.textMuted, fontSize: 10, alignSelf: "center", letterSpacing: "0.14em" }}>
          {totalVisivel}/{cards.length}
        </div>
      </div>

      {/* Kanban: scroll horizontal de colunas, cada coluna scroll vertical interno */}
      <div style={{ flex: 1, overflowX: "auto", overflowY: "hidden", padding: 12, display: "flex", gap: 10, minHeight: 0 }}>
        {PIPELINE_COLS.map((colSlug) => {
          const colCards = cardsByCol[colSlug] || [];
          const cor = PIPELINE_COL_COLOR[colSlug] || T.textMuted;
          const valorTotal = colCards.reduce((s, c) => s + (parseValueText(c.value) || 0), 0);
          return (
            <div key={colSlug} style={{
              flexShrink: 0, width: 260, display: "flex", flexDirection: "column",
              background: T.surface, border: `1px solid ${T.border}`, maxHeight: "100%",
            }}>
              {/* Header da coluna */}
              <div style={{ padding: "10px 12px", borderBottom: `1px solid ${T.border}` }}>
                <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                  <span style={{ display: "block", width: 3, height: 10, background: cor, flexShrink: 0 }} />
                  <span style={{
                    fontSize: 9, letterSpacing: "0.18em", textTransform: "uppercase",
                    fontWeight: 600, color: cor, fontFamily: FONT_BODY, flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap",
                  }} title={STAGE_LABEL[colSlug] || colSlug}>
                    {STAGE_LABEL[colSlug] || colSlug}
                  </span>
                  <span style={{
                    fontSize: 9, padding: "1px 6px", border: `1px solid ${T.border}`,
                    color: T.textSecondary, fontFamily: FONT_BODY,
                  }}>{colCards.length}</span>
                </div>
                {valorTotal > 0 && (
                  <div style={{ marginTop: 4, fontSize: 9, color: T.textPrimary, fontFamily: FONT_BODY }}>
                    {fmtBRL(valorTotal)}
                  </div>
                )}
              </div>

              {/* Lista vertical de cards */}
              <div style={{ flex: 1, overflowY: "auto", padding: 6, display: "flex", flexDirection: "column", gap: 4 }}>
                {colCards.length === 0 ? (
                  <div style={{ padding: 14, textAlign: "center", color: T.textMuted, fontSize: 9, letterSpacing: "0.18em", textTransform: "uppercase" }}>
                    Vazio
                  </div>
                ) : (
                  colCards.slice(0, 80).map((c) => {
                    const d: any = c.details || {};
                    const valor = parseValueText(c.value) || 0;
                    const cidade = d.cidade || d.endereco_obra || "";
                    return (
                      <div key={c.id} style={{
                        background: T.bg, border: `1px solid ${T.border}`, padding: 8,
                        display: "flex", flexDirection: "column", gap: 4,
                      }}>
                        <Link to={`/card/${c.id}`} style={{
                          color: T.textPrimary, fontSize: 11, fontWeight: 600,
                          fontFamily: FONT_BODY, textDecoration: "none",
                          overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap",
                        }} title={c.title || ""}>
                          {c.title || c.id.slice(0, 8)}
                        </Link>
                        {(cidade || valor > 0) && (
                          <div style={{ display: "flex", justifyContent: "space-between", gap: 6, fontSize: 9, color: T.textSecondary }}>
                            <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{cidade}</span>
                            {valor > 0 && <span style={{ color: T.textPrimary, flexShrink: 0 }}>{fmtBRL(valor)}</span>}
                          </div>
                        )}
                        <button onClick={() => setOrcCard(c)}
                          title="Solicitar orçamento"
                          style={{
                            marginTop: 2, padding: "4px 6px", background: "transparent",
                            border: `1px solid ${T.borderHover}`, color: T.textPrimary,
                            fontSize: 8, letterSpacing: "0.14em", fontFamily: FONT_BODY,
                            cursor: "pointer", textTransform: "uppercase",
                            display: "inline-flex", alignItems: "center", justifyContent: "center", gap: 4,
                          }}>
                          <Calculator size={9} /> Orçar
                        </button>
                      </div>
                    );
                  })
                )}
                {colCards.length > 80 && (
                  <div style={{ padding: 6, textAlign: "center", color: T.textMuted, fontSize: 9, letterSpacing: "0.14em" }}>
                    +{colCards.length - 80} mais
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {orcCard && (
        <SolicitarOrcamentoModal
          card={orcCard as any}
          appUser={appUser}
          onClose={() => setOrcCard(null)}
          onCreated={() => setOrcCard(null)}
        />
      )}
    </div>
  );
}

// ════════════════════════════════════════════════════════════════════════
// TAREFAS — agenda_tarefas do vendedor (todas, com agrupamento por urgência)
// ════════════════════════════════════════════════════════════════════════
function TarefasView({ appUser, T }: { appUser: AppUser; T: Theme }) {
  const [items, setItems] = useState<AgendaTarefa[]>([]);
  const [loading, setLoading] = useState(true);
  const [novoOpen, setNovoOpen] = useState(false);
  const [filtro, setFiltro] = useState<"pendentes" | "todas">("pendentes");

  const reload = async () => {
    setLoading(true);
    try {
      const arr = await api.tarefas(undefined, undefined, filtro === "pendentes" ? "pendente" : undefined);
      setItems(arr);
    } finally { setLoading(false); }
  };
  useEffect(() => { reload(); /* eslint-disable-next-line */ }, [filtro]);

  const hojeISO = new Date().toISOString().slice(0, 10);
  const grupos = useMemo(() => {
    const g = { atrasadas: [] as AgendaTarefa[], hoje: [] as AgendaTarefa[], futuro: [] as AgendaTarefa[], semData: [] as AgendaTarefa[] };
    for (const t of items) {
      if (!t.data) g.semData.push(t);
      else if (t.data < hojeISO && t.status === "pendente") g.atrasadas.push(t);
      else if (t.data === hojeISO) g.hoje.push(t);
      else g.futuro.push(t);
    }
    return g;
  }, [items, hojeISO]);

  return (
    <div style={{ flex: 1, overflow: "auto", padding: 14, background: T.bg }}>
      <div style={{ display: "flex", gap: 8, marginBottom: 12 }}>
        <button onClick={() => setNovoOpen(true)} style={{
          padding: "8px 12px", background: T.textPrimary, color: T.bg,
          border: "none", fontSize: 10, letterSpacing: "0.16em",
          fontFamily: FONT_BODY, cursor: "pointer", textTransform: "uppercase",
          display: "inline-flex", alignItems: "center", gap: 6,
        }}>
          <Plus size={11} /> Nova tarefa
        </button>
        <div style={{ display: "flex", border: `1px solid ${T.border}` }}>
          {(["pendentes", "todas"] as const).map((f) => (
            <button key={f} onClick={() => setFiltro(f)}
              style={{
                padding: "8px 12px", background: filtro === f ? T.surfaceHover : "transparent",
                color: filtro === f ? T.textPrimary : T.textSecondary,
                border: "none", borderRight: f === "pendentes" ? `1px solid ${T.border}` : "none",
                fontSize: 10, letterSpacing: "0.16em", fontFamily: FONT_BODY, cursor: "pointer", textTransform: "uppercase",
              }}>
              {f}
            </button>
          ))}
        </div>
      </div>

      {loading ? (
        <div style={{ padding: 40, textAlign: "center", color: T.textMuted }}>
          <Loader2 size={16} style={{ display: "inline-block", animation: "spin 1s linear infinite" }} />
        </div>
      ) : (
        <>
          {grupos.atrasadas.length > 0 && <TarefaGrupo titulo="ATRASADAS" cor="#D34"  items={grupos.atrasadas} T={T} onChange={reload} />}
          {grupos.hoje.length > 0      && <TarefaGrupo titulo="HOJE"      cor="#D5A" items={grupos.hoje}      T={T} onChange={reload} />}
          {grupos.futuro.length > 0    && <TarefaGrupo titulo="FUTURAS"   cor="#5BA" items={grupos.futuro}    T={T} onChange={reload} />}
          {grupos.semData.length > 0   && <TarefaGrupo titulo="SEM DATA"  cor="#888" items={grupos.semData}   T={T} onChange={reload} />}
          {items.length === 0 && (
            <div style={{ padding: 40, textAlign: "center", color: T.textMuted, fontSize: 11, letterSpacing: "0.16em", textTransform: "uppercase" }}>
              Nenhuma tarefa {filtro === "pendentes" ? "pendente" : ""}.
            </div>
          )}
        </>
      )}

      {novoOpen && (
        <TarefaModal appUser={appUser} tarefa={null}
          onClose={() => setNovoOpen(false)}
          onSaved={() => { setNovoOpen(false); reload(); }} />
      )}
    </div>
  );
}

function TarefaGrupo({ titulo, cor, items, T, onChange }: { titulo: string; cor: string; items: AgendaTarefa[]; T: Theme; onChange: () => void }) {
  return (
    <div style={{ marginBottom: 18 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 6 }}>
        <div style={{ width: 3, height: 10, background: cor }} />
        <div style={{ fontSize: 10, letterSpacing: "0.20em", fontFamily: FONT_BODY, color: T.textPrimary, fontWeight: 600 }}>
          {titulo} <span style={{ color: T.textMuted, marginLeft: 6 }}>{items.length}</span>
        </div>
      </div>
      <div style={{ display: "grid", gap: 4 }}>
        {items.map((t) => (
          <TarefaLinha key={t.id} t={t} T={T} onChange={onChange} />
        ))}
      </div>
    </div>
  );
}

function TarefaLinha({ t, T, onChange }: { t: AgendaTarefa; T: Theme; onChange: () => void }) {
  const feita = t.status === "feita";
  const prioCor = t.prioridade === "alta" ? "#D34" : t.prioridade === "baixa" ? T.textMuted : "#D5A";
  return (
    <div style={{
      display: "flex", alignItems: "flex-start", gap: 10, padding: "8px 10px",
      background: T.surface, border: `1px solid ${T.border}`, opacity: feita ? 0.55 : 1,
    }}>
      <button
        onClick={async () => { await api.toggleTarefa(t.id, !feita); onChange(); }}
        style={{
          width: 16, height: 16, marginTop: 2,
          background: feita ? "#5BA" : "transparent",
          border: `1px solid ${feita ? "#5BA" : T.border}`,
          color: T.bg, cursor: "pointer",
          display: "inline-flex", alignItems: "center", justifyContent: "center",
        }}>
        {feita && <Check size={10} />}
      </button>
      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ color: T.textPrimary, fontSize: 12, fontFamily: FONT_BODY, textDecoration: feita ? "line-through" : "none" }}>
          {t.titulo}
        </div>
        {(t.descricao || t.hora || t.parceiro_id) && (
          <div style={{ color: T.textSecondary, fontSize: 9, marginTop: 2, display: "flex", gap: 8, flexWrap: "wrap" }}>
            {t.hora && <span><CalendarClock size={9} style={{ display: "inline" }} /> {t.hora.slice(0, 5)}</span>}
            {t.descricao && <span style={{ opacity: 0.8 }}>{t.descricao.slice(0, 80)}</span>}
            {t.parceiro_id && <span style={{ color: cor4parceiro(T) }}>{`carteira`}</span>}
          </div>
        )}
      </div>
      {t.prioridade !== "media" && (
        <span style={{
          fontSize: 8, letterSpacing: "0.16em", color: prioCor, padding: "2px 6px",
          border: `1px solid ${prioCor}40`, textTransform: "uppercase", fontFamily: FONT_BODY,
        }}>{t.prioridade}</span>
      )}
    </div>
  );
}

function cor4parceiro(T: Theme) { return T.textSecondary; }

// ════════════════════════════════════════════════════════════════════════
// CARTEIRA — parceiros do vendedor + botão "Criar tarefa pra parceiro"
// ════════════════════════════════════════════════════════════════════════
function CarteiraView({ appUser, T }: { appUser: AppUser; T: Theme }) {
  const [parceiros, setParceiros] = useState<CarteiraParceiro[]>([]);
  const [loading, setLoading] = useState(true);
  const [busca, setBusca] = useState("");
  const [novoTaskParceiro, setNovoTaskParceiro] = useState<CarteiraParceiro | null>(null);

  const reload = async () => {
    setLoading(true);
    try {
      const arr = await api.carteiraParceiros(appUser.canSeeAll ? undefined : appUser.id);
      setParceiros(arr);
    } finally { setLoading(false); }
  };
  useEffect(() => { reload(); /* eslint-disable-next-line */ }, []);

  const filtered = useMemo(() => {
    if (!busca.trim()) return parceiros;
    const q = busca.toLowerCase();
    return parceiros.filter((p) =>
      p.nome.toLowerCase().includes(q) ||
      (p.empresa || "").toLowerCase().includes(q) ||
      (p.cidade || "").toLowerCase().includes(q)
    );
  }, [parceiros, busca]);

  return (
    <div style={{ flex: 1, overflow: "auto", padding: 14, background: T.bg }}>
      <div style={{ marginBottom: 12, display: "flex", gap: 8 }}>
        <input
          value={busca} onChange={(e) => setBusca(e.target.value)}
          placeholder="Buscar parceiro, empresa ou cidade…"
          style={{
            flex: 1, padding: "8px 10px", background: T.surface, color: T.textPrimary,
            border: `1px solid ${T.border}`, fontSize: 12, fontFamily: FONT_BODY, outline: "none",
          }}
        />
        <Link to="/carteira" style={{
          padding: "8px 12px", background: "transparent", color: T.textSecondary,
          border: `1px solid ${T.border}`, textDecoration: "none",
          fontSize: 10, letterSpacing: "0.16em", fontFamily: FONT_BODY, textTransform: "uppercase",
          display: "inline-flex", alignItems: "center", gap: 5,
        }}>
          GERENCIAR <ExternalLink size={9} />
        </Link>
      </div>

      {loading ? (
        <div style={{ padding: 40, textAlign: "center", color: T.textMuted }}>
          <Loader2 size={16} style={{ display: "inline-block", animation: "spin 1s linear infinite" }} />
        </div>
      ) : filtered.length === 0 ? (
        <div style={{ padding: 40, textAlign: "center", color: T.textMuted, fontSize: 11, letterSpacing: "0.16em", textTransform: "uppercase" }}>
          Nenhum parceiro {busca ? "nesta busca" : "cadastrado"}.
        </div>
      ) : (
        <div style={{ display: "grid", gap: 6 }}>
          {filtered.map((p) => (
            <div key={p.id} style={{
              display: "flex", alignItems: "center", gap: 10,
              padding: "10px 12px", background: T.surface, border: `1px solid ${T.border}`,
            }}>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={{ color: T.textPrimary, fontSize: 13, fontWeight: 600, fontFamily: FONT_BODY }}>
                  {p.nome}
                </div>
                <div style={{ color: T.textSecondary, fontSize: 10, marginTop: 2, display: "flex", gap: 10, flexWrap: "wrap", textTransform: "uppercase", letterSpacing: "0.10em" }}>
                  <span>{p.tipo}</span>
                  {p.empresa && <span>· {p.empresa}</span>}
                  {(p.cidade || p.estado) && <span>· {[p.cidade, p.estado].filter(Boolean).join("/")}</span>}
                </div>
              </div>
              <button onClick={() => setNovoTaskParceiro(p)}
                title="Criar tarefa pra esse parceiro (ex: ligar pra arquiteto)"
                style={{
                  padding: "6px 10px", background: T.textPrimary, color: T.bg,
                  border: "none", fontSize: 9, letterSpacing: "0.16em", fontFamily: FONT_BODY,
                  cursor: "pointer", textTransform: "uppercase",
                  display: "inline-flex", alignItems: "center", gap: 5,
                }}>
                <Plus size={10} /> Tarefa
              </button>
            </div>
          ))}
        </div>
      )}

      {novoTaskParceiro && (
        <TarefaModal appUser={appUser} tarefa={null}
          parceiroId={novoTaskParceiro.id}
          onClose={() => setNovoTaskParceiro(null)}
          onSaved={() => setNovoTaskParceiro(null)} />
      )}
    </div>
  );
}
