  const tabsDef=[
    {id:'terminal',label:'⚡ Terminal'},
    {id:'admin',label:'👥 Devs',show:isAdmin},
  ];
  const tabsHtml='<div class="tabs">'+tabsDef.filter(t=>t.show!==false).map(t=>
    `<button class="tab ${tab===t.id?'a':''}" onclick="tab='${t.id}';R()">${t.label}</button>`).join('')+'</div>';

  const sidebar=`<div class="side">
    <div class="side-hdr">Aplicacoes</div><div class="side-list">${appList}</div>
    ${curApp==='dashboardparket'?'<div class="side-hdr">Setores</div><div class="side-list">'+setorList+'</div>':''}
  </div>`;

  const header=`<div class="hdr">
    <div class="logo">⚡ PARKET CODE <small>Dev Portal</small></div>
    <div class="conn"><div class="conn-dot ${connected?'on':'off'}" id="conn-dot"></div><span id="conn-label" style="color:var(--dim)">${connected?'Conectado':'Desconectado'}</span></div>
    <span style="font-size:11px;color:var(--dim);margin-left:12px">${escHtml(me.dev_name)} · ${me.role}</span>
    <button class="btn bg" style="margin-left:12px;font-size:10px" onclick="me=null;authToken=null;localStorage.removeItem('dev-email');localStorage.removeItem('dev-token');if(ws)ws.close();R()">Sair</button>
  </div>`;

  if(tab==='terminal'){
    const placeholder=mode==='claude'
      ?'Descreva o que precisa no '+APPS[curApp].nome+(curSetor?' / '+curSetor:'')+'...'
      :'Comando shell...';

    const pipelineHtml=`<div class="pipeline">
      <div class="pipe-step ${pipeStep===1?'active':''} ${pipeStep>1?'done':''}" id="pipe-1"><div class="pipe-num">1</div> Editar Codigo</div>
      <span class="pipe-arrow">→</span>
