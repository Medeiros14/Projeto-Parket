FROM parket-dashboard:golden
# PKT-ALLIN 2026-06-22: modal edit interpreta Preço/m² como all-in + split 60/15/25 ou 70/10/20
# Cascade delete: PRODUTO deletado apaga INS+INSTAL filhos (RECORTES não tem parent_item_id, fica)
# Mantém PGSTRUCT33 (parseFloat fix da Metragem real total)
COPY orcamento-simulador-tab-MARCFIX47.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX47.js
COPY propostaGenerator-PGSTRUCT33.js /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT33.js
COPY default.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i -E 's|orcamento-simulador-tab-MARCFIX46\.js|orcamento-simulador-tab-MARCFIX47.js|g; s|propostaGenerator-PGSTRUCT3[012]\.js|propostaGenerator-PGSTRUCT33.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf47-pg33-allin-edit'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
