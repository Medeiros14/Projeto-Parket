      <script>
      // Sessão por browser session: ao FECHAR o navegador, invalida o auth
      // do Supabase. Múltiplas abas no mesmo navegador continuam logadas
      // porque o localStorage é compartilhado e o heartbeat fica fresh.
      // F5/reload da mesma aba não desloga (sessionStorage persiste em reload).
      (function(){
        try {
          var HB_KEY = 'parket-browser-heartbeat';
          var TAB_KEY = 'parket-tab-was-alive';
          var GRACE_MS = 8000; // tempo máximo de "navegador fechado" tolerado
          var now = Date.now();
          var last = parseInt(localStorage.getItem(HB_KEY) || '0', 10) || 0;
          var thisTabReloaded = !!sessionStorage.getItem(TAB_KEY);
          if (!thisTabReloaded && (now - last) > GRACE_MS) {
            // Nova aba E heartbeat parado há > GRACE_MS → navegador foi
            // fechado e reaberto. Invalida sessão pra forçar login.
            for (var i = localStorage.length - 1; i >= 0; i--) {
              var k = localStorage.key(i);
              if (k && (k === 'parket-auth' || k.indexOf('parket-auth') === 0 || k.indexOf('sb-') === 0)) {
                localStorage.removeItem(k);
              }
            }
          }
          sessionStorage.setItem(TAB_KEY, '1');
          localStorage.setItem(HB_KEY, String(now));
          setInterval(function(){
            try { localStorage.setItem(HB_KEY, String(Date.now())); } catch(_){}
          }, 3000);
        } catch(err) {
          console.warn('[browser-session]', err);
        }
      })();
      </script>
