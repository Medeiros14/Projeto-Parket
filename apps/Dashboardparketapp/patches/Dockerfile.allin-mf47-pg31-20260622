FROM parket-dashboard:golden
# PKT-ALLIN 2026-06-22: modal edit interpreta Preço/m² como all-in + split 60/15/25 ou 70/10/20.
# Renderer: linha "Total CATEGORIA" antes do Valor parcial mostrando metragem total + preço unitário.
# PKT-CASCADE-DELETE 2026-06-22: deletar PRODUTO também apaga filhos (INSUMOS+INSTAL+RECORTES) via meta.parent_item_id.
COPY default.conf /etc/nginx/conf.d/default.conf
COPY orcamento-simulador-tab-MARCFIX47.js /usr/share/nginx/html/assets/orcamento-simulador-tab-MARCFIX47.js
COPY propostaGenerator-PGSTRUCT31.js     /usr/share/nginx/html/assets/propostaGenerator-PGSTRUCT31.js
RUN find /usr/share/nginx/html -type f \( -name "*.html" -o -name "*.js" \) -exec \
  sed -i 's|orcamento-simulador-tab-MARCFIX46\.js|orcamento-simulador-tab-MARCFIX47.js|g; s|propostaGenerator-PGSTRUCT30\.js|propostaGenerator-PGSTRUCT31.js|g' {} +
RUN sed -i "s|var CODE_VERSION = '[^']*'|var CODE_VERSION = '20260622-mf47-pg31-allin-cascade'|" /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["nginx","-g","daemon off;"]
