                    return o.jsxs("div", {
                      style: { display: "flex", alignItems: "center", gap: 6, marginBottom: 3, fontSize: "0.6rem" },
                      children: [
                        o.jsx("div", { style: { width: 60, color: TXT_DIM }, children: e }),
                        o.jsx("div", { style: { flex: 1, height: 12, background: BG_CARD, borderRadius: 2 },
