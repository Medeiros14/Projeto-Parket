                      children: o.jsx("div", { style: { width: `${pct}%`, height: "100%", background: "#a37854", borderRadius: 2 } }),
                    }),
                    o.jsx("div", { style: { width: 28, textAlign: "right", color: TXT, fontWeight: 600 }, children: d.qtd }),
