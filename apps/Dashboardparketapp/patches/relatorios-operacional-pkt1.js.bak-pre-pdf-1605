              o.jsx("div", { style: { fontSize: "0.6rem", fontWeight: 700, color: ACCENT, marginBottom: 8 }, children: "👤 Backlog por fiscal" }),
              o.jsx("div", { children: distPorFiscal.slice(0, 10).map(([f, n]) => {
                const maxN = Math.max(1, ...distPorFiscal.map((x) => x[1]));
