                    const ests = tags.filter((t) => ESTADOS_BR.includes(t));
                    const slaColor = c.sla_status === "critical" ? "#ef4444" : c.sla_status === "warning" ? "#f59e0b" : "#10b981";
                    return o.jsxs("tr", {
                      style: { borderBottom: `1px solid ${BORDER}` },
                      children: [
                        o.jsx("td", { style: { padding: "6px 8px", color: TXT, fontWeight: 500 }, children: c.title || c.obra || "—" }),
