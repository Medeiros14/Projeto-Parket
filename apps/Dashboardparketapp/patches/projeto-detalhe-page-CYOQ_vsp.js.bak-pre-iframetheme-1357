              e.jsxs("div",{style:{color:"rgba(255,255,255,0.5)",fontSize:"0.58rem"},children:[
                it.servico||"—"," · ",it.ambiente||"—",it.qtd?" · "+it.qtd+(it.unidade||""):""
              ]})
            ]}),
            e.jsx("span",{style:{background:sd.bg,color:sd.color,padding:"3px 10px",borderRadius:12,fontSize:"0.6rem",fontWeight:600,whiteSpace:"nowrap"},children:sd.label})
          ]}),
          itChks.length>0 && e.jsx("div",{style:{marginTop:8,paddingTop:8,borderTop:"1px dashed rgba(255,255,255,0.08)",display:"flex",flexDirection:"column",gap:4},children:itChks.map(c =>
            e.jsxs("div",{style:{display:"flex",gap:6,alignItems:"center",fontSize:"0.55rem",color:"rgba(255,255,255,0.7)"},children:[
