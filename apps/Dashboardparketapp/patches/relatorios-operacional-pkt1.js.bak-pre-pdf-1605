                        o.jsx("td", { style: { padding: "6px 8px", color: TXT_MUTED }, children: fmtDate(c.updated_at) }),
                      ],
                    }, c.id);
                  }),
                }),
              ],
            }),
          }),
        ],
      }),
    ],
  });
