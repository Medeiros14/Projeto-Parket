async function _duplicarSim(simId){
  if(!simId) return;
  try {
    const { data: sim } = await D.from("simulacao_projetos").select("*").eq("id", simId).single();
    if (!sim) { _toast("Simulação não encontrada", "err"); return; }
    const { data: items } = await D.from("simulacao_itens").select("*").eq("simulacao_id", simId);
    const { data: nums } = await D.from("simulacao_projetos").select("numero");
    let maxN = 0;
    (nums||[]).forEach(r => { const n = parseInt(String(r.numero||"").replace(/\D/g,""), 10) || 0; if (n > maxN) maxN = n; });
    const newSim = { ...sim }; delete newSim.id; delete newSim.created_at; delete newSim.updated_at;
    delete newSim.obra_id; delete newSim.card_id;
    newSim.numero = String(maxN + 1); newSim.status = "rascunho";
    newSim.cliente = (sim.cliente||"").replace(/\s*\(c[óo]pia\)\s*/gi, " ").trim().slice(0, 200);
    const { data: ins, error } = await D.from("simulacao_projetos").insert(newSim).select().single();
    if (error || !ins) { _toast("Erro ao duplicar: " + (error ? error.message : ""), "err"); return; }
    if (items && items.length > 0) {
      const newItems = items.map(it => { const c = { ...it }; delete c.id; delete c.created_at; c.simulacao_id = ins.id; return c; });
      try{
      const {data:_ins,error:_ie}=await D.from("simulacao_itens").insert(newItems).select();
      if(_ie){console.error("[_duplicarSim items]",_ie);_toast("⚠ Erro ao copiar itens: "+_ie.message,"err");}
      else if(!_ins||_ins.length!==newItems.length){
        const _got=(_ins&&_ins.length)||0;
        console.error("[_duplicarSim] esperava "+newItems.length+" itens, inseriu "+_got);
        _toast("⚠ Apenas "+_got+"/"+newItems.length+" itens copiados — verifique categorias duplicadas","err");
        // Fallback: tenta inserir 1 a 1 pra identificar quais falham
        let _ok=_got;
        for(const _it of newItems){
          try{
            const {error:_e2}=await D.from("simulacao_itens").insert(_it);
            if(!_e2)_ok++;else console.warn("[duplicar item fail]",_it.descritivo?.slice(0,40),_e2.message);
          }catch(_xe){console.warn("[duplicar item exc]",_xe);}
        }
        if(_ok>_got)_toast("✓ Recuperados "+_ok+"/"+newItems.length+" itens","ok");
      }
    }catch(_e){console.error("[_duplicarSim catch]",_e);_toast("⚠ Falha ao copiar itens: "+(_e?.message||_e),"err");}
    }
    _toast("✓ Duplicada como #" + newSim.numero, "ok");
    setTimeout(() => location.reload(), 1200);
  } catch (err) { _toast("Erro ao duplicar: " + (err && err.message || err), "err"); }
}

function _parseTipoFromCategoria(cat){
  const u = String(cat||"").toUpperCase();
  if (u.startsWith("PISO")) return "piso"; if (u.startsWith("DECK")) return "deck";
  if (u.startsWith("SAUNA")) return "sauna"; if (u.startsWith("FORRO")) return "forro";
  if (u.startsWith("PAINEL")) return "painel"; if (u.startsWith("REVESTIMENTO")) return "revestimento";
  if (u.startsWith("PORTA")) return "porta"; if (u.startsWith("ESCADA")) return "escada";
  if (u.startsWith("MARCENARIA")) return "marcenaria";
  return null;
}

